    "$border-color",
    "$border-radius",
    "$border-radius-sm",
    "$border-radius-lg",
    "$font-size-base"
  ],

  "esmModules": [
    {
      "module": "combobox.js",
      "export": "./combobox.js",
      "lifecycle": ["getOrCreateInstance", "dispose"],
      "source": "src/js/components/combobox.js"
    },
    {
      "module": "sidebar.js",
      "export": "./sidebar.js",
      "lifecycle": ["getOrCreateInstance", "dispose"],
      "source": "src/js/components/sidebar.js"
    },
    {
      "module": "context-menu.js",
      "export": "./context-menu.js",
      "lifecycle": ["getOrCreateInstance", "dispose"],
      "source": "src/js/components/context-menu.js"
    },
    {
      "module": "datatable.js",
      "export": "./datatable.js",
      "lifecycle": ["getOrCreateInstance", "dispose"],
      "source": "src/js/components/datatable.js"
    },
    {
      "module": "chart.js",
      "export": "./chart.js",
      "lifecycle": ["constructor", "getInstance", "getOrCreateInstance", "dispose"],
      "source": "src/js/components/chart.js",
      "bundled": true,
      "runtime": "chart.js@4.5.1",
      "markup": {
        "rootClass": "moo-chart",
        "typeAttribute": "data-moo-chart",
        "dataAttribute": "data-moo-chart-data",
        "childElement": "canvas"
      }
    },
    {
      "module": "datepicker.js",
      "export": "./datepicker.js",
      "lifecycle": ["constructor", "getInstance", "getOrCreateInstance", "dispose"],
      "source": "src/js/components/datepicker.js",
      "bundled": true,
      "runtime": "vanillajs-datepicker@1.3.4",
      "namedExports": ["MooCalendar", "MooDateRangePicker"],
      "markup": {
        "rootClass": "moo-date-picker",
        "rootAttribute": "data-moo-datepicker",
        "triggerAttribute": "data-moo-datepicker-trigger",
        "popoverAttribute": "data-moo-datepicker-popover",
        "calendarAttribute": "data-moo-calendar",
        "labelAttribute": "data-moo-datepicker-label"
      }
    },
    {
      "module": "slider.js",
      "export": "./slider.js",
      "lifecycle": ["constructor", "getInstance", "getOrCreateInstance", "dispose"],
      "source": "src/js/components/slider.js",
      "bundled": false,
      "nativeElement": "input[type=\"range\"]"
    }
  ],

  "artifactVariants": {
    "chart.min.js": {
      "canonical": "chart.js",
      "relationship": "Minified artifact variant of chart.js; shares source, exports, lifecycle, and runtime ownership"
    },
    "datepicker.min.js": {
      "canonical": "datepicker.js",
      "relationship": "Minified artifact variant of datepicker.js; shares source, exports, lifecycle, and runtime ownership"
    }
  },

  "cssEntrypoints": [
    {
      "export": "./moo-ui.css",
      "purpose": "Full expanded Bootstrap-compatible CSS build",
      "scope": "unscoped"
    },
    {
      "export": "./moo-ui.min.css",
      "purpose": "Full minified CSS build",
      "scope": "unscoped"
    },
    {
      "export": "./moo.css",
      "purpose": "Scoped expanded component layer for .moo-ui",
      "scope": "scoped"
    },
    {
      "export": "./moo.min.css",
      "purpose": "Scoped minified component layer",
      "scope": "scoped"
    }
  ],

  "bootstrapSupport": {
