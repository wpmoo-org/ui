{% from "components/button.html.jinja" import button %}
{% from "components/avatar.html.jinja" import avatar %}

{% set dropdown_alignments = ["", "start", "end"] %}

{% set dropdown_triggers = ["button", "nav-link"] %}

{# trigger="nav-link" renders a navbar list item for use inside .navbar-nav
   or .nav: <li class="nav-item dropdown"> with a native
   <button class="nav-link dropdown-toggle"> trigger (Bootstrap's navbar
   dropdown pattern). variant, size and caret do not apply to it; active and
   disabled style the trigger. #}
{% macro dropdown(label, variant="outline", align="", extra_class="", caret=false, auto_close="", offset="", size="default", aria_label="", trigger="button", active=false, disabled=false) -%}
  {% if align not in dropdown_alignments %}{{ fail("Unknown dropdown alignment: " ~ align) }}{% endif %}
  {% if trigger not in dropdown_triggers %}{{ fail("Unknown dropdown trigger: " ~ trigger) }}{% endif %}
  {% if trigger == "button" and (active or disabled) %}{{ fail("Dropdown active and disabled require trigger=nav-link") }}{% endif %}
  {% set items %}{{ caller() | trim | safe }}{% endset %}
  {% if trigger == "nav-link" %}
    <li class="nav-item dropdown{% if extra_class %} {{ extra_class }}{% endif %}">
      <button type="button" class="nav-link dropdown-toggle{% if active %} active{% endif %}" data-bs-toggle="dropdown" aria-expanded="false"{% if aria_label %} aria-label="{{ aria_label }}"{% endif %}{% if auto_close %} data-bs-auto-close="{{ auto_close }}"{% endif %}{% if offset %} data-bs-offset="{{ offset }}"{% endif %}{% if disabled %} disabled{% endif %}>{{ label }}</button>
      {% call dropdown_menu(align=align) %}{{ items | safe }}{% endcall %}
    </li>
  {% else %}
  <div class="dropdown{% if extra_class %} {{ extra_class }}{% endif %}">
    {{ button(label, variant=variant, size=size, aria_label=aria_label, dropdown=true, dropdown_caret=caret, dropdown_auto_close=auto_close, dropdown_offset=offset) }}
    {% call dropdown_menu(align=align) %}{{ items | safe }}{% endcall %}
  </div>
  {% endif %}
{%- endmacro %}

{% macro dropdown_menu(align="", extra_class="") -%}
  {% if align not in dropdown_alignments %}{{ fail("Unknown dropdown alignment: " ~ align) }}{% endif %}
  <ul class="dropdown-menu{% if align %} dropdown-menu-{{ align }}{% endif %}{% if extra_class %} {{ extra_class }}{% endif %}">
    {{ caller() | trim | safe }}
  </ul>
{%- endmacro %}

{% macro dropdown_item(label, href="", icon="", active=false, disabled=false, destructive=false, shortcut="", icon_box=false, extra_class="", target="", rel="", attrs="") -%}
  {% if not label | trim %}{{ fail("Dropdown item label is required") }}{% endif %}
  {% if icon_box and not icon %}{{ fail("Dropdown item icon_box requires an icon") }}{% endif %}
  {% if target and not rel %}{{ fail("Dropdown item target requires rel") }}{% endif %}
  {% set classes = "dropdown-item" %}
  {% if active %}{% set classes = classes ~ " active" %}{% endif %}
  {% if extra_class %}{% set classes = classes ~ " " ~ extra_class %}{% endif %}
  {% set destructive_attr = 'data-variant="destructive"' if destructive else "" %}
  {% set icon_markup %}
    {%- if icon and icon_box -%}
      <span class="dropdown-item__icon-box">{{ render_icon(icon, "inline-start") }}</span>
    {%- elif icon -%}
      {{ render_icon(icon, "inline-start") }}
    {%- endif -%}
  {% endset %}
  {% set rendered_icon = icon_markup | trim %}
  {% if href %}
    <li>
      <a class="{{ classes }}{% if disabled %} disabled{% endif %}" href="{{ href }}"{% if target %} target="{{ target }}"{% endif %}{% if rel %} rel="{{ rel }}"{% endif %}{% if destructive_attr %} {{ destructive_attr | safe }}{% endif %}{% if attrs %} {{ attrs | safe }}{% endif %}{% if disabled %} aria-disabled="true" tabindex="-1"{% endif %}{% if active %} aria-current="true"{% endif %}>{% if rendered_icon %}{{ rendered_icon | safe }}{% endif %}<span>{{ label }}</span>{% if shortcut %}<span class="ms-auto small text-body-secondary">{{ shortcut }}</span>{% endif %}</a>
    </li>
  {% else %}
    <li>
      <button class="{{ classes }}" type="button"{% if destructive_attr %} {{ destructive_attr | safe }}{% endif %}{% if attrs %} {{ attrs | safe }}{% endif %}{% if disabled %} disabled{% endif %}>{% if rendered_icon %}{{ rendered_icon | safe }}{% endif %}<span>{{ label }}</span>{% if shortcut %}<span class="ms-auto small text-body-secondary">{{ shortcut }}</span>{% endif %}</button>
    </li>
  {% endif %}
{%- endmacro %}

{% macro dropdown_toggle_item(label, pressed=false, disabled=false, icon="check", shortcut="", extra_class="", attrs="") -%}
  {% if not label | trim %}{{ fail("Dropdown toggle item label is required") }}{% endif %}
  {% set classes = "dropdown-item dropdown-item-check" %}
  {% if pressed %}{% set classes = classes ~ " active" %}{% endif %}
  {% if extra_class %}{% set classes = classes ~ " " ~ extra_class %}{% endif %}
  <li>
    <button class="{{ classes }}" type="button" data-bs-toggle="button" aria-pressed="{{ 'true' if pressed else 'false' }}"{% if attrs %} {{ attrs | safe }}{% endif %}{% if disabled %} disabled{% endif %}>
      <span class="dropdown-item-check__indicator" aria-hidden="true">{{ render_icon(icon, "inline-start") }}</span>
      <span>{{ label }}</span>
      {% if shortcut %}<span class="ms-auto small text-body-secondary">{{ shortcut }}</span>{% endif %}
    </button>
  </li>
{%- endmacro %}

{% macro dropdown_header(label) -%}
  {% if not label | trim %}{{ fail("Dropdown header label is required") }}{% endif %}
  <li><h6 class="dropdown-header">{{ label }}</h6></li>
{%- endmacro %}

{% macro dropdown_identity(name, email="", src="", alt="", initials="", extra_class="") -%}
  {% if not name | trim %}{{ fail("Dropdown identity name is required") }}{% endif %}
  {% set identity_name = name | trim %}
  {% set identity_email = email | trim %}
  {% set classes = "sidebar-account-menu__header" %}
  {% if extra_class %}{% set classes = classes ~ " " ~ extra_class %}{% endif %}
  <li class="{{ classes }}">
    {{ avatar(name=identity_name, src=src, alt=alt, initials=initials, extra_class="sidebar-avatar") }}
    <span class="sidebar-account-menu__identity">
      <span class="sidebar-account-menu__name">{{ identity_name }}</span>
      {% if identity_email %}<span class="sidebar-account-menu__email">{{ identity_email }}</span>{% endif %}
    </span>
  </li>
{%- endmacro %}

{% macro dropdown_divider(extra_class="") -%}
  <li><hr class="dropdown-divider{% if extra_class %} {{ extra_class }}{% endif %}"></li>
{%- endmacro %}
