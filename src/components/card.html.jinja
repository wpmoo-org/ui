{% set card_sizes = ["default", "sm"] %}

{% macro floating_panel(id, title, storage_key="") -%}
  {% if id is not string or not id | trim or id | trim != id or id.split() | length != 1 %}{{ fail("Floating panel id is required") }}{% endif %}
  {% if title is not string or not title | trim %}{{ fail("Floating panel title is required") }}{% endif %}
  {% if storage_key is not string or storage_key | length > 256 %}{{ fail("Floating panel storage key must be a bounded string") }}{% endif %}
  <aside id="{{ id }}" aria-label="{{ title }}" data-floating-panel="{{ id }}"{% if storage_key %} data-floating-panel-key="{{ storage_key }}" hidden{% endif %}
    class="position-fixed bottom-0 end-0 col-12 col-sm-6 col-lg-4 col-xl-3 p-3 z-3 mh-100 overflow-auto">
    {{ caller() }}
  </aside>
{%- endmacro %}

{% macro card(
  title="",
  subtitle="",
  action="",
  image="",
  footer="",
  size="default",
  dir="",
  extra_class="",
  header_class="",
  body_class="",
  footer_class=""
) -%}
  {% if size not in card_sizes %}{{ fail("Unknown card size: " ~ size) }}{% endif %}
  {% set classes = "card" %}
  {% if size == "sm" %}{% set classes = classes ~ " card--sm" %}{% endif %}
  {% if extra_class %}{% set classes = classes ~ " " ~ extra_class %}{% endif %}
  <div class="{{ classes }}"{% if dir %} dir="{{ dir }}"{% endif %}>
    {% if image %}<div class="card-image"><img class="card-img-top" src="{{ image.src }}" alt="{{ image.alt }}"></div>{% endif %}
    {% if title or subtitle or action %}
      <div class="card-header{% if header_class %} {{ header_class }}{% endif %}">
        {% if title or subtitle %}
          <div class="card-header__text">
            {% if title %}<h3 class="card-title">{{ title }}</h3>{% endif %}
            {% if subtitle %}<p class="card-subtitle">{{ subtitle }}</p>{% endif %}
          </div>
        {% endif %}
        {% if action %}<div class="card-action">{{ action }}</div>{% endif %}
      </div>
    {% endif %}
    <div class="card-body{% if body_class %} {{ body_class }}{% endif %}">
      {{ caller() | trim | safe }}
    </div>
    {% if footer %}
      <div class="card-footer{% if footer_class %} {{ footer_class }}{% endif %}">
        {{ footer | trim | safe }}
      </div>
    {% endif %}
  </div>
{%- endmacro %}
