{# Data Table composes Bootstrap's own .table markup with the already-ready
   Dropdown Menu, Pagination, Select, and Checkbox contracts. Bootstrap ships
   no table JS plugin at all (verified: no js/src/table.js in the vendored or
   reference source), so Moo owns 100% of the interactive behavior: sorting,
   free-text search, faceted multi-select filtering, column visibility,
   row selection, and client-side pagination in src/js/components/data-table.js.
   The table stays fully server-rendered first -- every row exists in the DOM
   at load; the runtime only reorders, hides, or paginates existing rows. No
   remote data engine, per the Phase 3B non-goals. #}

{% from "components/dropdown_menu.html.jinja" import dropdown_menu, dropdown_item, dropdown_toggle_item, dropdown_header, dropdown_divider %}

{% macro data_table_facet_item(label, icon="", count=none, attrs="") -%}
  {% if not label | trim %}{{ fail("Data Table facet item label is required") }}{% endif %}
  <li>
    <button class="dropdown-item data-table-facet-item" type="button"{% if attrs %} {{ attrs | safe }}{% endif %} aria-pressed="false">
      <span class="data-table-facet-item__indicator" aria-hidden="true">{{ render_icon("check", "inline-start") }}</span>
      {% if icon %}{{ render_icon(icon, "inline-start") }}{% endif %}
      <span data-data-table-facet-option-label>{{ label }}</span>
      {% if count is not none %}<span class="ms-auto small text-body-secondary">{{ count }}</span>{% endif %}
    </button>
  </li>
{%- endmacro %}

{% macro data_table_facet(key, label, options) -%}
  {% if not key | trim %}{{ fail("Data Table facet key is required") }}{% endif %}
  {% if not label | trim %}{{ fail("Data Table facet label is required") }}{% endif %}
  {% if not options %}{{ fail("Data Table facet options are required") }}{% endif %}
  <div class="dropdown data-table-facet" data-data-table-facet="{{ key }}">
    <button class="btn btn-sm data-table-facet-trigger" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
      {{ render_icon("circle-plus", "inline-start") }}
      <span>{{ label }}</span>
      <span class="data-table-facet-summary" data-data-table-facet-summary hidden></span>
    </button>
    {% call dropdown_menu(extra_class="data-table-facet-menu") %}
      {% for option in options %}
        {{ data_table_facet_item(option.label, icon=option.icon | default(""), count=option.count if option.count is defined else none, attrs='data-data-table-facet-option="' ~ option.value ~ '"') }}
      {% endfor %}
      {{ dropdown_divider() }}
      {{ dropdown_item("Clear filters", attrs="data-data-table-facet-clear") }}
    {% endcall %}
  </div>
{%- endmacro %}

{% macro data_table_column_header(key, label, align="", sortable=true, width="") -%}
  {% set th_class = "data-table-col" %}
  {% if align %}{% set th_class = th_class ~ " text-" ~ align %}{% endif %}
  {% set width_attr = ' style="width: ' ~ width ~ ';"' if width else "" %}
  {% if sortable %}
    <th scope="col" class="{{ th_class }}" data-data-table-column="{{ key }}"{{ width_attr | safe }}>
      <div class="dropdown data-table-sort">
        <button class="btn btn-ghost btn-sm data-table-sort-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-data-table-sort-key="{{ key }}">
          <span>{{ label }}</span>
          <span class="data-table-sort-icon" aria-hidden="true" data-data-table-sort-icon>{{ render_icon("chevrons-up-down", "inline-end") }}</span>
        </button>
        {% call dropdown_menu() %}
          {{ dropdown_item("Asc", icon="arrow-up", attrs='data-data-table-sort-action="asc"') }}
          {{ dropdown_item("Desc", icon="arrow-down", attrs='data-data-table-sort-action="desc"') }}
          {{ dropdown_divider() }}
          {{ dropdown_item("Hide", icon="eye-off", attrs='data-data-table-sort-action="hide"') }}
        {% endcall %}
      </div>
    </th>
  {% else %}
    <th scope="col" class="{{ th_class }}" data-data-table-column="{{ key }}"{{ width_attr | safe }}>{{ label }}</th>
  {% endif %}
{%- endmacro %}

{% macro data_table(
  id,
  columns,
  rows,
  facets=[],
  search_placeholder="Filter...",
  page_sizes=[10, 20, 30, 40, 50],
  default_page_size=10,
  selectable=true,
  extra_class=""
) -%}
  {% if not id | trim %}{{ fail("Data Table id is required") }}{% endif %}
  {% if not columns %}{{ fail("Data Table columns are required") }}{% endif %}
  {% if not rows %}{{ fail("Data Table rows are required") }}{% endif %}
  {% if default_page_size not in page_sizes %}{{ fail("Data Table default_page_size must be one of page_sizes") }}{% endif %}
  {% set table_id = id ~ "-table" %}
  <div class="data-table{% if extra_class %} {{ extra_class }}{% endif %}" id="{{ id }}" data-data-table-page-size="{{ default_page_size }}">
    <div class="data-table-toolbar d-flex flex-wrap align-items-center gap-2 mb-3" data-data-table-toolbar>
      <input class="form-control form-control-sm data-table-search" type="search" placeholder="{{ search_placeholder }}" aria-label="{{ search_placeholder }}" data-data-table-search>
      {% for facet in facets %}
        {{ data_table_facet(facet.key, facet.label, facet.options) }}
      {% endfor %}
      <button type="button" class="btn btn-ghost btn-sm data-table-reset" hidden data-data-table-reset>
        Reset
        {{ render_icon("x", "inline-end") }}
      </button>
      <div class="dropdown data-table-view ms-auto">
        <button class="btn btn-outline-secondary btn-sm data-table-view-trigger" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
          {{ render_icon("sliders-horizontal", "inline-start") }}
          <span>View</span>
        </button>
        {% call dropdown_menu(align="end") %}
          {{ dropdown_header("Toggle columns") }}
          {% for column in columns %}
            {% if column.hideable | default(true) %}
              {{ dropdown_toggle_item(column.label, pressed=true, attrs='data-data-table-column-toggle="' ~ column.key ~ '"') }}
            {% endif %}
          {% endfor %}
        {% endcall %}
      </div>
    </div>
    <div class="table-responsive">
      <table class="table data-table-table" id="{{ table_id }}">
        <thead>
          <tr>
            {% if selectable %}
              <th scope="col" class="data-table-col-select">
                <input class="form-check-input" type="checkbox" aria-label="Select all rows" data-data-table-select-all>
              </th>
            {% endif %}
            {% for column in columns %}
              {{ data_table_column_header(column.key, column.label, align=column.align | default(""), sortable=column.sortable | default(true), width=column.width | default("")) }}
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
            <tr id="{{ row.id }}" data-data-table-row{% if row.search is defined %} data-data-table-search="{{ row.search }}"{% endif %}{% for facet_key, facet_value in (row.facets | default({})).items() %} data-data-table-facet-{{ facet_key }}="{{ facet_value }}"{% endfor %}>
              {% if selectable %}
                <td class="data-table-col-select">
                  <input class="form-check-input" type="checkbox" aria-label="Select {{ row.label | default(row.id) }}" data-data-table-select-row>
                </td>
              {% endif %}
              {% for column in columns %}
                {% set align = column.align | default("") %}
                <td class="data-table-col{% if align %} text-{{ align }}{% endif %}" data-data-table-column="{{ column.key }}"{% if row.sort is defined and column.key in row.sort %} data-data-table-sort-value="{{ row.sort[column.key] }}"{% endif %}>{{ row.cells[column.key] | safe }}</td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="data-table-pagination d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3" data-data-table-pagination>
      <div class="data-table-selection-count small text-body-secondary" data-data-table-selection-count></div>
      <div class="data-table-pagination-controls d-flex flex-wrap align-items-center gap-4 ms-auto">
        <div class="data-table-page-size d-flex align-items-center gap-2">
          <label class="small text-body-secondary text-nowrap" for="{{ id }}-page-size">Rows per page</label>
          <select class="form-select form-select-sm" id="{{ id }}-page-size" data-data-table-page-size-select>
            {% for size in page_sizes %}
              <option value="{{ size }}"{% if size == default_page_size %} selected{% endif %}>{{ size }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="data-table-page-status small text-nowrap" data-data-table-page-status></div>
        <nav aria-label="Table pagination" class="data-table-page-nav">
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item">
              <button type="button" class="page-link" aria-label="Go to first page" data-data-table-page-first>{{ render_icon("chevrons-left", "inline-start") }}</button>
            </li>
            <li class="page-item">
              <button type="button" class="page-link" aria-label="Go to previous page" data-data-table-page-prev>{{ render_icon("chevron-left", "inline-start") }}</button>
            </li>
            <template data-data-table-page-numbers></template>
            <li class="page-item">
              <button type="button" class="page-link" aria-label="Go to next page" data-data-table-page-next>{{ render_icon("chevron-right", "inline-start") }}</button>
            </li>
            <li class="page-item">
              <button type="button" class="page-link" aria-label="Go to last page" data-data-table-page-last>{{ render_icon("chevrons-right", "inline-start") }}</button>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
{%- endmacro %}
