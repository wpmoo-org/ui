{% set tabs_orientations = ["horizontal", "vertical"] %}

{% macro tabs(id, items, extra_class="", orientation="horizontal") -%}
  {% if not id | trim %}{{ fail("Tabs id is required") }}{% endif %}
  {% if not items %}{{ fail("Tabs requires at least one item") }}{% endif %}
  {% if orientation not in tabs_orientations %}{{ fail("Unknown tabs orientation: " ~ orientation) }}{% endif %}
  {% set has_explicit_active = items | selectattr("active", "defined") | selectattr("active") | list | length > 0 %}
  {% set is_vertical = orientation == "vertical" %}
  {% set wrapper_classes = "" %}
  {% if is_vertical %}{% set wrapper_classes = "tabs tabs--vertical" %}{% endif %}
  {% if extra_class %}{% set wrapper_classes = (wrapper_classes ~ " " ~ extra_class) | trim %}{% endif %}
  {% set list_classes = "tabs-list nav nav-pills" %}
  {% if is_vertical %}{% set list_classes = list_classes ~ " flex-column" %}{% endif %}
  {% set toggle = "pill" if is_vertical else "tab" %}
  <div{% if wrapper_classes %} class="{{ wrapper_classes }}"{% endif %}>
    <div class="{{ list_classes }}" id="{{ id }}-list" role="tablist"{% if is_vertical %} aria-orientation="vertical"{% endif %}>
      {% for item in items %}
        {% if not item.id | default("", true) | trim %}{{ fail("Tabs item id is required") }}{% endif %}
        {% if not item.title | default("", true) | trim %}{{ fail("Tabs item title is required") }}{% endif %}
        {% set is_active = (item.active is defined and item.active) or (not has_explicit_active and loop.first) %}
        {% set is_disabled = item.disabled is defined and item.disabled %}
        {% set tab_id = id ~ "-" ~ item.id ~ "-tab" %}
        {% set pane_id = id ~ "-" ~ item.id ~ "-pane" %}
        <button class="nav-link{% if is_active %} active{% endif %}" id="{{ tab_id }}" data-bs-toggle="{{ toggle }}" data-bs-target="#{{ pane_id }}" type="button" role="tab" aria-controls="{{ pane_id }}" aria-selected="{{ "true" if is_active else "false" }}"{% if is_disabled %} disabled{% endif %}>{{ item.title }}</button>
      {% endfor %}
    </div>
    <div class="tab-content" id="{{ id }}-content">
      {% for item in items %}
        {% set is_active = (item.active is defined and item.active) or (not has_explicit_active and loop.first) %}
        {% set tab_id = id ~ "-" ~ item.id ~ "-tab" %}
        {% set pane_id = id ~ "-" ~ item.id ~ "-pane" %}
        <div class="tab-pane fade{% if is_active %} show active{% endif %}" id="{{ pane_id }}" role="tabpanel" aria-labelledby="{{ tab_id }}" tabindex="0">{{ item.content | safe }}</div>
      {% endfor %}
    </div>
  </div>
{%- endmacro %}
