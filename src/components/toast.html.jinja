{# Toast uses Bootstrap markup and lifecycle. The catalog may target a Toast
   template to create one independent Toast per trigger activation. #}
{% from "components/button.html.jinja" import button %}
{% from "components/close_button.html.jinja" import close_button %}

{% set toast_placements = {
  "top-start": "top-0 start-0",
  "top-center": "top-0 start-50 translate-middle-x",
  "top-end": "top-0 end-0",
  "bottom-start": "bottom-0 start-0",
  "bottom-center": "bottom-0 start-50 translate-middle-x",
  "bottom-end": "bottom-0 end-0"
} %}

{% set toast_priorities = {
  "polite": {"role": "status", "live": "polite"},
  "assertive": {"role": "alert", "live": "assertive"}
} %}

{% set toast_variant_icons = {
  "default": "",
  "success": "circle-check",
  "info": "info",
  "warning": "triangle-alert",
  "destructive": "circle-alert",
  "loading": "loader-circle"
} %}

{% set toast_variant_aliases = {
  "danger": "destructive",
  "error": "destructive"
} %}

{% macro toast_container(placement="bottom-end", extra_class="", stacked=false) -%}
  {% if placement not in toast_placements %}{{ fail("Unknown toast placement: " ~ placement) }}{% endif %}
  {% if stacked and placement != "bottom-end" %}{{ fail("stacked Toast containers require placement=bottom-end") }}{% endif %}
  {% set classes = "toast-container position-fixed " ~ toast_placements[placement] ~ " p-3" %}
  {% if stacked %}{% set classes = classes ~ " toast-container--stacked" %}{% endif %}
  <div class="{{ classes }}{% if extra_class %} {{ extra_class }}{% endif %}"{% if stacked %} data-toast-stack="deck"{% endif %}>
    {{ caller() | trim | safe }}
  </div>
{%- endmacro %}

{% macro toast(id, title, body, timestamp="", autohide=true, delay=5000, dismiss_aria_label="Close", priority="polite", action_label="", action_aria_label="Undo", variant="default") -%}
  {% if not id | trim %}{{ fail("Toast id is required") }}{% endif %}
  {% if not title | trim %}{{ fail("Toast title is required") }}{% endif %}
  {% if not body | trim %}{{ fail("Toast body is required") }}{% endif %}
  {% if priority not in toast_priorities %}{{ fail("Unknown toast priority: " ~ priority) }}{% endif %}
  {% set requested_variant = variant | default("default", true) | trim %}
  {% set toast_variant = toast_variant_aliases[requested_variant] if requested_variant in toast_variant_aliases else requested_variant %}
  {% if toast_variant not in toast_variant_icons %}{{ fail("Unknown toast variant: " ~ requested_variant) }}{% endif %}
  {% set semantics = toast_priorities[priority] %}
  {% set status_icon = toast_variant_icons[toast_variant] %}
  <div
    id="{{ id }}"
    class="toast"
    {% if toast_variant != "default" %}data-toast-variant="{{ toast_variant }}"{% endif %}
    role="{{ semantics.role }}"
    aria-live="{{ semantics.live }}"
    aria-atomic="true"
    {% if not autohide %}data-bs-autohide="false"{% endif %}
    {% if delay != 5000 %}data-bs-delay="{{ delay }}"{% endif %}
  >
    <div class="toast-header">
      {% if status_icon %}<span class="toast-status-icon" aria-hidden="true">{{ render_icon(status_icon, "inline-start") }}</span>{% endif %}
      <strong class="me-auto">{{ title }}</strong>
      {% if timestamp %}<small>{{ timestamp }}</small>{% endif %}
      {{ close_button(aria_label=dismiss_aria_label, dismiss="toast") }}
    </div>
    <div class="toast-body">
      {{ body }}
      {% if action_label %}
        {{ button(action_label, variant="link", size="sm", extra_class="p-0 ms-2", dismiss="toast", aria_label=action_aria_label) }}
      {% endif %}
    </div>
  </div>
{%- endmacro %}

{% macro toast_template(id, title, body, timestamp="", autohide=true, delay=5000, dismiss_aria_label="Close", priority="polite", action_label="", action_aria_label="Undo", variant="default") -%}
  <template id="{{ id }}" data-toast-template="toast">
    {{ toast(id, title, body, timestamp, autohide, delay, dismiss_aria_label, priority, action_label, action_aria_label, variant) }}
  </template>
{%- endmacro %}
