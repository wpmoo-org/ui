{% set combobox_directions = ["", "ltr", "rtl"] %}

{% macro combobox_option_content(item, selected=false) -%}
  {% if item.get("icon") %}{{ render_icon(item["icon"], "inline-start") }}{% endif %}
  <span class="combobox-option__body">
    <span class="combobox-option__label">{{ item["label"] }}</span>
    {% if item.get("description") %}<span class="combobox-option__description">{{ item["description"] }}</span>{% endif %}
  </span>
  {% if item.get("badge") %}<span class="badge text-bg-{{ item.get("badge_variant", "secondary") }} combobox-option__badge">{{ item["badge"] }}</span>{% endif %}
  {% if item.get("meta") %}<span class="combobox-option__meta">{{ item["meta"] }}</span>{% endif %}
  {% if selected %}<span class="ms-auto combobox-option__check">{{ render_icon("check", "inline-end") }}</span>{% endif %}
{%- endmacro %}

{% macro combobox_options(id, items, state) -%}
  {% for item in items %}
    {% if item.options is defined %}
      <li><h6 class="dropdown-header combobox-group-label">{{ item["label"] }}</h6></li>
      {% for child in item.options %}
        {% set state.option_index = state.option_index + 1 %}
        {% set option_id = id ~ "-option-" ~ state.option_index %}
        {% set is_selected = child["value"] == state.selected %}
        {% set is_highlighted = child["value"] == state.highlighted %}
        <li>
          <button class="dropdown-item combobox-option" id="{{ option_id }}" type="button" role="option" data-value="{{ child["value"] }}"{% if is_selected %} aria-selected="true"{% else %} aria-selected="false"{% endif %}{% if is_highlighted %} aria-current="true"{% endif %}{% if child.get("disabled") %} disabled{% endif %}>
            {{ combobox_option_content(child, is_selected) }}
          </button>
        </li>
      {% endfor %}
    {% else %}
      {% set state.option_index = state.option_index + 1 %}
      {% set option_id = id ~ "-option-" ~ state.option_index %}
      {% set is_selected = item["value"] == state.selected %}
      {% set is_highlighted = item["value"] == state.highlighted %}
      <li>
        <button class="dropdown-item combobox-option" id="{{ option_id }}" type="button" role="option" data-value="{{ item["value"] }}"{% if is_selected %} aria-selected="true"{% else %} aria-selected="false"{% endif %}{% if is_highlighted %} aria-current="true"{% endif %}{% if item.get("disabled") %} disabled{% endif %}>
          {{ combobox_option_content(item, is_selected) }}
        </button>
      </li>
    {% endif %}
  {% endfor %}
{%- endmacro %}

{% macro combobox(
  id="",
  label="",
  aria_label="",
  name="",
  placeholder="",
  items=[],
  selected="",
  describedby="",
  disabled=false,
  invalid=false,
  required=false,
  multiple=false,
  clearable=false,
  open=false,
  highlight_first=false,
  trigger_label="",
  dir="",
  extra_class=""
) -%}
  {% set has_label = label | trim %}
  {% set has_aria_label = aria_label | trim %}
  {% if (has_label and has_aria_label) or (not has_label and not has_aria_label) %}{{ fail("Combobox requires exactly one of label or aria_label") }}{% endif %}
  {% if not id | trim %}{{ fail("Combobox id is required") }}{% endif %}
  {% if not items %}{{ fail("Combobox items are required") }}{% endif %}
  {% if dir not in combobox_directions %}{{ fail("Unknown combobox direction: " ~ dir) }}{% endif %}

  {% set input_id = id ~ "-input" %}
  {% set listbox_id = id ~ "-listbox" %}
  {% set state = namespace(selected=selected, label="", highlighted="", highlighted_id="", option_index=0) %}
  {% for item in items %}
    {% if item.options is defined %}
      {% if "label" not in item or not item["label"] | trim or not item.options %}{{ fail("Combobox group label and options are required") }}{% endif %}
      {% for child in item.options %}
        {% if "value" not in child or "label" not in child or not child["label"] | trim %}{{ fail("Combobox item value and label are required") }}{% endif %}
        {% if child.get("selected") and not state.selected %}{% set state.selected = child["value"] %}{% endif %}
      {% endfor %}
    {% else %}
      {% if "value" not in item or "label" not in item or not item["label"] | trim %}{{ fail("Combobox item value and label are required") }}{% endif %}
      {% if item.get("selected") and not state.selected %}{% set state.selected = item["value"] %}{% endif %}
    {% endif %}
  {% endfor %}
  {% for item in items %}
    {% if item.options is defined %}
      {% for child in item.options %}
        {% if child["value"] == state.selected %}{% set state.label = child["label"] %}{% endif %}
      {% endfor %}
    {% else %}
      {% if item["value"] == state.selected %}{% set state.label = item["label"] %}{% endif %}
    {% endif %}
  {% endfor %}
  {% for item in items %}
    {% if item.options is defined %}
      {% for child in item.options %}
        {% set state.option_index = state.option_index + 1 %}
        {% if highlight_first and not state.selected and not state.highlighted and not child.get("disabled") %}
          {% set state.highlighted = child["value"] %}
          {% set state.highlighted_id = id ~ "-option-" ~ state.option_index %}
        {% endif %}
      {% endfor %}
    {% else %}
      {% set state.option_index = state.option_index + 1 %}
      {% if highlight_first and not state.selected and not state.highlighted and not item.get("disabled") %}
        {% set state.highlighted = item["value"] %}
        {% set state.highlighted_id = id ~ "-option-" ~ state.option_index %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% set expanded = "false" %}
  {% if open %}{% set expanded = "true" %}{% endif %}

  <div class="combobox{% if extra_class %} {{ extra_class }}{% endif %}"{% if dir %} dir="{{ dir }}"{% endif %}>
    {% if has_label %}<label class="form-label" for="{{ input_id }}">{{ label }}{% if required %} <span class="text-danger">*</span>{% endif %}</label>{% endif %}
    {% if trigger_label %}
      <button class="btn btn-outline-secondary combobox-popup-trigger" type="button"{% if disabled %} disabled{% endif %} data-bs-toggle="dropdown" aria-expanded="{{ expanded }}" aria-controls="{{ listbox_id }}">
        <span>{{ trigger_label }}</span>
        {{ render_icon("chevrons-up-down", "inline-end") }}
      </button>
      <ul class="dropdown-menu combobox-menu{% if open %} show{% endif %}" id="{{ listbox_id }}" role="listbox"{% if multiple %} aria-multiselectable="true"{% endif %}{% if open %} data-bs-popper="static"{% endif %}>
        <li class="combobox-search-row">
          <div class="input-group combobox-control combobox-control--popup">
            <span class="input-group-text combobox-addon">{{ render_icon("search", "inline-start") }}</span>
            <input class="form-control combobox-input{% if invalid %} is-invalid{% endif %}" id="{{ input_id }}" type="search"{% if name %} name="{{ name }}"{% endif %} role="combobox" aria-expanded="{{ expanded }}" aria-controls="{{ listbox_id }}" aria-autocomplete="list"{% if state.highlighted_id %} aria-activedescendant="{{ state.highlighted_id }}"{% endif %}{% if multiple %} aria-multiselectable="true"{% endif %}{% if has_aria_label %} aria-label="{{ aria_label }}"{% endif %}{% if describedby %} aria-describedby="{{ describedby }}"{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if state.label %} value="{{ state.label }}"{% endif %}{% if invalid %} aria-invalid="true"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}>
          </div>
        </li>
        {% if name %}<li><input type="hidden" name="{{ name }}-value" value="{{ state.selected }}"></li>{% endif %}
        {% set state.option_index = 0 %}
        {{ combobox_options(id, items, state) }}
      </ul>
    {% else %}
      <div class="input-group combobox-control">
        <span class="input-group-text combobox-addon">{{ render_icon("search", "inline-start") }}</span>
        <input class="form-control combobox-input{% if invalid %} is-invalid{% endif %}" id="{{ input_id }}" type="search"{% if name %} name="{{ name }}"{% endif %} role="combobox" aria-expanded="{{ expanded }}" aria-controls="{{ listbox_id }}" aria-autocomplete="list"{% if state.highlighted_id %} aria-activedescendant="{{ state.highlighted_id }}"{% endif %}{% if multiple %} aria-multiselectable="true"{% endif %}{% if has_aria_label %} aria-label="{{ aria_label }}"{% endif %}{% if describedby %} aria-describedby="{{ describedby }}"{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if state.label %} value="{{ state.label }}"{% endif %}{% if invalid %} aria-invalid="true"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}>
        {% if name %}<input type="hidden" name="{{ name }}-value" value="{{ state.selected }}">{% endif %}
        {% if clearable %}<button class="btn btn-ghost btn-icon combobox-clear" type="button"{% if disabled %} disabled{% endif %} aria-label="Clear selection">{{ render_icon("x", "inline-start") }}</button>{% endif %}
        <span class="input-group-text combobox-indicator" aria-hidden="true">{{ render_icon("chevrons-up-down", "inline-end") }}</span>
        <ul class="dropdown-menu combobox-menu{% if open %} show{% endif %}" id="{{ listbox_id }}" role="listbox"{% if multiple %} aria-multiselectable="true"{% endif %}{% if open %} data-bs-popper="static"{% endif %}>
          {% set state.option_index = 0 %}
          {{ combobox_options(id, items, state) }}
        </ul>
      </div>
    {% endif %}
  </div>
{%- endmacro %}
