{% from "components/badge.html.jinja" import badge %}
{% from "components/typography.html.jinja" import typography %}

{% set nav_styles = {
  "base": "nav",
  "pills": "nav nav-pills",
  "underline": "nav nav-underline",
  "steps": "nav nav-pills nav-steps flex-column"
} %}

{% set nav_directions = ["", "ltr", "rtl"] %}

{% macro nav_menu(aria_label, style="pills", vertical=false, extra_class="", dir="", id="", data={}, heading="", root_class="") -%}
  {% if not aria_label | trim %}{{ fail("Navigation aria_label is required") }}{% endif %}
  {% if style not in nav_styles %}{{ fail("Unknown navigation style: " ~ style) }}{% endif %}
  {% if dir not in nav_directions %}{{ fail("Unknown navigation direction: " ~ dir) }}{% endif %}
  {% if id is not string or (id and (id != id | trim or id.split() | length != 1)) %}{{ fail("Invalid navigation id") }}{% endif %}
  {% if data is not mapping %}{{ fail("Navigation data must be a mapping") }}{% endif %}
  {% for key, value in data.items() %}
    {% if key is not string or not key %}{{ fail("Invalid navigation data key") }}{% endif %}
    {% for part in key.split("-") %}
      {% if not part %}{{ fail("Invalid navigation data key") }}{% endif %}
      {% for character in part %}
        {% if character not in "abcdefghijklmnopqrstuvwxyz" %}{{ fail("Invalid navigation data key") }}{% endif %}
      {% endfor %}
    {% endfor %}
    {% if value is not string and value is not number and value is not boolean and value is not none %}{{ fail("Navigation data values must be scalar") }}{% endif %}
  {% endfor %}
  {% if heading is not string or root_class is not string %}{{ fail("Navigation heading and root_class must be strings") }}{% endif %}
  {% set classes = nav_styles[style] %}
  {% if vertical and style != "steps" %}{% set classes = classes ~ " flex-column gap-1" %}{% endif %}
  {% if extra_class %}{% set classes = classes ~ " " ~ extra_class %}{% endif %}
  <nav aria-label="{{ aria_label | forceescape }}"{% if dir %} dir="{{ dir }}"{% endif %}{% if id %} id="{{ id | forceescape }}"{% endif %}{% if root_class %} class="{{ root_class | forceescape }}"{% endif %}{% for key, value in data.items() %} data-{{ key }}="{{ value | forceescape }}"{% endfor %}>
    {% if heading %}{{ typography(heading | forceescape, "section-label") }}{% endif %}
    <ul class="{{ classes }}">
      {{ caller() | trim | safe }}
    </ul>
  </nav>
{%- endmacro %}

{% macro nav_item(label, href="#", active=false, disabled=false, icon="", end_icon="", badge_label="", badge_variant="secondary", description="", completed=false, completed_label="Completed") -%}
  {% if not label | trim %}{{ fail("Navigation item label is required") }}{% endif %}
  {% set classes = "nav-link" %}
  {% if active %}{% set classes = classes ~ " active" %}{% endif %}
  {% if disabled %}{% set classes = classes ~ " disabled" %}{% endif %}
  <li class="nav-item"{% if completed %} data-nav-completed="true"{% endif %}>
    <a class="{{ classes }}"{% if not disabled %} href="{{ href }}"{% else %} aria-disabled="true" tabindex="-1"{% endif %}{% if active %} aria-current="page"{% endif %}>
      {% if icon %}<span class="nav-link-icon" aria-hidden="true">{{ render_icon(icon, "inline-start") }}</span>{% endif %}
      <span>
        {{ label }}
        {% if description %}<span class="nav-link-description d-block small">{{ description }}</span>{% endif %}
        {% if completed %}<span class="visually-hidden">{{ completed_label }}</span>{% endif %}
      </span>
      {% if badge_label %}{{ badge(badge_label, variant=badge_variant, pill=true, extra_class="ms-auto") }}{% endif %}
      {% if end_icon %}<span class="ms-auto">{{ render_icon(end_icon, "inline-end") }}</span>{% endif %}
    </a>
  </li>
{%- endmacro %}
