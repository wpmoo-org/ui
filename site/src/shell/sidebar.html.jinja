{% from "components/sidebar.html.jinja" import sidebar, sidebar_brand_mark, sidebar_content, sidebar_group, sidebar_group_label, sidebar_header, sidebar_menu, sidebar_menu_button, sidebar_menu_item, sidebar_menu_sub, sidebar_menu_sub_button, sidebar_menu_sub_item %}
{% from "includes/component-icons.html.jinja" import component_icons %}

{% set utility_icons = {
  "scroll-fade": "scroll"
} %}

{#- The sidebar now owns every top-level navigation entry the navbar used
    to carry (Home/Docs/Components/Blocks/Examples) -- the navbar itself
    is header chrome only (toggle, search, theme, GitHub). nav_groups is
    plain data (label/href/icon/active, or a submenu with children), built
    once here and then rendered as sidebar_group/sidebar_menu. Keeping the
    group/item shape data-first -- not sidebar-markup calls inline -- means
    a future "no sidebar" layout variant can render this exact structure
    as a top nav instead, without duplicating which pages belong where. #}
{% set introduction = (sections | selectattr("slug", "equalto", "introduction") | list)[0] %}
{% set installation = (sections | selectattr("slug", "equalto", "installation") | list)[0] %}
{% set blocks_page = (sections | selectattr("slug", "equalto", "blocks") | list)[0] %}
{% set resource_pages = sections | rejectattr("slug", "in", ["introduction", "installation", "components", "blocks"]) | list %}
{% set components_open = current_section == "components" %}
{% set examples_open = current_section == "examples" %}
{% set charts_active = current_section == "sections" and current_slug == "charts" %}
{% set home_active = current_section == "sections" and current_slug == "index" %}

{% set component_children = [{
  "label": "All Components",
  "href": "components/index.html",
  "icon": "layout-grid",
  "active": components_open and current_slug == "components"
}] %}
{% for component in catalog | sort(attribute="label") %}
  {% set _ = component_children.append({
    "label": component.label,
    "href": "components/" ~ component.slug ~ ".html",
    "icon": component_icons.get(component.slug, "component"),
    "active": components_open and current_slug == component.slug
  }) %}
{% endfor %}

{% set catalog_items = [
  {"kind": "link", "label": "Examples", "href": "examples/index.html", "icon": "list-todo", "active": examples_open},
  {"kind": "submenu", "id": "shell-components-menu", "label": "Components", "icon": "component", "open": components_open, "active": components_open, "children": component_children},
  {"kind": "link", "label": blocks_page.label, "href": blocks_page.href, "icon": blocks_page.icon, "active": current_section == "blocks"},
  {"kind": "link", "label": "Charts", "href": "charts/index.html", "icon": "chart-area", "active": charts_active}
] %}
{#- One utility ships today; the entry links straight to it and keeps the
    Catalog group's Utilities slot for later growth. #}
{% for utility in utilities %}
  {% set _ = catalog_items.append({
    "kind": "link",
    "label": "Utilities",
    "href": "utils/" ~ utility.slug ~ ".html",
    "icon": utility_icons.get(utility.slug, "sparkles"),
    "active": current_section == "utils"
  }) %}
{% endfor %}

{% set resource_items = [] %}
{% for page in resource_pages %}
  {% set _ = resource_items.append({
    "kind": "link",
    "label": page.label,
    "href": page.href,
    "icon": page.icon,
    "active": (current_section == "sections" and current_slug == page.slug) or (current_section == page.slug)
  }) %}
{% endfor %}

{% set nav_groups = [
  {
    "label": "Getting Started",
    "entries": [
      {"kind": "link", "label": "Home", "href": "index.html", "icon": "house", "active": home_active},
      {"kind": "link", "label": introduction.label, "href": introduction.href, "icon": introduction.icon, "active": current_section == "sections" and current_slug == introduction.slug},
      {"kind": "link", "label": installation.label, "href": installation.href, "icon": installation.icon, "active": current_section == "sections" and current_slug == installation.slug}
    ]
  },
  {"label": "Catalog", "entries": catalog_items},
  {"label": "Resources", "entries": resource_items}
] %}

{% macro _render_nav_item(item) -%}
  {% call sidebar_menu_item() %}
    {% if item.kind == "submenu" %}
      {{ sidebar_menu_sub_button(item.label, item.id, icon=item.icon, active=item.active, open=item.open) }}
      {% call sidebar_menu_sub(item.id, open=item.open) %}
        {% for child in item.children %}
          {% call sidebar_menu_sub_item() %}
            {{ sidebar_menu_button(child.label, href=site_href(child.href, root_path), active=child.active, icon=child.icon) }}
          {% endcall %}
        {% endfor %}
      {% endcall %}
    {% else %}
      {{ sidebar_menu_button(item.label, href=site_href(item.href, root_path), active=item.active, icon=item.icon) }}
    {% endif %}
  {% endcall %}
{%- endmacro %}

{% call sidebar(id="catalog-sidebar", aria_label="Catalog navigation") %}
  {% call sidebar_header() %}
    {% call sidebar_menu() %}
      {% call sidebar_menu_item() %}
        {{ sidebar_menu_button(
          "Moo UI",
          subtitle="Component system",
          size="lg",
          href=site_href("index.html", root_path),
          lead=sidebar_brand_mark("blocks")
        ) }}
      {% endcall %}
    {% endcall %}
  {% endcall %}

  {% call sidebar_content() %}
    {% for group in nav_groups %}
      {% call sidebar_group() %}
        {{ sidebar_group_label(group.label) }}
        {% call sidebar_menu() %}
          {% for item in group.entries %}
            {{ _render_nav_item(item) }}
          {% endfor %}
        {% endcall %}
      {% endcall %}
    {% endfor %}
  {% endcall %}
{% endcall %}
