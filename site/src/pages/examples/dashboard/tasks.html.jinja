{% extends "layouts/catalog.html.jinja" %}
{% from "blocks/datatable_tasks.html.jinja" import render_task_sheet, render_task_delete_dialog, render_tasks_table %}
{% from "components/button.html.jinja" import button %}
{% from "includes/codepen.html.jinja" import codepen_button, tasks_codepen_css, tasks_codepen_js with context %}
{% from "includes/example-component-reference.html.jinja" import example_component_reference with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% set page_category = "Dashboard" %}

{% block title %}Tasks — Moo UI{% endblock %}

{% macro tasks_body() %}
  {#- Examples pages are full-width app screens: no doc reading measure,
     no TOC column. The table is a live, in-browser workspace: New Task
     opens a sheet form, rows can be opened, edited, copied, and deleted,
     and bulk selection works — all client-side, nothing is stored. #}
  <div class="moo-examples-page" data-moo-example-tasks>
    {{ render_page_header(
      "Tasks",
      "A live work queue — changes stay in your browser.",
      id="tasks",
      actions=button("New Task", icon_start="plus", element="button", sheet_target="tasks-new-sheet")
    ) }}

    {{ render_tasks_table(id="examples-tasks-datatable") }}

    {{ render_task_sheet() }}
    {{ render_task_delete_dialog() }}
  </div>
{% endmacro %}

{% block content %}
  {{ tasks_body() }}
{% endblock %}

{% macro tasks_footer(codepen_action="") %}
  <footer class="moo-examples-footer text-body-secondary small">
    <p class="mb-0">
      Composed from the
      {{ example_component_reference("sidebar") }},
      {{ example_component_reference("datatable") }},
      {{ example_component_reference("sheet") }},
      {{ example_component_reference("alert-dialog") }},
      {{ example_component_reference("dropdown-menu") }},
      {{ example_component_reference("badge") }}, and
      {{ example_component_reference("button") }}
      components.
    </p>
    {{ codepen_action }}
  </footer>
{% endmacro %}

{% block footer %}
  {% set page_markup %}{{ tasks_body() }}{{ tasks_footer() }}{% endset %}
  {{ tasks_footer(codepen_action=codepen_button(
    "Moo UI — Tasks",
    "A live Tasks dashboard screen built from Moo UI's Data Table, Sheet, Alert Dialog, Dropdown Menu, Badge, and Button components.",
    page_markup,
    tasks_codepen_css(),
    ["moo-ui", "bootstrap", "datatable", "css"],
    js=tasks_codepen_js(),
    js_external="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/js/bootstrap.bundle.min.js",
    editors="111"
  )) }}
{% endblock %}
