{% extends "layouts/catalog.html.jinja" %}
{% from "components/card.html.jinja" import card %}
{% from "components/dropdown_menu.html.jinja" import dropdown_divider, dropdown_menu %}
{% from "components/separator.html.jinja" import separator %}
{% from "components/typography.html.jinja" import typography %}
{% from "includes/doc-toc.html.jinja" import render_doc_toc %}
{% from "includes/example-previews.html.jinja" import example_preview %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_pagination %}

{% set example_descriptions = {
  "auth/forgot-password": "Request a password reset link from a full-bleed auth screen.",
  "auth/sign-in": "Email and password sign-in, with links to Sign Up and Forgot Password.",
  "auth/sign-up": "Create an account with name, email, and password.",
  "settings/profile": "Update profile details — name, email, and bio.",
  "settings/account": "Change language and timezone preferences.",
  "settings/appearance": "Toggle compact mode, avatars, and email digests.",
  "dashboard/tasks": "A work queue with search, sorting, list/card views, and a New Task action on Data Table.",
  "dashboard/users": "A workspace user directory with search, sorting, and status/team filters on Data Table.",
  "marketing/pricing": "Three pricing tiers with feature lists and plan CTAs.",
  "marketing/faq": "A stacked FAQ with disclosure sections."
} %}

{% block title %}Examples — Moo UI{% endblock %}

{% block content %}
  {#- The individual example screens (Sign In, Settings/Profile, ...) stay
     full-bleed app screens -- this is only the index/gallery page, which
     reads like any other catalog listing: doc reading measure + a TOC of
     its categories. #}
  <div class="moo-doc-layout">
    <article class="moo-doc-page">
      {{ render_page_header(
        "Examples",
        "Real, multi-page screens built from Moo UI components. Click through them like an app, not a gallery.",
        id="examples"
      ) }}

      <section class="moo-catalog__dashboard" data-moo-examples-view="grid" aria-label="Examples">
        <div class="moo-catalog__toolbar moo-catalog__toolbar--examples">
          <div class="moo-catalog__toolbar-query" data-moo-catalog-filter-multi>
            <div class="input-group input-group-sm moo-catalog__searchbar">
              <span class="moo-catalog__search-icon" aria-hidden="true">{{ render_icon("search", "inline-start") }}</span>
              <input class="form-control moo-catalog__search" type="search" id="examples-search" placeholder="Filter examples..." aria-label="Filter examples">
              <button type="button" class="btn btn-ghost btn-icon-sm moo-catalog__filter-trigger" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Filter by section">
                {{ render_icon("list-filter", "inline-start") }}
              </button>
              {% call dropdown_menu(align="end", extra_class="moo-catalog__filter-menu") %}
                {% for category in examples | map(attribute="category") | unique | sort %}
                  <li>
                    <label class="dropdown-item moo-catalog__filter-option">
                      <input type="checkbox" class="form-check-input" data-moo-catalog-section-filter="{{ category | lower }}" autocomplete="off">
                      <span>{{ category }}</span>
                    </label>
                  </li>
                {% endfor %}
                {{ dropdown_divider() }}
                <li>
                  <button type="button" class="dropdown-item moo-catalog__filter-clear" data-moo-catalog-filter-clear>
                    {{ render_icon("x", "inline-start") }}
                    Clear filters
                  </button>
                </li>
              {% endcall %}
            </div>
          </div>
          <div class="moo-catalog__toolbar-actions">
            <div class="btn-group btn-group-sm moo-catalog__view-toggle" role="group" aria-label="Examples view">
              <input type="radio" class="btn-check" name="examples-view" id="examples-view-grid" value="grid" autocomplete="off" checked>
              <label class="btn btn-outline-secondary moo-catalog__view-option" for="examples-view-grid">
                {{ render_icon("layout-grid", "inline-start") }}
                <span class="visually-hidden">Grid view</span>
              </label>
              <input type="radio" class="btn-check" name="examples-view" id="examples-view-list" value="list" autocomplete="off">
              <label class="btn btn-outline-secondary moo-catalog__view-option" for="examples-view-list">
                {{ render_icon("list", "inline-start") }}
                <span class="visually-hidden">List view</span>
              </label>
            </div>
          </div>
        </div>

        {{ separator(extra_class="my-4") }}

        {% for category, items in examples | groupby("category") %}
          <section{% if not loop.first %} class="mt-5"{% endif %} aria-labelledby="examples-{{ category | lower }}" data-moo-catalog-section="{{ category | lower }}">
            {{ typography(category, variant="section-title", id="examples-" ~ (category | lower)) }}
            <div class="moo-catalog__grid moo-catalog__grid--examples">
              {% for example in items %}
                {% call card(extra_class="h-100 moo-catalog__app-card moo-catalog__showcase-card", body_class="d-grid gap-4") %}
                  <div class="moo-catalog__showcase-preview moo-catalog__example-preview">
                    {{ example_preview(example.slug, root_path) }}
                  </div>
                  <div>
                    <h2 class="h5 mb-2">
                      <a class="stretched-link text-body text-decoration-none" href="{{ site_href("examples/" ~ example.slug ~ ".html", root_path) }}">{{ example.label }}</a>
                    </h2>
                    <p class="text-body-secondary mb-0">
                      {{ example_descriptions.get(example.slug, example.description) }}
                    </p>
                  </div>
                {% endcall %}
              {% endfor %}
            </div>
          </section>
        {% endfor %}
      </section>

      {{ render_section_page_pagination("examples", site_pages, root_path) }}
    </article>

    {% set toc_categories = namespace(items=[]) %}
    {% for category in examples | map(attribute="category") | unique | sort %}
      {% set toc_categories.items = toc_categories.items + [{"id": "examples-" ~ (category | lower), "label": category}] %}
    {% endfor %}
    {{ render_doc_toc(toc_categories.items) }}
  </div>
{% endblock %}
