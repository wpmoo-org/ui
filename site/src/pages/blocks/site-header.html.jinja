{% extends "layouts/catalog.html.jinja" %}
{% from "blocks/site_header_example.html.jinja" import render_site_header_text_example, render_site_header_logo_example, render_site_header_dark_example %}
{% from "includes/block-example.html.jinja" import render_block_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Site Header — Moo UI{% endblock %}

{% block content %}
  {% set header_viewports = [
    {"label": "Desktop", "icon": "monitor", "width": 1280, "height": 360, "active": true},
    {"label": "Mobile", "icon": "smartphone", "width": 390, "height": 480}
  ] %}
  {{ render_page_header("Site Header", "The top bar of a marketing or institutional site: brand, main navigation with dropdowns, a utility row and header actions, with an offcanvas drawer below the breakpoint. Composed from Bootstrap Navbar and Offcanvas, Button, Dropdown Menu and Navigation.") }}
  <div class="moo-component-examples">
    {% set text %}{{ render_site_header_text_example() }}{% endset %}
    {{ render_block_example("site-header", "Site Header", "A text brand, a main list with one dropdown and an action button at the row end. Below the lg breakpoint the Menu button opens the drawer.", text, preview_class="moo-example__preview--shell", frame_src=site_href("blocks/previews/site-header.html", root_path), frame_width=1280, frame_height=360, frame_viewports=header_viewports) }}
    {% set logo %}{{ render_site_header_logo_example(root_path) }}{% endset %}
    {{ render_block_example("site-header-logo", "Logo and utility row", "A logo with visible brand text (the image is then decorative), a small utility row above the main row from lg up, and a drawer-only Donate item. In the drawer the main list comes first.", logo, preview_class="moo-example__preview--shell", frame_src=site_href("blocks/previews/site-header-logo.html", root_path), frame_width=1280, frame_height=360, frame_viewports=header_viewports) }}
    {% set dark %}{{ render_site_header_dark_example(root_path) }}{% endset %}
    {{ render_block_example("site-header-dark", "Dark surface", "surface=\"dark\" with the xl breakpoint and a logo only, so the image's alt text names the home link.", dark, preview_class="moo-example__preview--shell", frame_src=site_href("blocks/previews/site-header-dark.html", root_path), frame_width=1280, frame_height=360, frame_viewports=header_viewports) }}
    {% set rtl %}{{ render_site_header_logo_example(root_path, "site-header-rtl") }}{% endset %}
    {{ render_block_example("site-header-rtl", "RTL", "The same header with dir=\"rtl\": spacing, the drawer side and the utility row follow the writing direction.", rtl, preview_class="moo-example__preview--shell", frame_src=site_href("blocks/previews/site-header-rtl.html", root_path), frame_width=1280, frame_height=360, frame_viewports=header_viewports) }}
    <section class="moo-example" aria-labelledby="site-header-notes-title" data-moo-component-guide>
      <h2 class="h4" id="site-header-notes-title" data-toc-label="Notes">Notes</h2>
      <p>Every link must be a relative path, a fragment, or use <code>http</code>, <code>https</code>, <code>mailto</code> or <code>tel</code>; other schemes fail the build.</p>
      <p>The dark surface is a fixed nested theme owner (<code>.moo-ui</code> with <code>data-bs-theme="dark"</code>). A theme toggle in the actions slot would change only the header, so place a theme toggle outside the header or point it at the document owner explicitly.</p>
      <p>Pressing Escape inside the open drawer closes the whole drawer, even while a dropdown is open. This is how Bootstrap's Offcanvas and Dropdown compose, and the block does not change it.</p>
    </section>
  </div>
{% endblock %}
