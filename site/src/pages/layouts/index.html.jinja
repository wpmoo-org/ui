{% extends "layouts/catalog.html.jinja" %}
{% from "components/badge.html.jinja" import badge %}
{% from "components/card.html.jinja" import card %}
{% from "components/typography.html.jinja" import typography %}
{% from "includes/doc-toc.html.jinja" import render_doc_toc %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_actions, render_section_page_pagination %}

{% block title %}Layouts — Moo UI{% endblock %}

{% block content %}
  <div class="moo-doc-layout">
    <article class="moo-doc-page">
      {{ render_page_header(
        "Layouts",
        "Compose application shells and page surfaces from the two public Moo UI layout contracts.",
        id="layouts",
        actions=render_section_page_actions("layouts", site_pages, root_path)
      ) }}

      <p class="lead mb-4">
        Layouts own page topology; components own the visual and interactive
        primitives inside that topology. Use <code>app</code> for the optional
        navigation shell and <code>page</code> for the page regions that belong
        to the current screen.
      </p>

      <section class="moo-catalog__grid moo-catalog__grid--compact" aria-label="Public layouts">
        {% for layout in layouts | sort(attribute="label") %}
          {% call card(extra_class="h-100 moo-catalog__app-card", body_class="d-grid gap-3") %}
            <div class="d-flex align-items-start justify-content-between gap-3">
              <span class="moo-catalog__app-icon" aria-hidden="true">
                {{ render_icon("layout-dashboard" if layout.slug == "app" else "layout-template", "inline-start") }}
              </span>
              {{ badge("Preview", variant="outline") }}
            </div>
            <div>
              <h2 class="h5 mb-2">
                <a class="stretched-link text-body text-decoration-none" href="{{ site_href("layouts/" ~ layout.slug ~ ".html", root_path) }}">{{ layout.label }}</a>
              </h2>
              <p class="text-body-secondary mb-0">{{ layout.description }}</p>
            </div>
          {% endcall %}
        {% endfor %}
      </section>

      <section class="mt-5" aria-labelledby="contract">
        {{ typography("Public contract", variant="section-title", id="contract") }}
        <p class="mb-0">
          The public surface is intentionally small: <code>app</code> names the
          shell and its named <code>sidebar</code>/<code>page</code> callers;
          <code>page</code> names the semantic <code>header</code>,
          <code>main</code>, and <code>footer</code> regions. Both compose
          existing components and native Bootstrap utilities.
        </p>
      </section>

      {{ render_section_page_pagination("layouts", site_pages, root_path) }}
    </article>

    {{ render_doc_toc([
      {"id": "layouts", "label": "Layouts"},
      {"id": "contract", "label": "Public contract"}
    ]) }}
  </div>
{% endblock %}
