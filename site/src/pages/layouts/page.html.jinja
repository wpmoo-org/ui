{% extends "layouts/catalog.html.jinja" %}
{% from "layouts/page.html.jinja" import page %}
{% from "components/card.html.jinja" import card %}
{% from "includes/block-example.html.jinja" import render_block_example %}
{% from "includes/code-snippet.html.jinja" import render_code_snippet %}
{% from "includes/doc-toc.html.jinja" import render_doc_toc %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_actions, render_section_page_pagination %}

{% block title %}Page Layout — Moo UI{% endblock %}

{% block content %}
  <div class="moo-doc-layout">
    <article class="moo-doc-page">
      {{ render_page_header(
        "Page",
        "Provide semantic page regions with one shared Bootstrap content rail per region.",
        id="page",
        actions=render_section_page_actions("page", site_pages, root_path)
      ) }}

      <p class="lead mb-4">
        Use <code>page</code> for the current screen's semantic
        <code>header</code>, <code>main</code>, and <code>footer</code>
        regions. Each region keeps a full-width outer surface and receives one
        native Bootstrap content rail. Region content may be shorter or wider
        than the main content; alignment is a caller decision, not a new Moo
        layout primitive.
      </p>

      {% set page_example %}
        {% call(region) page(width="xl", id="workspace-page") %}
          {% if region == "header" %}
            <p class="text-body-secondary mb-0">Workspace / Requests</p>
          {% elif region == "main" %}
            {% call card() %}
              <h2 class="h4">Request review</h2>
              <p class="mb-0">Main content stays inside the shared container-xl rail.</p>
            {% endcall %}
          {% elif region == "footer" %}
            <p class="small text-body-secondary mb-0">Last updated just now</p>
          {% endif %}
        {% endcall %}
      {% endset %}
      {{ render_block_example(
        "page-regions",
        "Semantic page regions",
        "The complete page is previewed in a dedicated layout frame; the catalog document itself keeps its own single main element.",
        page_example,
        preview_class="moo-example__preview--shell",
        frame_src=site_href("layouts/previews/page.html", root_path),
        frame_width=768,
        frame_height=540
      ) }}

      {% set page_source %}
        {% raw %}{% from "layouts/page.html.jinja" import page %}

        {% call(region) page(width="xl", id="workspace-page") %}
          {% if region == "header" %}Page header
          {% elif region == "main" %}Main content
          {% elif region == "footer" %}Page footer{% endif %}
        {% endcall %}{% endraw %}
      {% endset %}
      {{ render_code_snippet("page-regions-source", page_source, "jinja") }}

      <section class="moo-example mt-5" aria-labelledby="page-widths">
        <div class="moo-example__header">
          <h2 class="h4" id="page-widths">Native width choices</h2>
          <p class="text-body-secondary mb-0">Choose a native Bootstrap container for the same caller content.</p>
        </div>
        <div class="moo-example__surface">
          <div class="moo-example__preview">
            <p class="mb-2"><code>width="base"</code> uses <code>container</code>.</p>
            <p class="mb-2"><code>width="xl"</code> uses <code>container-xl</code>.</p>
            <p class="mb-0"><code>width="fluid"</code> uses <code>container-fluid</code> with Bootstrap's native gutters.</p>
          </div>
        </div>
      </section>

      {% set page_width_source %}
        {% raw %}{% call(region) page(width="base") %}...{% endcall %}
        {% call(region) page(width="xl") %}...{% endcall %}
        {% call(region) page(width="fluid") %}...{% endcall %}{% endraw %}
      {% endset %}
      {{ render_code_snippet("page-width-source", page_width_source, "jinja") }}

      {{ render_section_page_pagination("page", site_pages, root_path) }}
    </article>

    {{ render_doc_toc([
      {"id": "page", "label": "Page"},
      {"id": "page-widths", "label": "Native width choices"}
    ]) }}
  </div>
{% endblock %}
