{% extends "layouts/catalog.html.jinja" %}
{% from "layouts/app.html.jinja" import app %}
{% from "layouts/page.html.jinja" import page %}
{% from "components/card.html.jinja" import card %}
{% from "components/sidebar.html.jinja" import sidebar_header, sidebar_content, sidebar_footer, sidebar_trigger, sidebar_menu_button %}
{% from "includes/block-example.html.jinja" import render_block_example %}
{% from "includes/code-snippet.html.jinja" import render_code_snippet %}
{% from "includes/doc-toc.html.jinja" import render_doc_toc %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_actions, render_section_page_pagination %}

{% block title %}App Layout — Moo UI{% endblock %}

{% block content %}
  <div class="moo-doc-layout">
    <article class="moo-doc-page">
      {{ render_page_header(
        "App",
        "Compose an optional Sidebar sibling and one independent Page sibling.",
        id="app",
        actions=render_section_page_actions("app", site_pages, root_path)
      ) }}

      <p class="lead mb-4">
        Use <code>app</code> when the route owns an application shell. The
        caller names the <code>sidebar</code> and <code>page</code> slots; when
        <code>navigation="none"</code>, only the page caller is emitted.
        The two public roots stay direct siblings, so the page can change
        independently from the navigation choice.
      </p>

      {% set app_example %}
        {% call(slot) app(
          navigation="sidebar",
          sidebar_key="workspace-shell",
          sidebar_id="workspace-sidebar",
          side="left",
          variant="floating",
          collapsible="icon"
        ) %}
          {% if slot == "sidebar" %}
            {% call sidebar_header() %}
              {{ sidebar_trigger(sidebar_id="workspace-sidebar") }}
            {% endcall %}
            {% call sidebar_content() %}
              {{ sidebar_menu_button("Overview", href="/", active=true) }}
              {{ sidebar_menu_button("Requests", href="/requests") }}
            {% endcall %}
            {% call sidebar_footer() %}Account{% endcall %}
          {% elif slot == "page" %}
            {% call(region) page(width="xl") %}
              {% if region == "header" %}<p class="text-body-secondary">Workspace</p>
              {% elif region == "main" %}
                {% call card() %}Application content{% endcall %}
              {% elif region == "footer" %}<p class="small text-body-secondary">Footer actions</p>
              {% endif %}
            {% endcall %}
          {% endif %}
        {% endcall %}
      {% endset %}
      {{ render_block_example(
        "app-sidebar",
        "Sidebar navigation",
        "The complete shell is previewed in a dedicated layout frame so the catalog page keeps one shell and one main document.",
        app_example,
        preview_class="moo-example__preview--shell",
        frame_src=site_href("layouts/previews/app-sidebar.html", root_path),
        frame_width=1280,
        frame_height=720
      ) }}

      {% set app_source %}
        {% raw %}{% from "layouts/app.html.jinja" import app %}
        {% from "layouts/page.html.jinja" import page %}
        {% from "components/sidebar.html.jinja" import sidebar_header, sidebar_content, sidebar_footer, sidebar_trigger, sidebar_menu_button %}

        {% call(slot) app(navigation="sidebar", sidebar_key="workspace-shell", sidebar_id="workspace-sidebar", side="left", variant="floating") %}
          {% if slot == "sidebar" %}
            {% call sidebar_header() %}{{ sidebar_trigger(sidebar_id="workspace-sidebar") }}{% endcall %}
            {% call sidebar_content() %}{{ sidebar_menu_button("Overview", href="/", active=true) }}{% endcall %}
            {% call sidebar_footer() %}Account{% endcall %}
          {% elif slot == "page" %}
            {% call(region) page(width="xl") %}
              {% if region == "header" %}Workspace header
              {% elif region == "main" %}Page content
              {% elif region == "footer" %}Page footer{% endif %}
            {% endcall %}
          {% endif %}
        {% endcall %}{% endraw %}
      {% endset %}
      {{ render_code_snippet("app-sidebar-source", app_source, "jinja") }}

      <section class="moo-example mt-5" aria-labelledby="app-contract">
        <div class="moo-example__header">
          <h2 class="h4" id="app-contract">Navigation and Sidebar choices</h2>
          <p class="text-body-secondary mb-0">Keep navigation explicit and forward Sidebar choices through the public component contract.</p>
        </div>
        <div class="moo-example__surface">
          <div class="moo-example__preview">
            <p class="mb-2"><code>navigation="none"</code> keeps the same page caller without emitting a Sidebar.</p>
            <p class="mb-2"><code>variant="sidebar"</code>, <code>variant="floating"</code>, and <code>variant="inset"</code> delegate to the existing Sidebar component.</p>
            <p class="mb-0"><code>side="left"</code> and <code>side="right"</code> preserve the Sidebar component's logical placement rules.</p>
          </div>
        </div>
      </section>

      {% set app_none_example %}
        {% call(slot) app(navigation="none") %}
          {% if slot == "page" %}
            {% call(region) page(width="fluid") %}
              {% if region == "main" %}
                {% call card() %}A page without navigation{% endcall %}
              {% endif %}
            {% endcall %}
          {% endif %}
        {% endcall %}
      {% endset %}
      {{ render_block_example(
        "app-none",
        "Page without navigation",
        "The same app contract can render a page-only shell when the route does not need navigation.",
        app_none_example,
        preview_class="moo-example__preview--shell",
        frame_src=site_href("layouts/previews/app-none.html", root_path),
        frame_width=768,
        frame_height=540
      ) }}

      {{ render_section_page_pagination("app", site_pages, root_path) }}
    </article>

    {{ render_doc_toc([
      {"id": "app", "label": "App"},
      {"id": "app-contract", "label": "Navigation and Sidebar choices"}
    ]) }}
  </div>
{% endblock %}
