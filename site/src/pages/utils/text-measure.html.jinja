{% extends "layouts/catalog.html.jinja" %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/example.html.jinja" import render_example %}

{% block title %}Text Measure — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Text Measure",
    "Cap a block of running text at a readable line length."
  ) }}

  <div class="moo-component-examples">
    {% set readable_paragraph %}
      <p class="text-measure mb-0">Long lines tire the eye. Add <code>text-measure</code> to a paragraph or text block and its inline size stops at about 68 characters, no matter how wide the column around it grows.</p>
    {% endset %}
    {{ render_example(
      "readable-paragraph",
      "Readable paragraph",
      "Use <code>text-measure</code> on running text in any typography profile. The website profile does not cap every paragraph, because cards, columns and tables already set their own width. The limit comes from the <code>$moo-text-measure</code> Sass knob and is scoped to a Moo UI owner.",
      readable_paragraph
    ) }}
  </div>
{% endblock %}
