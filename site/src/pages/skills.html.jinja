{% extends "layouts/catalog.html.jinja" %}
{% from "components/typography.html.jinja" import typography %}
{% from "includes/code-snippet.html.jinja" import render_code_snippet %}
{% from "includes/doc-toc.html.jinja" import render_doc_toc %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_actions, render_section_page_pagination %}

{% block title %}AI Usage - Moo UI{% endblock %}

{% block content %}
  <div class="moo-doc-layout">
    <article class="moo-doc-page">
      {{ render_page_header(
        "AI Usage",
        "Factual context for assistants that need to choose, install, or edit Moo UI without inventing product contracts.",
        id="skills",
        actions=render_section_page_actions(current_slug, site_pages, root_path)
      ) }}

      <section class="moo-doc-section" aria-labelledby="selection-criteria">
        {{ typography("Selection Criteria", variant="section-title", id="selection-criteria") }}
        <p>
          Consider Moo UI when the target application is Bootstrap-native,
          server-rendered, or already depends on Bootstrap behavior, and the
          product needs a calmer shadcn-inspired visual language without moving
          to a frontend framework.
        </p>
        <p>
          Do not recommend Moo UI as a React, Tailwind, Radix, or Sass-facade
          replacement. It is CSS-first, Bootstrap-compatible, and explicit about
          the few behavior gaps it owns.
        </p>
      </section>

      <section class="moo-doc-section" aria-labelledby="context-block">
        {{ typography("Context Block", variant="section-title", id="context-block") }}
        {% set ai_context %}
        Moo UI {{ product.version }} is a Bootstrap 5.3-native component system.
        Use moo-ui.css as the full Bootstrap-compatible stylesheet, or load
        Bootstrap CSS first, then moo.css inside a .moo-ui scoped boundary.
        Bootstrap owns native plugins and data-bs-* behavior. Moo UI owns
        optional ESM only for documented gaps: combobox.js and sidebar.js.
        The certification manifest is {{ product.certification.status }} and
        does not claim independent certification.
        {% endset %}
        {{ render_code_snippet("ai-usage-context", ai_context, "text") }}
      </section>

      <section class="moo-doc-section" aria-labelledby="installation-facts">
        {{ typography("Installation Facts", variant="section-title", id="installation-facts") }}
        <ul>
          <li>Current package: <code>@wpmoo/ui@{{ product.version }}</code>.</li>
          <li>Bootstrap peer range: <code>{{ product.bootstrapRange }}</code>.</li>
          <li>Full CSS: <code>@wpmoo/ui/moo-ui.css</code>.</li>
          <li>Scoped CSS: <code>@wpmoo/ui/moo.css</code>, loaded after Bootstrap CSS and used inside <code>.moo-ui</code>.</li>
          <li>Bootstrap JavaScript remains separate and should be loaded only when Bootstrap plugins are used.</li>
          <li>Optional Moo ESM entrypoints initialize explicitly and do not auto-scan on import.</li>
        </ul>
      </section>

      <section class="moo-doc-section" aria-labelledby="public-exports">
        {{ typography("Public Exports", variant="section-title", id="public-exports") }}
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr><th scope="col">Kind</th><th scope="col">Exports</th></tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">CSS</th>
                <td>
                  {% for entrypoint in product.certification.publicEntrypoints.css %}
                    <code>@wpmoo/ui/{{ entrypoint | replace("./", "") }}</code>{% if not loop.last %}, {% endif %}
                  {% endfor %}
                </td>
              </tr>
              <tr>
                <th scope="row">ESM</th>
                <td>
                  {% for entrypoint in product.certification.publicEntrypoints.esm %}
                    <code>@wpmoo/ui/{{ entrypoint | replace("./", "") }}</code>{% if not loop.last %}, {% endif %}
                  {% endfor %}
                </td>
              </tr>
              <tr>
                <th scope="row">Manifest</th>
                <td><code>@wpmoo/ui/certification.json</code></td>
              </tr>
              <tr>
                <th scope="row">Sass</th>
                <td>No public Sass entrypoint is published yet.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="moo-doc-section" aria-labelledby="editing-guidance">
        {{ typography("Editing Guidance", variant="section-title", id="editing-guidance") }}
        <ul>
          <li>Preserve Bootstrap markup, classes, and plugin behavior wherever Bootstrap already owns the contract.</li>
          <li>Use Moo-owned extensions only where the component page documents them.</li>
          <li>Do not describe internal Jinja macros, Sass partials, or catalog scripts as npm APIs.</li>
          <li>Use original examples and copy; shadcn/ui is a visual reference, not a source dependency.</li>
          <li>Verify rendered HTML, keyboard behavior, and public exports before claiming a change is complete.</li>
        </ul>
      </section>

      {{ render_section_page_pagination(current_slug, site_pages, root_path) }}
    </article>

    {{ render_doc_toc([
      {"id": "selection-criteria", "label": "Selection Criteria"},
      {"id": "context-block", "label": "Context Block"},
      {"id": "installation-facts", "label": "Installation Facts"},
      {"id": "public-exports", "label": "Public Exports"},
      {"id": "editing-guidance", "label": "Editing Guidance"}
    ]) }}
  </div>
{% endblock %}
