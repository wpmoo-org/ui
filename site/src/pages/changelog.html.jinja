{% extends "layouts/catalog.html.jinja" %}
{% from "includes/doc-toc.html.jinja" import render_doc_toc %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_actions, render_section_page_pagination %}

{% block title %}Changelog - Moo UI{% endblock %}

{% block content %}
  <div class="moo-doc-layout">
    <article class="moo-doc-page">
      {{ render_page_header(
        "Changelog",
        "Product-facing notes for the public Moo UI package and catalog.",
        id="changelog",
        actions=render_section_page_actions(current_slug, site_pages, root_path)
      ) }}

      <section class="moo-changelog" aria-label="Moo UI release history">
        <article class="moo-changelog__release" aria-labelledby="release-0-7-0">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v{{ product.version }}</span>
            <span class="text-body-secondary">Phase 2 evidence and public docs boundary</span>
          </div>
          <h2 id="release-0-7-0">Phase 2 Evidence and Public Docs Boundary</h2>
          <p>
            Expanded the evidence program across overlay and composite
            components while preserving the Core/Docs output boundary.
          </p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Added</span>
              <span>Phase 2 evidence for Tooltip, Popover, Toast, Sheet, Form, Alert Dialog, Menubar, and promoted Dialog, Sidebar, and Combobox evidence.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Updated</span>
              <span>Separated Core package outputs from site-only documentation and catalog assets.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Release</span>
              <span><a href="https://github.com/wpmoo-org/ui/releases/tag/v0.7.0">GitHub Release v0.7.0</a></span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="release-0-6-0">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.6.0</span>
            <span class="text-body-secondary">Phase 1 evidence backfill</span>
          </div>
          <h2 id="release-0-6-0">Phase 1 Evidence Backfill</h2>
          <p>
            Completed the T0/T1 certification backfill and Bootstrap 5.3
            compatibility lanes for the accepted Core surface.
          </p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Added</span>
              <span>Source-backed evidence for static, native-state, and Bootstrap Data API components.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Verified</span>
              <span>Bootstrap 5.3.0, 5.3.3, and latest 5.3.x compatibility lanes for the release gate.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Release</span>
              <span><a href="https://github.com/wpmoo-org/ui/releases/tag/v0.6.0">GitHub Release v0.6.0</a></span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="release-0-5-0">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.5.0</span>
            <span class="text-body-secondary">Optional public runtime modules</span>
          </div>
          <h2 id="release-0-5-0">Optional Public Runtime Modules</h2>
          <p>
            Published side-effect-free public ESM entrypoints for the Bootstrap
            gaps Moo UI owns.
          </p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Added</span>
              <span><code>@wpmoo/ui/combobox.js</code> and <code>@wpmoo/ui/sidebar.js</code> with explicit initialization and disposal lifecycle.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Updated</span>
              <span>Catalog JavaScript consumes the same public modules instead of private duplicates.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Release</span>
              <span><a href="https://github.com/wpmoo-org/ui/releases/tag/v0.5.0">GitHub Release v0.5.0</a></span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="release-0-4-0">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.4.0</span>
            <span class="text-body-secondary">Core package expansion</span>
          </div>
          <h2 id="release-0-4-0">Core Package Expansion</h2>
          <p>
            Moved the package toward a supportable Core surface with a broader
            component catalog and package manifest.
          </p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Added</span>
              <span>Complete scoped and full CSS outputs plus the package certification manifest.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Release</span>
              <span><a href="https://github.com/wpmoo-org/ui/releases/tag/v0.4.0">GitHub Release v0.4.0</a></span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="layout-and-polish-fixes">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.3.1</span>
            <span class="text-body-secondary">Layout and polish fixes</span>
          </div>
          <h2 id="layout-and-polish-fixes">Layout and Polish Fixes</h2>
          <p>Consistent page layout across all page types and clearer disabled states for page navigation.</p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Fixed</span>
              <span>Page action bar (Copy Link and navigation arrows) now aligns to the right edge on component, block, and utility detail pages, matching index and documentation pages.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Fixed</span>
              <span>Content width is now consistent across all page types, eliminating layout jumps when navigating between documentation and component pages.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Fixed</span>
              <span>Disabled navigation arrows now use a muted color that clearly reads as inactive.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Fixed</span>
              <span>Added breathing room between the Bootstrap documentation reference and the bottom pagination bar.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Updated</span>
              <span>README quickstart CDN link now floats <code>@latest</code> so it never goes stale.</span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="metadata-driven-docs">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.3.0</span>
            <span class="text-body-secondary">Metadata-driven docs navigation</span>
          </div>
          <h2 id="metadata-driven-docs">Metadata-Driven Docs Navigation</h2>
          <p>Converted the documentation flow to a registry-based metadata system integrated with page navigation, link generation, and SEO/LLM-oriented outputs.</p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Updated</span>
              <span>Component, utility, and block pages now derive titles, descriptions, and navigation ordering from metadata sources under <code>src/registry/</code> and <code>site/src/registry/</code>.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Updated</span>
              <span><code>llms.txt</code> generation and <code>sitemap.xml</code> are now connected to the metadata pipeline.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Added</span>
              <span>A license page and improved consistency in external link handling and institutional references.</span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="documentation-navigation">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.2.1</span>
            <span class="text-body-secondary">Documentation navigation</span>
          </div>
          <h2 id="documentation-navigation">Documentation Navigation</h2>
          <p>Added page-level copy, AI handoff, and previous/next navigation across the public documentation.</p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Updated</span>
              <span>Section landing pages now share the same narrow documentation layout, TOC rhythm, and release-aware install links.</span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="wave-4-components">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.2.0</span>
            <span class="text-body-secondary">Component catalog expansion</span>
          </div>
          <h2 id="wave-4-components">Wave 4 Components</h2>
          <p>Expanded the Bootstrap-native catalog with polished component examples, shared RTL previews, and refreshed overlay behavior.</p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Added</span>
              <span>New and refined examples for the Wave 4 component set, including tables, toggle groups, menus, overlays, and form controls.</span>
            </div>
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Updated</span>
              <span>RTL examples now use a shared tabbed preview pattern across component pages.</span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="catalog-polish">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.1.1</span>
            <span class="text-body-secondary">Public package refresh</span>
          </div>
          <h2 id="catalog-polish">Catalog Polish</h2>
          <p>Refined the public catalog, homepage, and package metadata for the npm release.</p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Updated</span>
              <span>Homepage, documentation pages, and npm package metadata.</span>
            </div>
          </div>
        </article>

        <article class="moo-changelog__release" aria-labelledby="initial-release">
          <div class="moo-changelog__release-heading">
            <span class="badge text-bg-dark">v0.1.0</span>
            <span class="text-body-secondary">Initial public package</span>
          </div>
          <h2 id="initial-release">Initial Release</h2>
          <p>First public release of Moo UI.</p>

          <div class="moo-changelog__changes">
            <div class="moo-changelog__change-row">
              <span class="moo-changelog__change-label">Added</span>
              <span>Initial Release</span>
            </div>
          </div>
        </article>
      </section>

      {{ render_section_page_pagination(current_slug, site_pages, root_path) }}
    </article>

    {{ render_doc_toc([
      {"id": "release-0-7-0", "label": "v0.7.0"},
      {"id": "release-0-6-0", "label": "v0.6.0"},
      {"id": "release-0-5-0", "label": "v0.5.0"},
      {"id": "release-0-4-0", "label": "v0.4.0"},
      {"id": "metadata-driven-docs", "label": "Metadata-Driven Docs Navigation"},
      {"id": "documentation-navigation", "label": "Documentation Navigation"},
      {"id": "wave-4-components", "label": "Wave 4 Components"},
      {"id": "catalog-polish", "label": "Catalog Polish"},
      {"id": "initial-release", "label": "Initial Release"}
    ]) }}
  </div>
{% endblock %}
