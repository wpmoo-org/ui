{% extends "layouts/catalog.html.jinja" %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_actions, render_section_page_pagination %}
{% from "components/badge.html.jinja" import badge %}
{% from "components/button.html.jinja" import button %}
{% from "components/card.html.jinja" import card %}
{% from "components/typography.html.jinja" import typography %}

{% block title %}Changelog - Moo UI{% endblock %}

{% block content %}
  {% set release_id = "release-" ~ product.version | replace(".", "-") %}
  <article class="moo-doc-page py-5">
    {{ render_page_header(
      "Changelog",
      "Product updates and release notes for Moo UI.",
      id="changelog",
      actions=render_section_page_actions(current_slug, site_pages, root_path)
    ) }}

    <article aria-labelledby="{{ release_id }}">
      {% call card(body_class="d-flex flex-column gap-4") %}
        <header class="d-flex flex-column gap-3">
          <div class="d-flex flex-wrap align-items-center gap-3 small text-body-secondary">
            {{ badge("v" ~ product.version, variant="dark") }}
            <span>Minor release</span>
          </div>
          {{ typography("Moo UI " ~ product.version, variant="section-title", id=release_id, extra_class="mb-0") }}
          <p class="text-body-secondary mb-0">
            Host-translated password feedback, heading weight per theme owner,
            and document scrolling for website shells.
          </p>
        </header>

        <section aria-labelledby="{{ release_id }}-added">
          {{ typography("Added", variant="subsection-title", id=release_id ~ "-added", extra_class="mb-3") }}
          <ul class="mb-0 ps-4">
            <li>
              <a href="{{ site_href("components/field.html", root_path) }}#password-feedback-preview">Password requirements</a>
              accepts an optional <code>options.messages</code> map for host-translated
              rule, summary and analysis feedback.
            </li>
            <li>
              Set <code>--moo-heading-font-weight</code> on a resolved theme owner.
              Its default is 600 and can be set in Sass with <code>$moo-heading-font-weight</code>.
            </li>
            <li>
              Website shells can use <code>data-shell-mode="document"</code> with
              <code>navigation="none"</code>. The document scrolls and the footer
              follows the content, meeting the viewport bottom on short pages.
            </li>
            <li>
              The Layout catalog shows the Document shell with a live preview,
              a standalone example and copyable markup.
            </li>
          </ul>
        </section>

        <p class="small text-body-secondary mb-0">
          Additive to the public 2.0.0 package API. Component certification
          remains in preview.
        </p>
      {% endcall %}
    </article>

    <section class="d-flex flex-column gap-3" aria-labelledby="previous-releases">
      {{ typography("Previous releases", variant="example-title", id="previous-releases", extra_class="mb-0") }}
      <p class="text-body-secondary mb-0">
        Browse earlier versions, complete release notes, and release downloads on GitHub.
      </p>
      {{ button(
        "View all releases on GitHub",
        variant="outline",
        element="a",
        href="https://github.com/wpmoo-org/ui/releases",
        icon_end="arrow-up-right",
        extra_class="align-self-start"
      ) }}
    </section>

    {{ render_section_page_pagination(current_slug, site_pages, root_path) }}
  </article>
{% endblock %}
