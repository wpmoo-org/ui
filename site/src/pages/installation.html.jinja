{% extends "layouts/catalog.html.jinja" %}
{% from "components/alert.html.jinja" import alert %}
{% from "components/typography.html.jinja" import typography %}
{% from "includes/code-snippet.html.jinja" import render_code_snippet %}
{% from "includes/doc-toc.html.jinja" import render_doc_toc %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_actions, render_section_page_pagination %}

{% block title %}Installation - Moo UI{% endblock %}

{% block content %}
  <div class="moo-doc-layout">
    <article class="moo-doc-page">
      {{ render_page_header(
        "Installation",
        "Choose a complete Bootstrap build or add Moo UI gradually to an existing Bootstrap 5.3 application.",
        id="installation",
        actions=render_section_page_actions(current_slug, site_pages, root_path)
      ) }}

      {{ alert(
        "CSS-first, not JavaScript-free",
        "Bootstrap owns its native plugins. Moo UI adds optional, explicitly initialized ESM only for Combobox and Sidebar.",
        icon="info",
        extra_class="moo-doc-callout"
      ) }}

      <section class="moo-doc-section" aria-labelledby="choose-path">
        {{ typography("Choose This Path", variant="section-title", id="choose-path") }}
        <div class="table-responsive">
          <table class="table align-middle">
            <thead><tr><th scope="col">Situation</th><th scope="col">Load</th></tr></thead>
            <tbody>
              <tr><td>New page or whole application</td><td><code>moo-ui.css</code> instead of Bootstrap CSS.</td></tr>
              <tr><td>Gradual migration in an existing Bootstrap app</td><td>Bootstrap CSS, then <code>moo.css</code>, with a <code>.moo-ui</code> boundary.</td></tr>
              <tr><td>Static page without interactive plugins</td><td>CSS only.</td></tr>
              <tr><td>Bootstrap Dropdown, Modal, Offcanvas, Tooltip, Popover, or Toast</td><td>Keep Bootstrap's JavaScript bundle and documented initialization.</td></tr>
              <tr><td>Combobox or Sidebar</td><td>Add only the corresponding optional Moo UI ESM module.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="moo-doc-section" aria-labelledby="full-build">
        {{ typography("Full Build", variant="section-title", id="full-build") }}
        <p>
          <code>moo-ui.css</code> is a complete Bootstrap CSS build with Moo UI
          defaults. Do not load another Bootstrap stylesheet beside it.
        </p>
        {% set full_cdn_example %}
        <link rel="stylesheet" href="https://unpkg.com/@wpmoo/ui@{{ product.version }}/dist/assets/css/moo-ui.css">

        <button type="button" class="btn btn-primary">Create workspace</button>
        {% endset %}
        {{ render_code_snippet("installation-full-cdn", full_cdn_example, "html") }}

        {% set npm_install_example %}
        npm install @wpmoo/ui bootstrap
        {% endset %}
        {{ render_code_snippet("installation-npm", npm_install_example, "shell") }}

        {% set full_import_example %}
        import "@wpmoo/ui/moo-ui.css";
        {% endset %}
        {{ render_code_snippet("installation-full-import", full_import_example, "js") }}
      </section>

      <section class="moo-doc-section" aria-labelledby="scoped-build">
        {{ typography("Scoped Gradual Adoption", variant="section-title", id="scoped-build") }}
        <p>
          In an existing Bootstrap app, keep Bootstrap CSS first, load the
          scoped Moo UI component layer second, and wrap only migrated regions in
          <code>.moo-ui</code>.
        </p>
        {% set scoped_cdn_example %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@{{ product.certification.bootstrap.canonicalVersion }}/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="https://unpkg.com/@wpmoo/ui@{{ product.version }}/dist/assets/css/moo.css">

        <div class="moo-ui">
          <button type="button" class="btn btn-primary">Create workspace</button>
        </div>
        {% endset %}
        {{ render_code_snippet("installation-scoped-cdn", scoped_cdn_example, "html") }}

        {% set scoped_import_example %}
        import "bootstrap/dist/css/bootstrap.min.css";
        import "@wpmoo/ui/moo.css";
        {% endset %}
        {{ render_code_snippet("installation-scoped-import", scoped_import_example, "js") }}
      </section>

      <section class="moo-doc-section" aria-labelledby="bootstrap-javascript">
        {{ typography("Bootstrap JavaScript", variant="section-title", id="bootstrap-javascript") }}
        <p>
          Moo UI does not replace or automatically initialize Bootstrap
          plugins. Load Bootstrap's bundle when your page uses plugin-owned
          behavior; Tooltip and Popover still require Bootstrap's documented
          opt-in initialization.
        </p>
        {% set bootstrap_js_cdn_example %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@{{ product.certification.bootstrap.canonicalVersion }}/dist/js/bootstrap.bundle.min.js"></script>
        {% endset %}
        {{ render_code_snippet("installation-bootstrap-js-cdn", bootstrap_js_cdn_example, "html") }}

        {% set bootstrap_js_example %}
        import "bootstrap/dist/js/bootstrap.bundle.min.js";
        {% endset %}
        {{ render_code_snippet("installation-bootstrap-js", bootstrap_js_example, "js") }}
      </section>

      <section class="moo-doc-section" aria-labelledby="optional-esm">
        {{ typography("Optional Moo UI ESM", variant="section-title", id="optional-esm") }}
        <p>
          Combobox, Context Menu, DataTable, and Sidebar cover behavior gaps
          Bootstrap does not provide. Their modules are side-effect-free:
          importing them does not scan the document. Create instances
          explicitly and dispose them when your host removes the corresponding
          UI.
        </p>
        {% set esm_example %}
        import Combobox from "@wpmoo/ui/combobox.js";
        import ContextMenu from "@wpmoo/ui/context-menu.js";
        import DataTable from "@wpmoo/ui/datatable.js";
        import Sidebar from "@wpmoo/ui/sidebar.js";

        const combobox = Combobox.getOrCreateInstance(
          document.querySelector(".combobox")
        );
        const contextMenu = ContextMenu.getOrCreateInstance(
          document.querySelector(".context-menu")
        );
        const datatable = DataTable.getOrCreateInstance(
          document.querySelector(".datatable")
        );
        const sidebar = Sidebar.getOrCreateInstance(
          document.querySelector('[data-slot="sidebar-wrapper"]')
        );

        // Later, when the host removes the UI:
        combobox.dispose();
        contextMenu.dispose();
        datatable.dispose();
        sidebar.dispose();
        {% endset %}
        {{ render_code_snippet("installation-esm", esm_example, "js") }}
        {% set esm_cdn_example %}
        <script type="module">
          import Combobox from "https://cdn.jsdelivr.net/npm/@wpmoo/ui@{{ product.version }}/{{ product.exports["./combobox.js"] | replace("./", "") }}";
          import ContextMenu from "https://cdn.jsdelivr.net/npm/@wpmoo/ui@{{ product.version }}/{{ product.exports["./context-menu.js"] | replace("./", "") }}";
          import DataTable from "https://cdn.jsdelivr.net/npm/@wpmoo/ui@{{ product.version }}/{{ product.exports["./datatable.js"] | replace("./", "") }}";
          import Sidebar from "https://cdn.jsdelivr.net/npm/@wpmoo/ui@{{ product.version }}/{{ product.exports["./sidebar.js"] | replace("./", "") }}";

          const comboboxRoot = document.querySelector(".combobox");
          if (comboboxRoot) {
            Combobox.getOrCreateInstance(comboboxRoot);
          }

          const contextMenuRoot = document.querySelector(".context-menu");
          if (contextMenuRoot) {
            ContextMenu.getOrCreateInstance(contextMenuRoot);
          }

          const datatableRoot = document.querySelector(".datatable");
          if (datatableRoot) {
            DataTable.getOrCreateInstance(datatableRoot);
          }

          const sidebarRoot = document.querySelector('[data-slot="sidebar-wrapper"]');
          if (sidebarRoot) {
            Sidebar.getOrCreateInstance(sidebarRoot);
          }
        </script>
        {% endset %}
        {{ render_code_snippet("installation-esm-cdn", esm_cdn_example, "html") }}
        <p>
          Review the <a href="{{ site_href('components/combobox.html', root_path) }}">Combobox</a>,
          <a href="{{ site_href('components/context-menu.html', root_path) }}">Context Menu</a>,
          <a href="{{ site_href('components/datatable.html', root_path) }}">Data Table</a>,
          and <a href="{{ site_href('components/sidebar.html', root_path) }}">Sidebar</a>
          pages for their HTML, selectors, lifecycle, and Bootstrap ownership.
        </p>
      </section>

      <section class="moo-doc-section" aria-labelledby="troubleshooting">
        {{ typography("Troubleshooting", variant="section-title", id="troubleshooting") }}
        <dl>
          <dt>Styles look duplicated or inconsistent</dt>
          <dd>Use either the full <code>moo-ui.css</code> build or Bootstrap CSS followed by scoped <code>moo.css</code>; do not combine both Moo UI stylesheets.</dd>
          <dt>Scoped styles do not appear</dt>
          <dd>Confirm <code>moo.css</code> loads after Bootstrap CSS and the migrated markup has a <code>.moo-ui</code> ancestor.</dd>
          <dt>A Bootstrap control does not open</dt>
          <dd>Load Bootstrap's bundle and follow that plugin's documented initialization requirements.</dd>
          <dt>A Moo UI ESM module does not respond</dt>
          <dd>Import the matching Moo UI ESM module (Combobox, Context Menu, DataTable, or Sidebar) and initialize the rendered root explicitly; imports never auto-scan.</dd>
        </dl>
      </section>

      {{ render_section_page_pagination(current_slug, site_pages, root_path) }}
    </article>

    {{ render_doc_toc([
      {"id": "choose-path", "label": "Choose This Path"},
      {"id": "full-build", "label": "Full Build"},
      {"id": "scoped-build", "label": "Scoped Adoption"},
      {"id": "bootstrap-javascript", "label": "Bootstrap JavaScript"},
      {"id": "optional-esm", "label": "Optional Moo UI ESM"},
      {"id": "troubleshooting", "label": "Troubleshooting"}
    ]) }}
  </div>
{% endblock %}
