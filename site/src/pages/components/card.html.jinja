{% extends "layouts/catalog.html.jinja" %}
{% from "components/badge.html.jinja" import badge %}
{% from "components/button.html.jinja" import button %}
{% from "components/card.html.jinja" import card, floating_panel %}
{% from "components/collapsible.html.jinja" import collapsible %}
{% from "components/progress.html.jinja" import progress %}
{% from "components/field.html.jinja" import field, field_group %}
{% from "components/input.html.jinja" import input %}
{% from "components/navigation.html.jinja" import nav_menu, nav_item %}
{% from "components/toggle_group.html.jinja" import toggle_group %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_example, render_rtl_example with context %}

{% block title %}Card — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Card",
    "Display a structured surface with a header, body, and optional footer."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      {% call card(
        "Login to your account",
        "Enter your email below to login to your account.",
        footer=button("Login", extra_class="w-100")
      ) %}
        <div class="d-grid gap-2">
          {{ input(label="Email", id="card-intro-email", type="email", placeholder="you@example.com") }}
          {{ input(label="Password", id="card-intro-password", type="password") }}
        </div>
      {% endcall %}
    {% endset %}
    {% set card_usage %}
      <p>Use <code>.card</code> as a flexible content container for one object, setting, summary, or workflow step. Bootstrap cards are built with minimal markup, use flexbox, have no default margin, and fill the width of their parent unless you constrain them with grid, width utilities, or local layout rules.</p>
      <p>Place padded primary content in <code>.card-body</code>, use <code>.card-title</code> and <code>.card-subtitle</code> for the object heading and secondary label, and keep longer copy in <code>.card-text</code>. Use <code>.card-header</code> and <code>.card-footer</code> only when those regions add clear structure rather than decorative framing.</p>
      <p>Cards can contain images, list groups, links, and actions, but the card should still describe one thing. Use <code>.card-img-top</code> or <code>.card-img-bottom</code> for media attached to the card edge, keep action buttons close to the content they affect, and use external spacing utilities between cards instead of adding unrelated margin inside the card.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      card_usage,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set size_sm %}
      {% call card(
        "Scheduled reports",
        "Weekly snapshots. No more manual exports.",
        size="sm",
        footer=button("Set up scheduled reports", icon_end="arrow-right", extra_class="w-100") ~ button("See what's new", variant="secondary", icon_end="arrow-right", extra_class="w-100"),
        footer_class="flex-column gap-2"
      ) %}
        <ul class="moo-card-list">
          <li><span class="moo-card-list__icon">{{ render_icon("chevron-right", "") }}</span>Choose a schedule (daily, or weekly).</li>
          <li><span class="moo-card-list__icon">{{ render_icon("chevron-right", "") }}</span>Send to channels or specific teammates.</li>
          <li><span class="moo-card-list__icon">{{ render_icon("chevron-right", "") }}</span>Include charts, tables, and key metrics.</li>
        </ul>
      {% endcall %}
    {% endset %}
    {{ render_component_example("card", "Card",
      "size",
      "Size",
      "Use <code>size=\"sm\"</code> to tighten the card rhythm for compact surfaces. Sections and the inline inset share one spacing token.",
      size_sm,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set panel_trigger %}
        {{ button("Open preparation panel", variant="outline", floating_panel_open="card-preparation-panel") }}
    {% endset %}
    {% set panel_content %}
        {% set panel_summary %}
            <div class="d-flex align-items-center gap-2">
                {{ progress(2, max=5, aria_label="Getting started progress", variant="circle") }}
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h3 class="h6 mb-0">Get started</h3>
                        {{ badge("Demo", variant="secondary") }}
                    </div>
                    <span class="small text-body-secondary">2 of 5 complete</span>
                </div>
            </div>
        {% endset %}
        {% set panel_steps %}
            {% call nav_menu("Getting started tasks", vertical=true) %}
                {{ nav_item("Install Moo UI", disabled=true, icon="circle-check", completed=true,
                    extra_class="text-decoration-line-through text-body-secondary") }}
                {{ nav_item("Add the checklist widget", disabled=true, icon="circle-check", completed=true,
                    extra_class="text-decoration-line-through text-body-secondary") }}
                {{ nav_item("Set your 3–5 tasks", disabled=true, icon="circle",
                    extra_class="bg-body-tertiary") }}
                {{ nav_item("Connect to your db", disabled=true, icon="circle") }}
                {{ nav_item("Drop it in your dashboard", disabled=true, icon="circle") }}
            {% endcall %}
        {% endset %}
        {% set panel_footer %}
            <p class="small text-body-secondary mb-0">Example tasks only — no setup actions are connected. Dismissal is saved in this browser; reopen the widget using “Open preparation panel”.</p>
            {{ button("Dismiss forever", variant="ghost", size="sm", extra_class="w-100 text-body-secondary",
                floating_panel_dismiss="card-preparation-panel") }}
        {% endset %}
        {% call floating_panel("card-preparation-panel", "Get started", storage_key="catalog-card-preparation") %}
            {% call card(size="sm", footer=panel_footer, footer_class="flex-column align-items-stretch gap-2 bg-body-tertiary") %}
                {{ collapsible("card-preparation-steps", "Preparation steps", panel_steps,
                    header_content=panel_summary, content_class="border-0 p-0", open=true,
                    trigger_aria_label="Toggle preparation steps") }}
            {% endcall %}
        {% endcall %}
    {% endset %}
    {% set panel_source %}
        {{ panel_trigger }}
        {{ panel_content }}
        <script type="module">
            import FloatingPanel from "@wpmoo/ui/floating-panel.js";

            const panel = FloatingPanel.getOrCreateInstance(
                document.getElementById("card-preparation-panel"),
            );
            // Call panel.dispose() when your application releases this surface.
        </script>
    {% endset %}
    {{ render_example(
        "card-floating-panel", "Floating panel",
        "Compose a non-modal, viewport-fixed onboarding Card using <code>data-floating-panel</code>. This demo shows two completed tasks out of five. Task rows are non-interactive examples: they do not navigate or change application data. The working controls collapse the list, dismiss the widget, or reopen it here. The demo remembers dismissal in this browser across reloads; applications own task state and should provide their own account-and-surface-specific <code>data-floating-panel-key</code>. Initialize the public ESM module explicitly, using a bundler or import map for the package import shown below. No backdrop or page scroll lock is added.",
        panel_trigger,
        portal_content=panel_content,
        source_content=panel_source,
        toolbar_label="Card",
        toolbar_icon="panel-bottom"
    ) }}

    {% set spacing_login %}
      <div data-card-spacing>
        {{ toggle_group(
          name="card-spacing",
          legend="Card spacing",
          items=[
            {"id": "card-spacing-16", "label": "16px", "value": "16px", "pressed": true},
            {"id": "card-spacing-20", "label": "20px", "value": "20px"},
            {"id": "card-spacing-24", "label": "24px", "value": "24px"},
            {"id": "card-spacing-32", "label": "32px", "value": "32px"}
          ],
          extra_class="mb-3"
        ) }}
        {% call card(
          "Login to your account",
          "Enter your email below to login to your account.",
          action=button("Sign up", variant="ghost"),
          footer=button("Login", extra_class="w-100") ~ button("Login with Google", variant="secondary", icon_start="chrome", extra_class="w-100"),
          footer_class="flex-column gap-2",
          extra_class="card-spacing-demo"
        ) %}
            {% call field_group() %}
              {% call field() %}
                {{ input(label="Email", id="card-email", type="email", placeholder="you@example.com") }}
              {% endcall %}
              {% call field() %}
                {{ input(label="Password", id="card-password", type="password", label_extra='<a href="#" class="text-decoration-none">Forgot your password?</a>') }}
              {% endcall %}
            {% endcall %}
        {% endcall %}
      </div>
    {% endset %}
    {{ render_component_example("card", "Card",
      "spacing",
      "Spacing",
      "The card exposes <code>--moo-card-spacing</code> so a consumer can retune the section gap and part inset in one place.",
      spacing_login,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set spacing_tos %}
      {% call card(
        "Terms of Service",
        "Review the terms before accepting the agreement.",
        footer=button("Decline", variant="secondary") ~ button("Accept"),
        footer_class="justify-content-end gap-2"
      ) %}
        <div class="card-scroll">
          <p class="mb-0">These terms govern your use of the workspace, including access to shared documents, project files, and collaboration tools.</p>
          <p class="mb-0">You are responsible for the content you upload and for ensuring that your team has the appropriate permissions to view or edit it.</p>
          <p class="mb-0">We may update features or limits as the service evolves. When those changes materially affect your workflow, we will notify your workspace administrators.</p>
          <p class="mb-0">By continuing, you agree to keep your account credentials secure and to follow your organization's acceptable use policies.</p>
        </div>
      {% endcall %}
    {% endset %}
    {{ render_component_example("card", "Card",
      "spacing-edge-to-edge",
      "Scrollable",
      "Scroll long body content inside a <code>card-scroll</code> strip that bleeds to the card edges. Above a footer, the strip sits flush against the divider.",
      spacing_tos,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set image_card %}
      {% call card(
        "Design systems meetup",
        "A practical talk on component APIs, accessibility, and shipping faster.",
        action=badge("Featured", variant="secondary"),
        image={
          "src": root_path ~ "assets/images/placeholder.webp",
          "alt": "Design systems meetup illustration"
        },
        footer=button("View event", icon_end="arrow-right")
      ) %}
        <p class="mb-0">A practical talk on component APIs, accessibility, and shipping faster.</p>
      {% endcall %}
    {% endset %}
    {{ render_component_example("card", "Card",
      "image",
      "Image",
      "Add an image before the card header to create a featured card. The image clips to the card's top corners.",
      image_card,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set rtl_arabic %}
      <div dir="rtl">
        {% call card(
          "تسجيل الدخول إلى حسابك",
          "أدخل بريدك الإلكتروني أدناه لتسجيل الدخول إلى حسابك.",
          action=button("إنشاء حساب", variant="ghost"),
          footer=button("تسجيل الدخول", extra_class="w-100") ~ button("تسجيل الدخول باستخدام Google", variant="secondary", extra_class="w-100"),
          footer_class="flex-column gap-2"
        ) %}
            {% call field_group() %}
              {% call field() %}
                {{ input(label="البريد الإلكتروني", id="card-rtl-ar-email", type="email", placeholder="you@example.com") }}
              {% endcall %}
              {% call field() %}
                {{ input(label="كلمة المرور", id="card-rtl-ar-password", type="password", label_extra='<a href="#" class="text-decoration-none">نسيت كلمة المرور؟</a>') }}
              {% endcall %}
            {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {% set rtl_hebrew %}
      <div dir="rtl">
        {% call card(
          "התחברות לחשבון שלך",
          "הזן את כתובת הדוא\"ל שלך להתחברות לחשבון שלך.",
          action=button("יצירת חשבון", variant="ghost"),
          footer=button("התחברות", extra_class="w-100") ~ button("התחברות עם Google", variant="secondary", extra_class="w-100"),
          footer_class="flex-column gap-2"
        ) %}
            {% call field_group() %}
              {% call field() %}
                {{ input(label="דוא\"ל", id="card-rtl-he-email", type="email", placeholder="you@example.com") }}
              {% endcall %}
              {% call field() %}
                {{ input(label="סיסמה", id="card-rtl-he-password", type="password", label_extra='<a href="#" class="text-decoration-none">שכחת את הסיסמה?</a>') }}
              {% endcall %}
            {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {% set rtl_english %}
      <div dir="ltr">
        {% call card(
          "Login to your account",
          "Enter your email below to login to your account.",
          action=button("Sign up", variant="ghost"),
          footer=button("Login", extra_class="w-100") ~ button("Login with Google", variant="secondary", extra_class="w-100"),
          footer_class="flex-column gap-2"
        ) %}
            {% call field_group() %}
              {% call field() %}
                {{ input(label="Email", id="card-rtl-en-email", type="email", placeholder="you@example.com") }}
              {% endcall %}
              {% call field() %}
                {{ input(label="Password", id="card-rtl-en-password", type="password", label_extra='<a href="#" class="text-decoration-none">Forgot your password?</a>') }}
              {% endcall %}
            {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "card-login",
      "Compare Arabic, Hebrew, and English login cards in an RTL shell.",
      rtl_arabic,
      rtl_hebrew,
      rtl_english,
      preview_class="moo-example__preview--narrow",
      title="RTL",
      title_id="card-rtl",
      example_prefix="rtl"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap-native card semantics and options, see the",
    "https://getbootstrap.com/docs/5.3/components/card/",
    "Bootstrap Card documentation"
  ) }}

{% endblock %}
