{% extends "layouts/catalog.html.jinja" %}
{% from "blocks/sidebar_shell.html.jinja" import render_sidebar_shell %}
{% from "components/table.html.jinja" import table %}
{% from "includes/block-example.html.jinja" import render_block_example %}
{% from "includes/code-snippet.html.jinja" import render_code_snippet %}
{% from "includes/documentation-reference.html.jinja" import render_reference %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Sidebar — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Sidebar",
    "Compose an application shell with Bootstrap-native sidebar primitives: provider, regions, menus, and inset content."
  ) }}

  <div class="moo-component-examples">
    <h2 id="usage" class="h4 mb-3">Usage</h2>
    <p class="mb-4">
      Render a <code>.sidebar-wrapper</code> with one <code>.sidebar</code>
      region and one <code>.sidebar-inset</code> content region. Bootstrap owns
      Offcanvas, Collapse, Dropdown, and Tooltip behavior; the optional Moo
      Sidebar ESM coordinates the responsive shell state Bootstrap does not
      provide.
    </p>

    {% set app_shell %}
      {{ render_sidebar_shell(
        key="components-sidebar-floating",
        sidebar_id="components-sidebar-floating-demo",
        variant="floating",
        demo_copy="portal"
      ) }}
    {% endset %}
    {{ render_block_example(
      "app-shell",
      "Application shell",
      "Compose the shell from documented sidebar regions. The preview uses the same floating sidebar block frame so the application shell is exercised as a standalone viewport.",
      app_shell,
      preview_class="moo-example__preview--shell",
      frame_src=site_href("blocks/previews/sidebar-floating.html", root_path)
    ) }}

    <h2 id="composition" class="h4 mt-5 mb-3">Composition</h2>
    <p class="mb-4">
      Sidebar parts compose public component contracts. Actions use Button and
      Dropdown Menu markup, metadata uses Badge, form fields use Input,
      separators use Separator, and loading rows use Skeleton.
    </p>

    <figure class="mb-5">
      <img
        class="img-fluid rounded border bg-white"
        src="{{ root_path }}assets/images/sidebar-structure.webp"
        alt="Diagram showing the sidebar wrapper around header, content, footer, and inset regions."
      >
    </figure>

    <h2 id="sidebar-html-anatomy" class="h4 mt-5 mb-3">HTML Anatomy</h2>
    <p class="mb-4">
      These are the public HTML hooks that applications can inspect or target.
      They describe rendered markup, not the repository's internal Jinja build
      helpers.
    </p>

    {% set sidebar_parts = [
      {"id": "sidebar-wrapper", "selector": '<code>.sidebar-wrapper[data-slot="sidebar-wrapper"]</code>', "summary": "Wraps the shell and stores <code>data-moo-sidebar-state</code>."},
      {"id": "sidebar", "selector": '<code>.sidebar[data-slot="sidebar"]</code>', "summary": "Navigation region. It is also a Bootstrap <code>.offcanvas-lg</code> target on smaller viewports."},
      {"id": "sidebar-trigger", "selector": '<code>[data-moo-sidebar-trigger]</code>', "summary": "Button that toggles the target sidebar and mirrors <code>aria-expanded</code>."},
      {"id": "sidebar-rail", "selector": '<code>[data-moo-sidebar-rail]</code>', "summary": "Collapsed desktop rail hit target; hidden from normal tab order."},
      {"id": "sidebar-content", "selector": '<code>[data-slot="sidebar-content"]</code>', "summary": "Scrollable navigation content."},
      {"id": "sidebar-menu-button", "selector": '<code>[data-slot="sidebar-menu-button"]</code>', "summary": "Link, button, collapse trigger, or dropdown trigger row."},
      {"id": "sidebar-submenu", "selector": '<code>.sidebar-menu-sub.collapse</code>', "summary": "Bootstrap Collapse-backed nested list."},
      {"id": "sidebar-inset", "selector": '<code>.sidebar-inset</code>', "summary": "Page content surface next to the sidebar."}
    ] %}

    {% set sidebar_parts_rows = [] %}
    {% for part in sidebar_parts %}
      {% set _ = sidebar_parts_rows.append([part["selector"], part["summary"]]) %}
    {% endfor %}
    {{ table(
      ["Selector", "Purpose"],
      sidebar_parts_rows,
      row_ids=sidebar_parts | map(attribute="id") | list,
      row_header=true,
      extra_class="align-middle mb-5"
    ) }}

    {% set sidebar_aside_class = "sidebar offcanvas-lg offcanvas-start" %}
    {% set sidebar_markup_example %}
    <div class="sidebar-wrapper" data-slot="sidebar-wrapper" data-moo-sidebar-state="expanded">
      <aside id="workspace-sidebar" class="{{ sidebar_aside_class }}" tabindex="-1" data-slot="sidebar">
        <div class="sidebar-inner" data-slot="sidebar-inner">
          <div class="sidebar-content" data-slot="sidebar-content">
            <ul class="sidebar-menu" data-slot="sidebar-menu">
              <li class="sidebar-menu-item" data-slot="sidebar-menu-item">
                <a class="sidebar-menu-button active" href="/projects" data-slot="sidebar-menu-button" aria-current="page">
                  Projects
                </a>
              </li>
            </ul>
          </div>
        </div>
      </aside>

      <main class="sidebar-inset">...</main>
    </div>
    {% endset %}
    {{ render_code_snippet("sidebar-html-anatomy-example", sidebar_markup_example, "html") }}

    <h2 id="sidebar-javascript" class="h4 mt-5 mb-3">JavaScript</h2>
    <p>
      Bootstrap owns Dropdown, Collapse, Offcanvas, and Tooltip. Moo UI's
      optional Sidebar module coordinates the shell state Bootstrap does not
      provide: desktop collapse and persistence, the rail and keyboard shortcut,
      collapsed flyouts, RTL placement, and responsive tooltip ownership.
    </p>
    <p>
      Importing the module never scans the document. Initialize only a
      <code>[data-slot="sidebar-wrapper"]</code> root your application owns; repeated
      initialization returns the same instance, and <code>dispose()</code>
      releases listeners, generated flyouts, positioning, tooltips, and the
      mobile Offcanvas instance owned by Sidebar.
    </p>
    {% set sidebar_import_example %}
    import Sidebar from "@wpmoo/ui/sidebar.js";

    const element = document.querySelector('[data-slot="sidebar-wrapper"]');

    if (element) {
      const sidebar = Sidebar.getOrCreateInstance(element);

      // Later, release Sidebar-owned runtime resources.
      sidebar.dispose();
    }
    {% endset %}
    {{ render_code_snippet("sidebar-javascript-import", sidebar_import_example, "js") }}

    <h2 id="sidebar-state" class="h4 mt-5 mb-3">Sidebar State</h2>
    <p class="mb-0">
      Some design references call this state helper <strong>useSidebar</strong>.
      In Moo UI it is not a React hook. It is the rendered
      <code>data-moo-sidebar-state</code> attribute plus the public Sidebar
      instance that updates it.
    </p>
  </div>

  {{ render_reference(
    "The mobile drawer and collapse behavior build on Bootstrap's own Offcanvas and Collapse plugins; see the",
    "https://getbootstrap.com/docs/5.3/components/offcanvas/",
    "Bootstrap Offcanvas documentation"
  ) }}
  {{ render_reference(
    "For the nested collapse behavior, see the",
    "https://getbootstrap.com/docs/5.3/components/collapse/",
    "Bootstrap Collapse documentation"
  ) }}
{% endblock %}
