{% extends "layouts/catalog.html.jinja" %}
{% from "components/context_menu.html.jinja" import context_menu %}
{% from "components/dropdown_menu.html.jinja" import dropdown_item, dropdown_toggle_item, dropdown_header, dropdown_divider %}
{% from "components/card.html.jinja" import card %}
{% from "components/kbd.html.jinja" import kbd %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_example, render_rtl_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Context Menu — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Context Menu",
    "A right-click menu built on Bootstrap's documented dropdown-menu surface, with Moo owning only the pointer/keyboard invocation Bootstrap does not provide."
  ) }}

  <div class="moo-component-examples">
    {% set basic_items %}
      {{ dropdown_item("Rename", icon="pencil", shortcut="⌘R") }}
      {{ dropdown_item("Duplicate", icon="copy") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Delete", icon="trash-2", destructive=true) }}
    {% endset %}
    {% set basic %}
      {% call context_menu("context-menu-basic", "File actions", basic_items) %}
        {% call card(title="Quarterly report.pdf", subtitle="Right-click, or tab here and press Shift+F10") %}
          <p class="text-body-secondary mb-0">The corner button opens the same menu for touch and keyboard-only use.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "basic",
      "Basic",
      "Right-click the card, or focus it and press " ~ kbd("Shift") ~ "+" ~ kbd("F10") ~ " (or the " ~ kbd("ContextMenu") ~ " key). The corner button is the explicit fallback trigger for touch and keyboard-only use.",
      basic
    ) }}

    {% set shortcut_items %}
      {{ dropdown_item("New file", icon="file-plus", shortcut="⌘N") }}
      {{ dropdown_item("Rename", icon="pencil", shortcut="⌘R") }}
      {{ dropdown_item("Duplicate", icon="copy", shortcut="⌘D") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Archive", icon="archive", shortcut="⇧⌘A") }}
    {% endset %}
    {% set shortcuts %}
      {% call context_menu("context-menu-shortcuts", "Shortcut actions", shortcut_items) %}
        {% call card(title="Release notes.md", subtitle="Right-click to reveal shortcut hints") %}
          <p class="text-body-secondary mb-0">Shortcut text uses the same trailing slot as Dropdown Menu items.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "shortcuts",
      "Shortcuts",
      "Add compact shortcut text to the end of an item while preserving the Bootstrap dropdown-item structure.",
      shortcuts
    ) }}

    {% set group_items %}
      {{ dropdown_header("File") }}
      {{ dropdown_item("Open in editor", icon="external-link") }}
      {{ dropdown_item("Reveal in project", icon="folder-open") }}
      {{ dropdown_divider() }}
      {{ dropdown_header("Share") }}
      {{ dropdown_item("Copy public link", icon="link") }}
      {{ dropdown_item("Send for review", icon="send") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Move to archive", icon="archive") }}
    {% endset %}
    {% set groups %}
      {% call context_menu("context-menu-groups", "Grouped file actions", group_items) %}
        {% call card(title="Brand guidelines.fig", subtitle="Grouped actions use Bootstrap headers and dividers") %}
          <p class="text-body-secondary mb-0">Headers are semantic dropdown headers, not custom nested panels.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "groups",
      "Groups",
      "Group related actions with Bootstrap dropdown headers and dividers inside the same flat menu.",
      groups
    ) }}

    {% set icon_items %}
      {{ dropdown_item("Copy link", icon="link", icon_box=true) }}
      {{ dropdown_item("Download", icon="download", icon_box=true) }}
      {{ dropdown_item("Star file", icon="star", icon_box=true) }}
      {{ dropdown_divider() }}
      {{ dropdown_item("View details", icon="info", icon_box=true) }}
    {% endset %}
    {% set icons %}
      {% call context_menu("context-menu-icons", "Icon actions", icon_items) %}
        {% call card(title="Media pack.zip", subtitle="Icon affordances align with Dropdown Menu") %}
          <p class="text-body-secondary mb-0">Icon boxes keep dense menus scannable without changing the item contract.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "icons",
      "Icons",
      "Use the Dropdown Menu icon slot when actions need quick visual recognition.",
      icons
    ) }}

    {% set disabled_items %}
      {{ dropdown_item("Share", icon="share-2") }}
      {{ dropdown_item("Move to…", icon="folder-input") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Restore version", icon="history", disabled=true) }}
    {% endset %}
    {% set disabled %}
      {% call context_menu("context-menu-disabled", "Document actions", disabled_items) %}
        {% call card(title="Draft proposal.docx", subtitle="Restore version is disabled: no earlier version exists") %}
          <p class="text-body-secondary mb-0">Disabled items are skipped by keyboard roving focus and cannot be activated.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "disabled",
      "Disabled item",
      "A disabled item stays visible for context but cannot receive roving focus or be activated.",
      disabled
    ) }}

    {% set checkbox_items %}
      {{ dropdown_header("View") }}
      {{ dropdown_toggle_item("Show hidden files", pressed=true) }}
      {{ dropdown_toggle_item("Show file extensions") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Refresh", icon="refresh-cw") }}
    {% endset %}
    {% set checkbox %}
      {% call context_menu("context-menu-checkboxes", "Folder view options", checkbox_items) %}
        {% call card(title="Design assets", subtitle="Folder · 128 items") %}
          <p class="text-body-secondary mb-0">Toggle items keep the menu open, using Bootstrap's own button-toggle Data API.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "checkboxes",
      "Checkboxes",
      "Toggleable options use Bootstrap's button toggle Data API, so selecting one keeps the menu open instead of closing it.",
      checkbox
    ) }}

    {% set radio_items %}
      {{ dropdown_header("Sort by") }}
      {{ dropdown_toggle_item("Name", pressed=true, attrs='data-context-menu-radio-group="sort"') }}
      {{ dropdown_toggle_item("Date modified", attrs='data-context-menu-radio-group="sort"') }}
      {{ dropdown_toggle_item("Size", attrs='data-context-menu-radio-group="sort"') }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Refresh", icon="refresh-cw") }}
    {% endset %}
    {% set radio %}
      {% call context_menu("context-menu-radio", "Sort options", radio_items) %}
        {% call card(title="Screenshots", subtitle="Folder · 42 items") %}
          <p class="text-body-secondary mb-0">Single-select options stay real dropdown-item buttons, so arrow-key roving focus reaches every option.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "radio",
      "Radio",
      "Single-select options reuse the checkbox item's dropdown-item button so keyboard roving focus and Bootstrap's button-toggle Data API keep working; Moo adds only the mutual-exclusivity between grouped options.",
      radio
    ) }}

    {% set destructive_items %}
      {{ dropdown_item("Rename", icon="pencil") }}
      {{ dropdown_item("Duplicate", icon="copy") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Delete forever", icon="trash-2", destructive=true, shortcut="⌘⌫") }}
    {% endset %}
    {% set destructive %}
      {% call context_menu("context-menu-destructive", "Dangerous file actions", destructive_items) %}
        {% call card(title="Old backup.sql", subtitle="Destructive actions stay visually distinct") %}
          <p class="text-body-secondary mb-0">The danger item still uses a normal dropdown-item so focus, hover, and click behavior remain consistent.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "destructive",
      "Destructive",
      "Mark destructive actions with the shared danger text utility while keeping the menu item anatomy unchanged.",
      destructive
    ) }}

    {% set side_items %}
      {{ dropdown_item("Open") }}
      {{ dropdown_item("Copy path", icon="copy") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Inspect", icon="search") }}
    {% endset %}
    {% set sides %}
      {% call context_menu("context-menu-sides", "End-aligned fallback actions", side_items, align="end") %}
        {% call card(title="logs/production.log", subtitle="Fallback trigger aligns the menu to the end edge") %}
          <p class="text-body-secondary mb-0">Pointer-open menus anchor to the click point; the explicit fallback trigger can use Bootstrap's end alignment.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "sides",
      "Sides",
      "Use Bootstrap's end alignment for the fallback trigger while pointer invocation continues to position from the right-click location.",
      sides
    ) }}

    {% set rtl_items_arabic %}
      {{ dropdown_item("إعادة تسمية", icon="pencil") }}
      {{ dropdown_item("تكرار", icon="copy") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("حذف", icon="trash-2", destructive=true) }}
    {% endset %}
    {% set rtl_arabic %}
      {% call context_menu("context-menu-rtl-arabic", "إجراءات الملف", rtl_items_arabic) %}
        {% call card(title="تقرير ربع سنوي.pdf", subtitle="انقر بزر الماوس الأيمن أو اضغط على Shift+F10") %}
          <p class="text-body-secondary mb-0">زر الزاوية يفتح نفس القائمة للمس ولوحة المفاتيح.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}

    {% set rtl_items_hebrew %}
      {{ dropdown_item("שנה שם", icon="pencil") }}
      {{ dropdown_item("שכפל", icon="copy") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("מחק", icon="trash-2", destructive=true) }}
    {% endset %}
    {% set rtl_hebrew %}
      {% call context_menu("context-menu-rtl-hebrew", "פעולות קובץ", rtl_items_hebrew) %}
        {% call card(title="דוח רבעוני.pdf", subtitle="לחץ לחיצה ימנית או הקש Shift+F10") %}
          <p class="text-body-secondary mb-0">כפתור הפינה פותח את אותה תפריט למגע ולמקלדת.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}

    {% set rtl_items_english %}
      {{ dropdown_item("Rename", icon="pencil") }}
      {{ dropdown_item("Duplicate", icon="copy") }}
      {{ dropdown_divider() }}
      {{ dropdown_item("Delete", icon="trash-2", destructive=true) }}
    {% endset %}
    {% set rtl_english %}
      {% call context_menu("context-menu-rtl-english", "File actions", rtl_items_english) %}
        {% call card(title="Quarterly report.pdf", subtitle="Right-click or press Shift+F10") %}
          <p class="text-body-secondary mb-0">The corner button opens the same menu for touch and keyboard.</p>
        {% endcall %}
      {% endcall %}
    {% endset %}

    {{ render_rtl_example(
      "context-menu",
      "Switch between Arabic, Hebrew, and English to validate pointer/keyboard placement and item alignment in RTL mode.",
      rtl_arabic,
      rtl_hebrew,
      rtl_english
    ) }}
  </div>

  {{ render_reference(
    "Context Menu inherits Bootstrap's dropdown-menu surface, item states, and Popper positioning. Nested submenus are not supported because Bootstrap does not provide a native nested-menu contract; for the underlying options and keyboard behavior see the",
    "https://getbootstrap.com/docs/5.3/components/dropdowns/",
    "Bootstrap Dropdowns documentation"
  ) }}

{% endblock %}
