{% extends "layouts/catalog.html.jinja" %}
{% from "components/button.html.jinja" import button %}
{% from "components/button_group.html.jinja" import button_group %}
{% from "components/dropdown_menu.html.jinja" import dropdown_divider, dropdown_item, dropdown_menu %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_example, render_rtl_example %}

{% block title %}Button — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Buttons",
    "Use Bootstrap button styles for reliable production actions: publish, review, and move work forward."
  ) }}

  <div class="moo-component-examples">
    {% set size_example %}
      <div class="d-flex flex-column gap-3 flex-sm-row">
        <div class="d-flex align-items-start gap-2">
          {{ button("Extra Small", variant="outline", size="xs") }}
          {{ button("", variant="outline", size="icon-xs", aria_label="Submit", icon_start="arrow-up-right") }}
        </div>
        <div class="d-flex align-items-start gap-2">
          {{ button("Small", variant="outline", size="sm") }}
          {{ button("", variant="outline", size="icon-sm", aria_label="Submit", icon_start="arrow-up-right") }}
        </div>
        <div class="d-flex align-items-start gap-2">
          {{ button("Default", variant="outline") }}
          {{ button("", variant="outline", size="icon", aria_label="Submit", icon_start="arrow-up-right") }}
        </div>
        <div class="d-flex align-items-start gap-2">
          {{ button("Large", variant="outline", size="lg") }}
          {{ button("", variant="outline", size="icon-lg", aria_label="Submit", icon_start="arrow-up-right") }}
        </div>
      </div>
    {% endset %}
    {{ render_example(
      "size",
      "Size",
      "Use the <code>size</code> prop to change the size of the button.",
      size_example
    ) }}

    {% set default_example %}
      {{ button("Button") }}
    {% endset %}
    {{ render_example(
      "default",
      "Default",
      "The default button style for primary actions.",
      default_example
    ) }}

    {% set outline_example %}
      {{ button("Outline", variant="outline") }}
    {% endset %}
    {{ render_example(
      "outline",
      "Outline",
      "An outlined button with no fill.",
      outline_example
    ) }}

    {% set secondary_example %}
      {{ button("Secondary", variant="secondary") }}
    {% endset %}
    {{ render_example(
      "secondary",
      "Secondary",
      "A muted button for secondary actions.",
      secondary_example
    ) }}

    {% set ghost_example %}
      {{ button("Ghost", variant="ghost") }}
    {% endset %}
    {{ render_example(
      "ghost",
      "Ghost",
      "A transparent button with no background or border.",
      ghost_example
    ) }}

    {% set destructive_example %}
      {{ button("Destructive", variant="destructive") }}
    {% endset %}
    {{ render_example(
      "destructive",
      "Destructive",
      "A destructive button for dangerous actions.",
      destructive_example
    ) }}

    {% set link_example %}
      {{ button("Link", variant="link") }}
    {% endset %}
    {{ render_example(
      "link",
      "Link",
      "A button styled as a hyperlink.",
      link_example
    ) }}

    {% set icon_example %}
      {{ button("", variant="outline", size="icon", aria_label="Send", icon_start="send") }}
    {% endset %}
    {{ render_example(
      "icon",
      "Icon",
      "An icon-only button. Always provide an <code>aria-label</code>; the icon alone is not an accessible name.",
      icon_example
    ) }}

    {% set with_icon_example %}
      <div class="d-flex flex-wrap gap-2">
        {{ button("New Branch", variant="outline", icon_start="git-branch") }}
        {{ button("Fork", variant="outline", icon_end="git-fork") }}
      </div>
    {% endset %}
    {{ render_example(
      "with-icon",
      "With Icon",
      "Remember to add the <code>icon_start</code> or <code>icon_end</code> parameter to the button for the correct spacing.",
      with_icon_example
    ) }}

    {% set button_states %}
      <div class="d-flex flex-wrap gap-2">
        {{ button("Read-only mode", variant="outline", disabled=true) }}
        {{ button("Retry", variant="secondary", disabled=true) }}
        {{ button("Saving", variant="outline", loading=true, disabled=true) }}
      </div>
    {% endset %}
    {{ render_example(
      "button-states",
      "States",
      "Use disabled and loading states to make temporary limits and async work obvious to operators.",
      button_states
    ) }}

    {% set rounded_example %}
      <div class="d-flex flex-wrap gap-2">
        {{ button("Get Started", extra_class="rounded-pill") }}
        {{ button("", variant="outline", size="icon", aria_label="Arrow up", icon_start="arrow-up", extra_class="rounded-pill") }}
      </div>
    {% endset %}
    {{ render_example(
      "rounded",
      "Rounded",
      "Use the <code>rounded-pill</code> class to make the button rounded.",
      rounded_example
    ) }}

    {% set spinner_example %}
      <div class="d-flex flex-wrap gap-2">
        {{ button("Generating", loading=true, disabled=true) }}
        {{ button("Downloading", loading=true, disabled=true) }}
      </div>
    {% endset %}
    {{ render_example(
      "spinner",
      "Spinner",
      "Render a spinner inside the button to show a loading state. The <code>loading</code> parameter replaces the leading icon with a spinning loader and sets <code>aria-busy</code>.",
      spinner_example
    ) }}

    {% set full_width_actions %}
      <div class="d-grid gap-2">
        {{ button("Create workspace", extra_class="w-100") }}
        {{ button("Invite collaborators", variant="outline", extra_class="w-100") }}
      </div>
    {% endset %}
    {{ render_example(
      "full-width-actions",
      "Block buttons",
      "<code>d-grid gap-2</code> stacks actions with consistent spacing, while <code>w-100</code> lets each button fill the available width. This is a layout choice, not a new button variant.",
      full_width_actions
    ) }}

    {% set toggle_state %}
      {{ button("Follow this ticket", variant="outline", toggle=true) }}
    {% endset %}
    {{ render_example(
      "toggle-state",
      "Toggle states",
      "<code>data-bs-toggle=\"button\"</code> keeps the pressed state synchronized. <code>aria-pressed=\"false\"</code> marks an initial inactive state.",
      toggle_state
    ) }}

    {% set related_button_group %}
      {% call button_group("Message actions", toolbar=true, extra_class="gap-2") %}
        {% call button_group("Navigation", extra_class="d-none d-sm-flex") %}
          {{ button("", variant="outline", size="icon", aria_label="Go back", icon_start="arrow-left") }}
        {% endcall %}
        {% call button_group("Message review") %}
          {{ button("Archive", variant="outline") }}
          {{ button("Report", variant="outline") }}
        {% endcall %}
        {% call button_group("More actions") %}
          {{ button("Snooze", variant="outline") }}
          {{ button("", variant="outline", size="icon", aria_label="More options", icon_start="ellipsis", extra_class="rounded-end", dropdown=true) }}
          {% call dropdown_menu(align="end") %}
            {{ dropdown_item("Mark as handled", icon="mail-check") }}
            {{ dropdown_item("Move to archive", icon="archive") }}
            {{ dropdown_divider() }}
            {{ dropdown_item("Delete message", icon="trash-2", destructive=true) }}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {% set related_button_group_description %}
      Group adjacent actions that belong together. See the <a href="{{ site_href("components/button-group.html", root_path) }}">Button Group</a> component for broader toolbar behavior.
    {% endset %}
    {{ render_example(
      "related-button-group",
      "Button Group",
      related_button_group_description,
      related_button_group
    ) }}

    {% set rtl_arabic %}
      <div class="d-inline-flex gap-2" dir="rtl">
        {{ button("حفظ", variant="outline", icon_start="save") }}
        {{ button("نشر", variant="success", icon_start="send") }}
      </div>
    {% endset %}

    {% set rtl_hebrew %}
      <div class="d-inline-flex gap-2" dir="rtl">
        {{ button("שמור", variant="outline", icon_start="save") }}
        {{ button("פרסם", variant="success", icon_start="send") }}
      </div>
    {% endset %}

    {% set rtl_english %}
      <div class="d-inline-flex gap-2" dir="rtl">
        {{ button("Save", variant="outline", icon_start="save") }}
        {{ button("Publish", variant="success", icon_start="send") }}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "button",
      "Use tabs to compare Arabic, Hebrew, and English button actions in RTL layout.",
      rtl_arabic,
      rtl_hebrew,
      rtl_english
    ) }}
  </div>

  {{ render_reference(
    "For more detailed information, see the",
    "https://getbootstrap.com/docs/5.3/components/buttons/",
    "Bootstrap Buttons documentation"
  ) }}

{% endblock %}
