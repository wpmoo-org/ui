{% extends "layouts/catalog.html.jinja" %}
{% from "components/button.html.jinja" import button %}
{% from "components/button_group.html.jinja" import button_group %}
{% from "components/dropdown_menu.html.jinja" import dropdown_divider, dropdown_item, dropdown_menu %}
{% from "components/field.html.jinja" import field %}
{% from "components/input.html.jinja" import input %}
{% from "components/input_group.html.jinja" import input_group %}
{% from "components/select.html.jinja" import select %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_rtl_example with context %}

{% block title %}Button Group — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Button Group",
    "Join related controls into one compact action surface."
  ) }}

  <div class="moo-component-examples">
    {% set basic_actions %}
      {% call button_group("Message actions", toolbar=true, extra_class="gap-2") %}
        {% call button_group("Message navigation") %}
          {{ button("", variant="outline", size="icon", aria_label="Go back", icon_start="arrow-left") }}
        {% endcall %}
        {% call button_group("Message review") %}
          {{ button("Archive", variant="outline") }}
          {{ button("Report", variant="outline") }}
        {% endcall %}
        {% call button_group("More actions") %}
          {{ button("Snooze", variant="outline") }}
          {{ button("", variant="outline", size="icon", aria_label="More message actions", icon_start="ellipsis", extra_class="rounded-end", dropdown=true) }}
          {% call dropdown_menu(align="end") %}
            {{ dropdown_item("Mark as handled", icon="mail-check") }}
            {{ dropdown_item("Move to archive", icon="archive") }}
            {{ dropdown_item("Delay reminder", icon="clock") }}
            {{ dropdown_divider() }}
            {{ dropdown_item("Delete message", icon="trash-2", destructive=true) }}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {% set button_group_usage %}
      <p>Use <code>.btn-group</code> when several closely related buttons should read as one compact control surface. Keep joined buttons in one action family, and include only actions that share the same context or operate on the same object.</p>
      <p>Give every group an explicit accessible label with <code>role="group"</code> plus <code>aria-label</code> or <code>aria-labelledby</code>. When multiple groups share a row, wrap them in a <code>.btn-toolbar</code> with <code>role="toolbar"</code> and let each inner group keep its own label.</p>
      <p>Use grouped checkbox or radio toggles only when the options act like buttons and the selected state needs to stay visible. Preserve normal focus order, keep icon-only buttons labelled, and move unrelated overflow actions into a dropdown rather than stretching the joined edge.</p>
    {% endset %}
    {{ render_component_intro(
      basic_actions,
      button_group_usage
    ) }}

    {% set outlined_styles %}
      {% call button_group("Outlined actions") %}
        {{ button("Previous", variant="outline-primary") }}
        {{ button("Current", variant="outline-primary") }}
        {{ button("Next", variant="outline-primary") }}
      {% endcall %}
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "outlined-styles",
      "Outlined styles",
      "Use the same <code>btn-outline-*</code> variant across a group when the controls should share one quiet visual weight.",
      outlined_styles
    ) }}

    {% set icon_only_group %}
      {% call button_group("Media controls") %}
        {{ button("", variant="outline", size="icon", aria_label="Previous item", icon_start="chevron-left") }}
        {{ button("", variant="outline", size="icon", aria_label="Pin item", icon_start="pin") }}
        {{ button("", variant="outline", size="icon", aria_label="Next item", icon_start="chevron-right") }}
      {% endcall %}
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "icon-only-group",
      "Icon-only group",
      "Give every icon-only button a square <code>size=\"icon\"</code> shape and an <code>aria-label</code>; the icon alone is not an accessible name.",
      icon_only_group
    ) }}

    {% set size_groups %}
      <div class="d-flex flex-column align-items-center gap-3">
        {% call button_group("Small button group", size="sm") %}
          {{ button("Small", variant="outline") }}
          {{ button("Button", variant="outline") }}
          {{ button("Group", variant="outline") }}
          {{ button("", variant="outline", size="icon", aria_label="Add small action", icon_start="plus") }}
        {% endcall %}
        {% call button_group("Default button group") %}
          {{ button("Default", variant="outline") }}
          {{ button("Button", variant="outline") }}
          {{ button("Group", variant="outline") }}
          {{ button("", variant="outline", size="icon", aria_label="Add default action", icon_start="plus") }}
        {% endcall %}
        {% call button_group("Large button group", size="lg") %}
          {{ button("Large", variant="outline") }}
          {{ button("Button", variant="outline") }}
          {{ button("Group", variant="outline") }}
          {{ button("", variant="outline", size="icon", aria_label="Add large action", icon_start="plus") }}
        {% endcall %}
      </div>
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "size-groups",
      "Size",
      "<code>btn-group-sm</code> and <code>btn-group-lg</code> apply one density to every button in the group, keeping joined edges aligned.",
      size_groups
    ) }}

    {% set vertical_group %}
      {% call button_group("Quantity controls", vertical=true) %}
        {{ button("", variant="outline", size="icon", aria_label="Increase value", icon_start="plus") }}
        {{ button("", variant="outline", size="icon", aria_label="Decrease value", icon_start="minus") }}
      {% endcall %}
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "vertical-group",
      "Orientation",
      "Use <code>btn-group-vertical</code> when related controls belong in a narrow rail or stacked tool palette.",
      vertical_group
    ) }}

    {% set toolbar_groups %}
      {% call button_group("Editor toolbar", toolbar=true, extra_class="gap-2") %}
        {% call button_group("History actions") %}
          {{ button("Undo", variant="outline") }}
          {{ button("Redo", variant="outline") }}
        {% endcall %}
        {% call button_group("Formatting actions") %}
          {{ button("Bold", variant="outline") }}
          {{ button("Italic", variant="outline") }}
          {{ button("Link", variant="outline") }}
        {% endcall %}
        {% call button_group("Publish action") %}
          {{ button("Publish", variant="secondary") }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "toolbar-groups",
      "Toolbar",
      "Use <code>btn-toolbar</code> for separate action clusters; <code>gap-2</code> spaces the clusters while each inner group stays joined.",
      toolbar_groups
    ) }}

    {% set mixed_emphasis_group %}
      {% call button_group("Review actions") %}
        {{ button("Approve", variant="default") }}
        {{ button("Archive", variant="outline") }}
      {% endcall %}
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "mixed-emphasis-group",
      "Mixed emphasis",
      "Use mixed emphasis only when the actions form one joined decision surface; plain hover keeps the joined edge visually stable.",
      mixed_emphasis_group
    ) }}

    {% set nested_groups %}
      <div class="d-flex align-items-center gap-2">
        {{ button("", variant="outline", size="icon", aria_label="Add attachment", icon_start="plus", extra_class="rounded-3") }}
        {% call field(extra_class="flex-grow-1") %}
          {% call input_group(extra_class="rounded-3") %}
            {{ input(aria_label="Message body", placeholder="Send a message...") }}
            {{ button("", variant="ghost", size="icon", aria_label="Record voice note", icon_start="audio-lines", extra_class="border-0") }}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "nested-groups",
      "Nested groups",
      "Use Bootstrap input grouping when buttons and fields need one connected surface.",
      nested_groups
    ) }}

    {% set dropdown_button %}
      {% call button_group("Deploy action") %}
        {{ button("Deploy", variant="secondary") }}
        {{ button("", variant="secondary", size="icon", aria_label="Deploy options", icon_start="chevron-down", extra_class="rounded-end", dropdown=true) }}
        {% call dropdown_menu(align="end") %}
          {{ dropdown_item("Deploy to production", icon="rocket") }}
          {{ dropdown_item("Deploy to staging", icon="flask-conical") }}
          {{ dropdown_divider() }}
          {{ dropdown_item("Cancel deployment", icon="circle-x", destructive=true) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "dropdown-button",
      "Dropdown menu",
      "Pair a primary action with a Dropdown Menu trigger for related variants. The chevron trigger carries an accessible name without Bootstrap's caret.",
      dropdown_button
    ) }}

    {% set select_group %}
      <div class="d-inline-flex align-items-stretch">
        {% call field(extra_class="flex-grow-1") %}
          {% call input_group(extra_class="rounded-3") %}
            {{ select(aria_label="Currency", extra_class="btn-group-select", options=[{"value": "usd", "label": "$ USD"}, {"value": "eur", "label": "€ EUR"}, {"value": "gbp", "label": "£ GBP", "selected": true}]) }}
            {{ input(aria_label="Amount", placeholder="10.00") }}
            {{ button("", variant="outline", size="icon", aria_label="Send", icon_start="arrow-right") }}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}
    {{ render_component_example("button-group", "Button Group",
      "select-group",
      "Native select",
      "Pair with the native <a href=\"/components/select/\">Native Select</a> component when the control should keep browser and mobile selection behavior.",
      select_group
    ) }}

    {% set rtl_arabic %}
      <div dir="rtl">
        {% call button_group("إجراءات الرسالة", toolbar=true, extra_class="gap-2") %}
          {% call button_group("التنقل في الرسالة") %}
            {{ button("", variant="outline", size="icon", aria_label="الرجوع", icon_start="arrow-left") }}
          {% endcall %}
          {% call button_group("مراجعة الرسالة") %}
            {{ button("أرشفة", variant="outline") }}
            {{ button("إبلاغ", variant="outline") }}
          {% endcall %}
          {% call button_group("إجراءات أخرى") %}
            {{ button("تأجيل", variant="outline") }}
            {{ button("", variant="outline", size="icon", aria_label="المزيد", icon_start="ellipsis", extra_class="rounded-end", dropdown=true) }}
            {% call dropdown_menu(align="end") %}
              {{ dropdown_item("وضع علامة كمُعالَج", icon="mail-check") }}
              {{ dropdown_item("نقل إلى الأرشيف", icon="archive") }}
              {{ dropdown_item("تأجيل التذكير", icon="clock") }}
              {{ dropdown_divider() }}
              {{ dropdown_item("حذف الرسالة", icon="trash-2", destructive=true) }}
            {% endcall %}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {% set rtl_hebrew %}
      <div dir="rtl">
        {% call button_group("פעולות הודעה", toolbar=true, extra_class="gap-2") %}
          {% call button_group("ניווט בהודעה") %}
            {{ button("", variant="outline", size="icon", aria_label="חזרה", icon_start="arrow-left") }}
          {% endcall %}
          {% call button_group("סקירת הודעה") %}
            {{ button("ארכוב", variant="outline") }}
            {{ button("דיווח", variant="outline") }}
          {% endcall %}
          {% call button_group("פעולות נוספות") %}
            {{ button("השהיה", variant="outline") }}
            {{ button("", variant="outline", size="icon", aria_label="עוד", icon_start="ellipsis", extra_class="rounded-end", dropdown=true) }}
            {% call dropdown_menu(align="end") %}
              {{ dropdown_item("סמן כטופל", icon="mail-check") }}
              {{ dropdown_item("העבר לארכיון", icon="archive") }}
              {{ dropdown_item("דחה תזכורת", icon="clock") }}
              {{ dropdown_divider() }}
              {{ dropdown_item("מחק הודעה", icon="trash-2", destructive=true) }}
            {% endcall %}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {% set rtl_english %}
      <div dir="ltr">
        {% call button_group("Message actions", toolbar=true, extra_class="gap-2") %}
          {% call button_group("Message navigation") %}
            {{ button("", variant="outline", size="icon", aria_label="Go back", icon_start="arrow-left") }}
          {% endcall %}
          {% call button_group("Message review") %}
            {{ button("Archive", variant="outline") }}
            {{ button("Report", variant="outline") }}
          {% endcall %}
          {% call button_group("More actions") %}
            {{ button("Snooze", variant="outline") }}
            {{ button("", variant="outline", size="icon", aria_label="More", icon_start="ellipsis", extra_class="rounded-end", dropdown=true) }}
            {% call dropdown_menu(align="end") %}
              {{ dropdown_item("Mark as handled", icon="mail-check") }}
              {{ dropdown_item("Move to archive", icon="archive") }}
              {{ dropdown_item("Delay reminder", icon="clock") }}
              {{ dropdown_divider() }}
              {{ dropdown_item("Delete message", icon="trash-2", destructive=true) }}
            {% endcall %}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "button-group-ribbon",
      "Compare Arabic, Hebrew, and English command rails in an RTL shell for workspace admin workflows.",
      rtl_arabic,
      rtl_hebrew,
      rtl_english,
      preview_class="moo-example__preview--fit",
      title="RTL",
      title_id="button-group-rtl",
      example_prefix="rtl"
    ) }}
  </div>

  {{ render_reference(
    "For more grouping patterns, see the",
    "https://getbootstrap.com/docs/5.3/components/button-group/",
    "Bootstrap Button group documentation"
  ) }}

{% endblock %}
