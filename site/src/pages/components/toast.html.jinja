{% extends "layouts/catalog.html.jinja" %}
{% from "components/button.html.jinja" import button %}
{% from "components/toast.html.jinja" import toast, toast_container, toast_template %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% block title %}Toast — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Toast",
    "Surface short operational updates that should stay visible long enough to be noticed."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      {{ button("Show Toast", variant="outline", toast_target="toast-demo-template") }}
      {% call toast_container(placement="bottom-end", stacked=true) %}
        {{ toast_template(
          "toast-demo-template",
          "Event created",
          "Sunday, December 3 at 9:00 AM",
          action_label="Undo"
        ) }}
      {% endcall %}
    {% endset %}
    {% set toast_usage %}
      <p>Click the same <code>Show Toast</code> action as many times as needed. The bottom-right deck keeps the newest three Toasts visible, with its own close, Undo, and auto-hide behavior.</p>
      <p>Keep messages concise, use polite live-region priority for routine updates, and provide durable workflow feedback elsewhere when a notification represents a state that must persist.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      toast_usage,
      "moo-example__preview--narrow"
    ) }}

    {% set basic %}
      {{ button("Show Toast", variant="outline", toast_target="toast-basic-template") }}
      {% call toast_container(placement="bottom-end") %}
        {{ toast_template(
          "toast-basic-template",
          "Event created",
          "Sunday, December 3 at 9:00 AM"
        ) }}
      {% endcall %}
    {% endset %}
    {% set basic_source %}
      {{ toast(
        "toast-basic",
        "Event created",
        "Sunday, December 3 at 9:00 AM"
      ) }}
    {% endset %}
    {{ render_component_example("toast", "Toast",
      "basic",
      "Basic",
      "Use <code>.toast</code> with polite live-region attributes, a <code>.toast-header</code>, a dismiss button, and a <code>.toast-body</code> for routine feedback.",
      basic,
      preview_class="moo-example__preview--narrow",
      source_content=basic_source
    ) }}

    {% set variants %}
      <div class="d-flex flex-wrap gap-2">
        {{ button("Success", variant="outline", toast_target="toast-variant-success-template") }}
        {{ button("Info", variant="outline", toast_target="toast-variant-info-template") }}
        {{ button("Warning", variant="outline", toast_target="toast-variant-warning-template") }}
        {{ button("Destructive", variant="outline", toast_target="toast-variant-destructive-template") }}
        {{ button("Loading", variant="outline", toast_target="toast-variant-loading-template") }}
      </div>
      {% call toast_container(placement="bottom-end") %}
        {{ toast_template(
          "toast-variant-success-template",
          "Event created",
          "The event was added to your calendar.",
          variant="success"
        ) }}
        {{ toast_template(
          "toast-variant-info-template",
          "Heads up",
          "Invitees will receive an email confirmation.",
          variant="info"
        ) }}
        {{ toast_template(
          "toast-variant-warning-template",
          "Check availability",
          "Two invitees have a scheduling conflict.",
          variant="warning"
        ) }}
        {{ toast_template(
          "toast-variant-destructive-template",
          "Event not created",
          "The calendar service could not be reached.",
          priority="assertive",
          variant="destructive"
        ) }}
        {{ toast_template(
          "toast-variant-loading-template",
          "Syncing calendar",
          "This can take a moment.",
          variant="loading"
        ) }}
      {% endcall %}
    {% endset %}
    {% set variants_source %}
      {{ toast(
        "toast-variant-success",
        "Event created",
        "The event was added to your calendar.",
        variant="success"
      ) }}
      {{ toast(
        "toast-variant-info",
        "Heads up",
        "Invitees will receive an email confirmation.",
        variant="info"
      ) }}
      {{ toast(
        "toast-variant-warning",
        "Check availability",
        "Two invitees have a scheduling conflict.",
        variant="warning"
      ) }}
      {{ toast(
        "toast-variant-destructive",
        "Event not created",
        "The calendar service could not be reached.",
        priority="assertive",
        variant="destructive"
      ) }}
      {{ toast(
        "toast-variant-loading",
        "Syncing calendar",
        "This can take a moment.",
        variant="loading"
      ) }}
    {% endset %}
    {{ render_component_example("toast", "Toast",
      "variants",
      "Variants",
      "Use <code>variant=\"success\"</code> or another supported variant in a Moo macro. In plain HTML, set <code>data-toast-variant=\"success\"</code> on the <code>.toast</code> root. Catalog <code>data-toast-target</code> attributes only wire demo buttons; urgent failures still need <code>priority=\"assertive\"</code> in macros or <code>role=\"alert\"</code> with <code>aria-live=\"assertive\"</code> in plain HTML. The loading variant is visual only and does not auto-resolve a Promise.",
      variants,
      preview_class="moo-example__preview--medium",
      source_content=variants_source
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's Toast plugin options and accessibility notes, see the",
    "https://getbootstrap.com/docs/5.3/components/toasts/",
    "Bootstrap Toasts documentation"
  ) }}

{% endblock %}
