{% extends "layouts/catalog.html.jinja" %}
{% from "components/checkbox.html.jinja" import checkbox %}
{% from "components/field.html.jinja" import field, fieldset, field_group %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_example, render_rtl_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Checkbox — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Checkbox",
    "Toggle a single option using Bootstrap's native checkbox contract."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      {{ checkbox(
        "checkbox-intro",
        label="Checkbox",
        description="Use for one optional setting that can be selected or cleared."
      ) }}
    {% endset %}
    {% set checkbox_usage %}
      <p>Use <code>.form-check</code> when a single checkbox option can be independently on or off, or when several options in a set may be selected together. Keep the native <code>input</code> and <code>label</code> as siblings, give the input <code>.form-check-input</code>, give the label <code>.form-check-label</code>, and connect them with matching <code>id</code> and <code>for</code>.</p>
      <p>Let the label carry the hit target and write it as the choice the user is making. Add a short description below the label only when the consequence is not obvious, and group related checkboxes with a fieldset and legend when they answer one larger question.</p>
      <p>Use the native <code>checked</code> and <code>disabled</code> attributes for state, and set indeterminate state from JavaScript because HTML has no <code>indeterminate</code> attribute. Mark invalid state on the input when validation fails so Bootstrap's sibling-state styling can reach the label and feedback.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      checkbox_usage,
      "moo-example__preview--narrow"
    ) }}

    {% set checked_state %}
      <div class="d-inline-grid gap-2">
        {{ checkbox("checkbox-unchecked", label="Accept terms and conditions") }}
        {{ checkbox("checkbox-checked", label="Accept terms and conditions", checked=true) }}
      </div>
    {% endset %}
    {{ render_example(
      "checked-state",
      "Checked State",
      "Unchecked and checked states share the same label contract; the input's <code>checked</code> attribute sets the initial state.",
      checked_state,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set invalid_state %}
      {{ checkbox("checkbox-invalid", label="Accept terms and conditions", invalid=true) }}
    {% endset %}
    {{ render_example(
      "invalid-state",
      "Invalid State",
      "Set <code>invalid=true</code> to pair with a form's validation state. Unlike other form controls, invalid checkboxes keep the focus ring visible on mouse click so the error stays prominent.",
      invalid_state,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set basic %}
      {{ checkbox("checkbox-basic", label="Accept terms and conditions") }}
    {% endset %}
    {{ render_example(
      "basic",
      "Basic",
      "Pair the checkbox with a label for proper layout and labeling. The <code>form-check</code> wrapper aligns the input and text on a shared baseline.",
      basic,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set with_description %}
      {{ checkbox(
        "checkbox-desc",
        label="Accept terms and conditions",
        description="By clicking this checkbox, you agree to the terms and conditions.",
        checked=true
      ) }}
    {% endset %}
    {{ render_example(
      "with-description",
      "Description",
      "Add supporting copy below the label with <code>description</code>. The helper text is linked via <code>aria-describedby</code> for screen readers.",
      with_description,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set disabled %}
      <div class="d-inline-grid gap-2">
        {{ checkbox("checkbox-disabled", label="Enable notifications", disabled=true) }}
        {{ checkbox("checkbox-disabled-checked", label="Enable notifications", checked=true, disabled=true) }}
      </div>
    {% endset %}
    {{ render_example(
      "disabled",
      "Disabled",
      "Disabled checkboxes lower opacity and drop pointer interaction in both states.",
      disabled,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set group %}
      {% call fieldset("Show these items on the desktop", description="Select the items you want to show on the desktop.") %}
        {% call field_group() %}
          {% call field() %}
            {{ checkbox("checkbox-group-hard-disks", label="Hard disks", checked=true) }}
          {% endcall %}
          {% call field() %}
            {{ checkbox("checkbox-group-external", label="External disks", checked=true) }}
          {% endcall %}
          {% call field() %}
            {{ checkbox("checkbox-group-cd-dvd", label="CDs, DVDs, and iPods") }}
          {% endcall %}
          {% call field() %}
            {{ checkbox("checkbox-group-servers", label="Connected servers") }}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "group",
      "Group",
      "Stack multiple checkboxes with a shared label and description to create a checkbox list.",
      group,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set table_example %}
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th class="ps-1" style="width: 2.5rem"></th>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="ps-1">{{ checkbox("checkbox-row-1", aria_label="Select Ayla Norberg", label_wrapper=true) }}</td>
              <td>Ayla Norberg</td>
              <td>ayla.norberg@example.com</td>
              <td>Admin</td>
            </tr>
            <tr>
              <td class="ps-1">{{ checkbox("checkbox-row-2", aria_label="Select Marcus Voss", label_wrapper=true) }}</td>
              <td>Marcus Voss</td>
              <td>marcus.voss@example.com</td>
              <td>User</td>
            </tr>
            <tr>
              <td class="ps-1">{{ checkbox("checkbox-row-3", aria_label="Select Priya Kapoor", label_wrapper=true, checked=true) }}</td>
              <td>Priya Kapoor</td>
              <td>priya.kapoor@example.com</td>
              <td>Editor</td>
            </tr>
            <tr>
              <td class="ps-1">{{ checkbox("checkbox-row-4", aria_label="Select Jonas Eriksen", label_wrapper=true) }}</td>
              <td>Jonas Eriksen</td>
              <td>jonas.eriksen@example.com</td>
              <td>User</td>
            </tr>
          </tbody>
        </table>
      </div>
    {% endset %}
    {{ render_example(
      "table",
      "Table",
      "Embed checkboxes inside table rows for batch selection. Use <code>label_wrapper</code> with <code>aria_label</code> so the entire cell is the hit target.",
      table_example
    ) }}

    {% set rtl_arabic %}
      <div class="d-grid gap-2" dir="rtl">
        {{ checkbox("checkbox-rtl-ar-terms", label="قبول الشروط والأحكام", extra_class="form-check-reverse") }}
        {{ checkbox("checkbox-rtl-ar-notify", label="تفعيل الإشعارات", description="يمكنك تفعيل أو إلغاء تفعيل الإشعارات في أي وقت.", checked=true, extra_class="form-check-reverse") }}
      </div>
    {% endset %}

    {% set rtl_hebrew %}
      <div class="d-grid gap-2" dir="rtl">
        {{ checkbox("checkbox-rtl-he-terms", label="קבלת תנאי השירות", extra_class="form-check-reverse") }}
        {{ checkbox("checkbox-rtl-he-notify", label="הפעלת התראות", description="ניתן להפעיל או לבטל התראות בכל עת.", checked=true, extra_class="form-check-reverse") }}
      </div>
    {% endset %}

    {% set rtl_english %}
      <div class="d-grid gap-2" dir="ltr">
        {{ checkbox("checkbox-rtl-en-terms", label="Accept terms and conditions") }}
        {{ checkbox("checkbox-rtl-en-notify", label="Enable notifications", description="You can enable or disable notifications at any time.", checked=true) }}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "checkbox",
      "Compare Arabic, Hebrew, and English checkbox labels in an RTL layout for terms and notification workflows.",
      rtl_arabic,
      rtl_hebrew,
      rtl_english,
      preview_class="moo-example__preview--narrow"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and the shared form-check family, see the",
    "https://getbootstrap.com/docs/5.3/forms/checks-radios/",
    "Bootstrap Checks and radios documentation"
  ) }}

{% endblock %}
