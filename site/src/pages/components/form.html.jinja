{% extends "layouts/catalog.html.jinja" %}
{% from "components/button.html.jinja" import button %}
{% from "components/checkbox.html.jinja" import checkbox %}
{% from "components/field.html.jinja" import form, field, field_description, field_error, field_group, fieldset %}
{% from "components/input.html.jinja" import input %}
{% from "components/radio_group.html.jinja" import radio_group %}
{% from "components/select.html.jinja" import select %}
{% from "components/switch.html.jinja" import switch %}
{% from "components/textarea.html.jinja" import textarea %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_rtl_example with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Form — Moo UI{% endblock %}

{% block content %}
{{ render_page_header(
"Form",
"Build complete Bootstrap forms from native form and fieldset markup, visible labels, descriptions, validation feedback, and documented Field components."
) }}

<div class="moo-component-examples">
  {% set intro %}
  {% call form(extra_class="needs-validation", novalidate=true) %}
    {% call fieldset("Account profile", description="Update the details teammates see in shared project tools.") %}
      {% call field_group() %}
        {% call field() %}
          {{ input(label="Display name", id="form-intro-name", placeholder="Ada Lovelace", required=true) }}
        {% endcall %}
        {% call field() %}
          {{ select(label="Default queue", id="form-intro-queue", options=[
            {"value": "", "label": "Choose queue", "disabled": true},
            {"value": "ops", "label": "Operations"},
            {"value": "support", "label": "Support"},
            {"value": "finance", "label": "Finance"}
          ], selected="ops") }}
        {% endcall %}
      {% endcall %}
    {% endcall %}
    <div class="d-flex flex-wrap gap-2">
      {{ button("Save changes", type="submit") }}
      {{ button("Reset", variant="outline", type="reset") }}
    </div>
  {% endcall %}
  {% endset %}
  {% set form_usage %}
    <p>Use a real <code>&lt;form&gt;</code> to submit a complete set of related fields through native HTML semantics. Compose each row with the <a href="/components/field/">Field</a> pattern, group related controls with <a href="/components/field/#fieldset">fieldsets and legends</a>, and keep every editable control paired with a visible label or accessible name.</p>
    <p>Use Bootstrap <code>.form-control</code>, <code>.form-select</code>, and <code>.form-check</code> contracts for the inputs themselves; see <a href="/components/input/">Input</a>, <a href="/components/select/">Native Select</a>, and <a href="/components/checkbox/">Checkbox</a> for the control-level markup. Keep descriptions, constraints, and validation feedback close to the field they affect. For validation, add submitted-state classes to the form, connect messages with <code>aria-describedby</code>, and let native attributes such as <code>required</code>, <code>disabled</code>, and <code>readonly</code> describe the browser behavior.</p>
    <p>Keep submit and reset actions outside individual fields so they read as form-level commands. Preserve predictable tab order, avoid nested forms, and only split a long form into sections when the grouping helps users understand what will be saved together.</p>
  {% endset %}
  {{ render_component_intro(
    intro,
    form_usage,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set account_settings %}
  {% call form(extra_class="needs-validation", novalidate=true) %}
    {% call fieldset("Account profile", description="Update the details teammates see in shared project tools.") %}
      {% call field_group() %}
        {% call field() %}
          {{ input(label="Display name", id="form-profile-name", placeholder="Ada Lovelace", required=true, describedby="form-profile-name-error") }}
          {{ field_error("form-profile-name-error", "Enter a display name.") }}
        {% endcall %}
        {% call field() %}
          {{ input(label="Role", id="form-profile-role", placeholder="Release coordinator", describedby="form-profile-role-help") }}
          {{ field_description("form-profile-role-help", "Shown next to your avatar in handoff notes.") }}
        {% endcall %}
      {% endcall %}
    {% endcall %}
    {% call fieldset("Preferences", description="Choose how this workspace should notify you.") %}
      {% call field_group() %}
        {% call field() %}
          {{ select(label="Default queue", id="form-profile-queue", options=[
            {"value": "", "label": "Choose queue", "disabled": true},
            {"value": "ops", "label": "Operations"},
            {"value": "support", "label": "Support"},
            {"value": "finance", "label": "Finance"}
          ], selected="ops") }}
        {% endcall %}
        {% call field() %}
          {{ switch(id="form-profile-digest", label="Send a daily digest", checked=true) }}
        {% endcall %}
      {% endcall %}
    {% endcall %}
    <div class="d-flex flex-wrap gap-2">
      {{ button("Save changes", type="submit") }}
      {{ button("Reset", variant="outline", type="reset") }}
    </div>
  {% endcall %}
  {% endset %}
  {{ render_component_example("form", "Form",
    "account-settings",
    "Field composition",
    "Compose a native <code>&lt;form&gt;</code> from Field, Fieldset, and Bootstrap form-control contracts.",
    account_settings,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set deploy_request %}
  {% call form(extra_class="needs-validation", novalidate=true) %}
    {% call fieldset("Deploy request", description="Capture the minimum context needed before a release moves forward.") %}
      {% call field_group() %}
        {% call field() %}
          {{ input(label="Release name", id="form-deploy-name", placeholder="billing-dashboard-v2", required=true, describedby="form-deploy-name-error") }}
          {{ field_error("form-deploy-name-error", "Release name is required.") }}
        {% endcall %}
        {% call field() %}
          {{ textarea(label="Reviewer notes", id="form-deploy-notes", placeholder="Call out database changes or rollback concerns.", rows=3, describedby="form-deploy-notes-help") }}
          {{ field_description("form-deploy-notes-help", "Visible in the approval queue.") }}
        {% endcall %}
      {% endcall %}
    {% endcall %}
    {% call fieldset("Approval policy", description="Pick the checks this deploy must pass.") %}
      {% call field_group() %}
        {% call field() %}
          {{ checkbox(id="form-deploy-security", label="Security review", checked=true) }}
        {% endcall %}
        {% call field() %}
          {{ checkbox(id="form-deploy-backup", label="Backup verified", checked=true) }}
        {% endcall %}
        {% call field() %}
          {{ checkbox(id="form-deploy-window", label="Maintenance window scheduled") }}
        {% endcall %}
      {% endcall %}
    {% endcall %}
    <div class="d-flex flex-wrap gap-2">
      {{ button("Request deploy", type="submit") }}
      {{ button("Save draft", variant="outline") }}
    </div>
  {% endcall %}
  {% endset %}
  {{ render_component_example("form", "Form",
    "deploy-request",
    "Validation feedback",
    "Keep required inputs, helper text, and invalid feedback close to the field they describe.",
    deploy_request,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set access_policy %}
  {% call form() %}
    {% call fieldset("Workspace access", description="Set the default access level for new collaborators.") %}
      {{ radio_group("form-access-policy", "Default access", [
        {"id": "form-access-viewer", "label": "Viewer", "value": "viewer", "checked": true},
        {"id": "form-access-editor", "label": "Editor", "value": "editor"},
        {"id": "form-access-admin", "label": "Administrator", "value": "admin"}
      ]) }}
      {% call field_group() %}
        {% call field() %}
          {{ switch(id="form-access-expire", label="Expire guest access after 30 days", checked=true) }}
        {% endcall %}
        {% call field() %}
          {{ switch(id="form-access-alert", label="Notify owners when access changes") }}
        {% endcall %}
      {% endcall %}
    {% endcall %}
  {% endcall %}
  {% endset %}
  {{ render_component_example("form", "Form",
    "access-policy",
    "Grouped controls",
    "Use Fieldset for related choices even when the child controls already own their labels.",
    access_policy,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set rtl_arabic %}
    <div dir="rtl">
      {% call form(extra_class="needs-validation", novalidate=true) %}
        {% call fieldset("ملف الحساب", description="حدّث التفاصيل التي يراها الفريق في أدوات المشروع المشتركة.") %}
          {% call field_group() %}
            {% call field() %}
              {{ input(label="اسم العرض", id="form-rtl-arabic-name", placeholder="سارة علي", required=true) }}
            {% endcall %}
            {% call field() %}
              {{ select(label="قائمة العمل الافتراضية", id="form-rtl-arabic-queue", options=[
                {"value": "", "label": "اختر القائمة", "disabled": true},
                {"value": "ops", "label": "العمليات"},
                {"value": "support", "label": "الدعم"},
                {"value": "finance", "label": "المالية"}
              ], selected="ops", dir="rtl") }}
            {% endcall %}
          {% endcall %}
        {% endcall %}
        <div class="d-flex flex-wrap gap-2">
          {{ button("حفظ التغييرات", type="submit") }}
          {{ button("إعادة ضبط", variant="outline", type="reset") }}
        </div>
      {% endcall %}
    </div>
  {% endset %}

  {% set rtl_hebrew %}
    <div dir="rtl">
      {% call form(extra_class="needs-validation", novalidate=true) %}
        {% call fieldset("פרופיל חשבון", description="עדכן את הפרטים שהצוות רואה בכלי הפרויקט המשותפים.") %}
          {% call field_group() %}
            {% call field() %}
              {{ input(label="שם תצוגה", id="form-rtl-hebrew-name", placeholder="נועה לוי", required=true) }}
            {% endcall %}
            {% call field() %}
              {{ select(label="תור ברירת מחדל", id="form-rtl-hebrew-queue", options=[
                {"value": "", "label": "בחר תור", "disabled": true},
                {"value": "ops", "label": "תפעול"},
                {"value": "support", "label": "תמיכה"},
                {"value": "finance", "label": "כספים"}
              ], selected="ops", dir="rtl") }}
            {% endcall %}
          {% endcall %}
        {% endcall %}
        <div class="d-flex flex-wrap gap-2">
          {{ button("שמור שינויים", type="submit") }}
          {{ button("איפוס", variant="outline", type="reset") }}
        </div>
      {% endcall %}
    </div>
  {% endset %}

  {% set rtl_english %}
    <div dir="ltr">
      {% call form(extra_class="needs-validation", novalidate=true) %}
        {% call fieldset("Account profile", description="Update the details teammates see in shared project tools.") %}
          {% call field_group() %}
            {% call field() %}
              {{ input(label="Display name", id="form-rtl-english-name", placeholder="Ada Lovelace", required=true) }}
            {% endcall %}
            {% call field() %}
              {{ select(label="Default queue", id="form-rtl-english-queue", options=[
                {"value": "", "label": "Choose queue", "disabled": true},
                {"value": "ops", "label": "Operations"},
                {"value": "support", "label": "Support"},
                {"value": "finance", "label": "Finance"}
              ], selected="ops", dir="ltr") }}
            {% endcall %}
          {% endcall %}
        {% endcall %}
        <div class="d-flex flex-wrap gap-2">
          {{ button("Save changes", type="submit") }}
          {{ button("Reset", variant="outline", type="reset") }}
        </div>
      {% endcall %}
    </div>
  {% endset %}
  {{ render_rtl_example(
    "form-profile",
    "Compare the same account profile form across Arabic and Hebrew RTL examples, with English as the LTR comparison.",
    rtl_arabic,
    rtl_hebrew,
    rtl_english,
    preview_class="moo-example__preview--narrow",
    example_prefix="form-rtl"
  ) }}
</div>

{{ render_reference(
"For Bootstrap's underlying form controls, layout, validation, and accessibility model, see the",
"https://getbootstrap.com/docs/5.3/forms/overview/",
"Bootstrap Forms documentation"
) }}

{% endblock %}
