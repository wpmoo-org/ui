{% extends "layouts/catalog.html.jinja" %}
{% from "components/card.html.jinja" import card %}
{% from "components/tabs.html.jinja" import tabs %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_rtl_example with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Tabs — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Tabs",
    "Switch between compact operational views with Bootstrap's native tab behavior."
  ) }}

  <div class="moo-component-examples">
    {% set intro_overview %}
      {% call card("Connected panels", "Each trigger points at one tab panel and the active panel stays visible.", size="sm") %}
        <p class="mb-0 text-body-secondary">Keep labels short so the tab list remains quick to scan.</p>
      {% endcall %}
    {% endset %}
    {% set intro_activation %}
      {% call card("Click activation", "A tab changes state only after it is selected by click or keyboard.", size="sm") %}
        <p class="mb-0 text-body-secondary">Hover can hint at interactivity without looking like the active tab.</p>
      {% endcall %}
    {% endset %}
    {% set intro_panels %}
      {% call card("Panel content", "Use panels for peer views that can be shown one at a time.", size="sm") %}
        <p class="mb-0 text-body-secondary">Keep required sequential steps outside inactive tabs.</p>
      {% endcall %}
    {% endset %}
    {% set intro %}
      <div class="moo-example__preview-frame">
        {{ tabs(
          "tabs-intro",
          [
            {"id": "overview", "title": "Overview", "content": intro_overview},
            {"id": "activation", "title": "Activation", "content": intro_activation},
            {"id": "panels", "title": "Panels", "content": intro_panels}
          ]
        ) }}
      </div>
    {% endset %}
    {% set tabs_usage %}
      <p>Use <code>.nav-tabs</code> or <code>.nav-pills</code> for peer panels where one view should be visible at a time. Connect each tab trigger to exactly one <code>.tab-pane</code>, keep labels short, and keep the selected trigger and visible panel in sync with Bootstrap's tab behavior.</p>
      <p>Tabs should activate when selected by click or keyboard, not merely on hover. Hover can show a subtle affordance, but the active visual state belongs only to the selected tab and its panel.</p>
      <p>Use horizontal tabs for compact peer views and vertical tabs when labels scan better as a side rail. Keep required sequential steps outside inactive panels, because hidden tab content should not block users from completing the current task.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      tabs_usage,
      "moo-example__preview--narrow"
    ) }}

    {% set operational_views %}
      {{ tabs(
        "tabs-operational",
        [
          {
            "id": "overview",
            "title": "Overview",
            "content": "Track open requests, risk flags, and handoff status."
          },
          {
            "id": "workflows",
            "title": "Workflows",
            "content": "Move items through review lanes with minimal context switching."
          },
          {
            "id": "settings",
            "title": "Settings",
            "content": "Set locale, notifications, and digest frequency from one place."
          }
        ]
      ) }}
    {% endset %}
    {{ render_component_example("tabs", "Tabs",
      "operational-views",
      "Operational views",
      "Use tab sets when users need to move between related operational surfaces quickly.",
      operational_views,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set vertical_structure %}
      {% call card("Stacked triggers", "Use a vertical tab list when labels scan better as a short side rail.", size="sm") %}
        <p class="mb-0 text-body-secondary">The tablist keeps the same tab roles while adding vertical orientation.</p>
      {% endcall %}
    {% endset %}
    {% set vertical_keyboard %}
      {% call card("Keyboard state", "Bootstrap keeps one active tab in the roving focus order.", size="sm") %}
        <p class="mb-0 text-body-secondary">The selected trigger and visible panel update together after activation.</p>
      {% endcall %}
    {% endset %}
    {% set vertical_panels %}
      {% call card("Panel width", "Let the active panel use the remaining inline space.", size="sm") %}
        <p class="mb-0 text-body-secondary">Keep each panel self-contained so switching tabs does not require extra context.</p>
      {% endcall %}
    {% endset %}
    {% set vertical %}
      <div class="moo-example__preview-frame moo-example__preview-frame--wide">
        {{ tabs(
          "tabs-vertical",
          [
            {"id": "structure", "title": "Structure", "content": vertical_structure},
            {"id": "keyboard", "title": "Keyboard", "content": vertical_keyboard},
            {"id": "panels", "title": "Panels", "content": vertical_panels}
          ],
          orientation="vertical"
        ) }}
      </div>
    {% endset %}
    {{ render_component_example("tabs", "Tabs",
      "vertical",
      "Vertical",
      "Set <code>orientation=\"vertical\"</code> when the tab triggers should stack beside the active panel.",
      vertical,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set disabled %}
      {{ tabs(
        "tabs-disabled",
        [
          {
            "id": "active",
            "title": "Active",
            "content": "Open requests can be edited and reassigned from here."
          },
          {
            "id": "locked",
            "title": "Locked",
            "content": "Historical items stay locked for audit safety.",
            "disabled": true
          },
          {
            "id": "archive",
            "title": "Archive",
            "content": "Completed cases remain searchable in read-only mode."
          }
        ]
      ) }}
    {% endset %}
    {{ render_component_example("tabs", "Tabs",
      "disabled",
      "Disabled",
      "Set <code>disabled</code> on an item to remove it from keyboard and pointer interaction.",
      disabled,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set rtl_arabic_overview %}
      {% call card("لوحات مرتبطة", "يشير كل تبويب إلى لوحة محتوى واحدة وتبقى اللوحة النشطة ظاهرة.", size="sm") %}
        <p class="mb-0 text-body-secondary">اجعل عناوين التبويبات قصيرة حتى تبقى سهلة المسح.</p>
      {% endcall %}
    {% endset %}
    {% set rtl_arabic_activation %}
      {% call card("تفعيل بالنقر", "يتغير التبويب النشط فقط بعد اختياره بالنقر أو لوحة المفاتيح.", size="sm") %}
        <p class="mb-0 text-body-secondary">يبقى التحويم خفيفا ولا يبدو كأنه الحالة النشطة.</p>
      {% endcall %}
    {% endset %}
    {% set rtl_arabic_panels %}
      {% call card("محتوى اللوحة", "استخدم اللوحات لواجهات متوازية تظهر واحدة في كل مرة.", size="sm") %}
        <p class="mb-0 text-body-secondary">اترك الخطوات المطلوبة خارج التبويبات غير النشطة.</p>
      {% endcall %}
    {% endset %}
    {% set tabs_rtl_arabic %}
      <div dir="rtl">
        <div class="moo-example__preview-frame">
          {{ tabs(
            "tabs-rtl-overview-arabic",
            [
              {"id": "overview", "title": "نظرة عامة", "content": rtl_arabic_overview},
              {"id": "activation", "title": "التفعيل", "content": rtl_arabic_activation},
              {"id": "panels", "title": "اللوحات", "content": rtl_arabic_panels}
            ]
          ) }}
        </div>
      </div>
    {% endset %}

    {% set rtl_hebrew_overview %}
      {% call card("פאנלים מחוברים", "כל טריגר מצביע אל פאנל תוכן אחד והפאנל הפעיל נשאר גלוי.", size="sm") %}
        <p class="mb-0 text-body-secondary">שמור על תוויות קצרות כדי שרשימת הטאבים תיסרק במהירות.</p>
      {% endcall %}
    {% endset %}
    {% set rtl_hebrew_activation %}
      {% call card("הפעלה בלחיצה", "טאב משנה מצב רק אחרי בחירה בלחיצה או במקלדת.", size="sm") %}
        <p class="mb-0 text-body-secondary">ריחוף נשאר עדין ולא נראה כמו הטאב הפעיל.</p>
      {% endcall %}
    {% endset %}
    {% set rtl_hebrew_panels %}
      {% call card("תוכן הפאנל", "השתמש בפאנלים עבור תצוגות מקבילות שמופיעות אחת בכל פעם.", size="sm") %}
        <p class="mb-0 text-body-secondary">השאר שלבים הכרחיים מחוץ לטאבים לא פעילים.</p>
      {% endcall %}
    {% endset %}
    {% set tabs_rtl_hebrew %}
      <div dir="rtl">
        <div class="moo-example__preview-frame">
          {{ tabs(
            "tabs-rtl-overview-hebrew",
            [
              {"id": "overview", "title": "סקירה כללית", "content": rtl_hebrew_overview},
              {"id": "activation", "title": "הפעלה", "content": rtl_hebrew_activation},
              {"id": "panels", "title": "פאנלים", "content": rtl_hebrew_panels}
            ]
          ) }}
        </div>
      </div>
    {% endset %}

    {% set rtl_english_overview %}
      {% call card("Connected panels", "Each trigger points at one tab panel and the active panel stays visible.", size="sm") %}
        <p class="mb-0 text-body-secondary">Keep labels short so the tab list remains quick to scan.</p>
      {% endcall %}
    {% endset %}
    {% set rtl_english_activation %}
      {% call card("Click activation", "A tab changes state only after it is selected by click or keyboard.", size="sm") %}
        <p class="mb-0 text-body-secondary">Hover can hint at interactivity without looking like the active tab.</p>
      {% endcall %}
    {% endset %}
    {% set rtl_english_panels %}
      {% call card("Panel content", "Use panels for peer views that can be shown one at a time.", size="sm") %}
        <p class="mb-0 text-body-secondary">Keep required sequential steps outside inactive tabs.</p>
      {% endcall %}
    {% endset %}
    {% set tabs_rtl_english %}
      <div dir="ltr">
        <div class="moo-example__preview-frame">
          {{ tabs(
            "tabs-rtl-overview-english",
            [
              {"id": "overview", "title": "Overview", "content": rtl_english_overview},
              {"id": "activation", "title": "Activation", "content": rtl_english_activation},
              {"id": "panels", "title": "Panels", "content": rtl_english_panels}
            ]
          ) }}
        </div>
      </div>
    {% endset %}

    {{ render_rtl_example(
      "tabs",
      "RTL",
      tabs_rtl_arabic,
      tabs_rtl_hebrew,
      tabs_rtl_english,
      preview_class="moo-example__preview--narrow"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's Tab plugin behavior and keyboard interaction, see the",
    "https://getbootstrap.com/docs/5.3/components/navs-tab/",
    "Bootstrap Navs and tabs documentation"
  ) }}

{% endblock %}
