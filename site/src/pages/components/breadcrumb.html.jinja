{% extends "layouts/catalog.html.jinja" %}
{% from "components/breadcrumb.html.jinja" import breadcrumb %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_example, render_rtl_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Breadcrumb — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Breadcrumb",
    "Indicate the current page's location within a hierarchy using Bootstrap's native breadcrumb list."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      {{ breadcrumb([
        {"label": "Home", "href": "#"},
        {"label": "Components", "href": "#"},
        {"label": "Breadcrumb"}
      ]) }}
    {% endset %}
    {{ render_component_intro(
      intro,
      "Wrap the breadcrumb list in a labelled <code>nav</code>, render each parent as a link, and render the current page as the final item with <code>aria-current=\"page\"</code>. Keep labels short and avoid adding unrelated actions inside the breadcrumb trail."
    ) }}

    {% set trail %}
      {{ breadcrumb([
        {"label": "Workspace", "href": "#"},
        {"label": "Projects", "href": "#"},
        {"label": "Growth dashboard"}
      ]) }}
    {% endset %}
    {{ render_example(
      "trail",
      "Trail",
      "Every item but the last links back up the hierarchy; the last item marks <code>aria-current=\"page\"</code>.",
      trail
    ) }}

    {% set custom_separator %}
      {{ breadcrumb([
        {"label": "Workspace", "href": "#"},
        {"label": "Projects", "href": "#"},
        {"label": "Growth dashboard"}
      ], divider="•") }}
    {% endset %}
    {{ render_example(
      "custom-separator",
      "Custom separator",
      "Swap the divider glyph per instance through Bootstrap's own --bs-breadcrumb-divider custom property.",
      custom_separator
    ) }}

    {% set dropdown_example %}
      {{ breadcrumb([
        {"label": "Home", "href": "#"},
        {"label": "Components", "dropdown_items": [
          {"label": "Documentation", "href": "#"},
          {"label": "Themes", "href": "#"},
          {"label": "GitHub", "href": "#"}
        ]},
        {"label": "Breadcrumb"}
      ], divider="•") }}
    {% endset %}
    {{ render_example(
      "dropdown",
      "Dropdown",
      "Let a middle segment open a menu of sibling sections instead of linking to just one.",
      dropdown_example
    ) }}

    {% set collapsed %}
      {{ breadcrumb([
        {"label": "Workspace", "href": "#"},
        {"ellipsis": true},
        {"label": "Projects", "href": "#"},
        {"label": "Growth dashboard"}
      ]) }}
    {% endset %}
    {{ render_example(
      "collapsed",
      "Collapsed",
      "Mark skipped levels with an ellipsis segment when the full trail would crowd the layout.",
      collapsed
    ) }}

    {% set arabic_breadcrumb %}
      <div dir="rtl">
        {{ breadcrumb([
          {"label": "الرئيسية", "href": "#"},
          {"label": "المكونات", "dropdown_items": [
            {"label": "التوثيق", "href": "#"},
            {"label": "السمات", "href": "#"},
            {"label": "GitHub", "href": "#"}
          ]},
          {"label": "مسار التنقل"}
        ], divider="•") }}
      </div>
    {% endset %}

    {% set hebrew_breadcrumb %}
      <div dir="rtl">
        {{ breadcrumb([
          {"label": "בית", "href": "#"},
          {"label": "רכיבים", "dropdown_items": [
            {"label": "תיעוד", "href": "#"},
            {"label": "ערכות נושא", "href": "#"},
            {"label": "GitHub", "href": "#"}
          ]},
          {"label": "פירורי לחם"}
        ], divider="•") }}
      </div>
    {% endset %}

    {% set english_breadcrumb %}
      <div dir="ltr">
        {{ breadcrumb([
          {"label": "Home", "href": "#"},
          {"label": "Components", "dropdown_items": [
            {"label": "Documentation", "href": "#"},
            {"label": "Themes", "href": "#"},
            {"label": "GitHub", "href": "#"}
          ]},
          {"label": "Breadcrumb"}
        ], divider="•") }}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "breadcrumb",
      "Use tabs to compare Arabic, Hebrew, and English breadcrumb trails with a dropdown segment and custom separator.",
      arabic_breadcrumb,
      hebrew_breadcrumb,
      english_breadcrumb,
      preview_class="moo-example__preview--fit"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and divider customization, see the",
    "https://getbootstrap.com/docs/5.3/components/breadcrumb/",
    "Bootstrap Breadcrumb documentation"
  ) }}

{% endblock %}
