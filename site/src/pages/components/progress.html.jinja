{% extends "layouts/catalog.html.jinja" %}
{% from "components/progress.html.jinja" import progress %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_rtl_example with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Progress — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Progress",
    "Show the completion progress of a task using Bootstrap's native progress bar."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      <div class="w-100">
        {{ progress(64, aria_label="Upload progress", show_label=true) }}
      </div>
    {% endset %}
    {% set progress_usage %}
      <p>Use <code>.progress</code> and <code>.progress-bar</code> when completion can be measured as a value between a minimum and maximum. Render the bar with an accessible label, set the current value and maximum, and show nearby text when users need the task name, percentage, or status outside the visual track.</p>
      <p>Keep the progress bar itself simple: Bootstrap drives the fill from width, supports labels when the bar is tall enough, and can stack multiple bars when the same track represents related segments. Moo UI uses a slim track, so readable labels belong beside or above the bar rather than inside it.</p>
      <p>Use contextual color only when it communicates real state, and never rely on color alone. If the amount of work cannot be measured, use Spinner or a loading state instead of showing a fake percentage.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      progress_usage,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set default %}
      <div class="w-100">
        {{ progress(66, aria_label="Upload progress") }}
      </div>
    {% endset %}
    {{ render_component_example("progress", "Progress",
      "default",
      "Default",
      "A slim, rounded bar; the fill width is driven entirely by <code>value</code>/<code>max</code>.",
      default,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set values %}
      <div class="d-grid gap-3">
        {{ progress(20, aria_label="Step 1 progress") }}
        {{ progress(50, aria_label="Step 2 progress") }}
        {{ progress(90, aria_label="Step 3 progress") }}
      </div>
    {% endset %}
    {{ render_component_example("progress", "Progress",
      "values",
      "Values",
      "Stack several bars to compare progress across related tasks.",
      values,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set with_label %}
      <div class="w-100">
        {{ progress(40, aria_label="Download progress", show_label=true) }}
      </div>
    {% endset %}
    {{ render_component_example("progress", "Progress",
      "with-label",
      "With label",
      "Set <code>show_label=true</code> to render the name and percentage above the bar; the 4px track is too thin for readable inline text.",
      with_label,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set arabic_progress %}
      <div dir="rtl" class="w-100">
        {{ progress(40, aria_label="تقدم التنزيل", show_label=true) }}
      </div>
    {% endset %}
    {% set hebrew_progress %}
      <div dir="rtl" class="w-100">
        {{ progress(40, aria_label="התקדמות ההורדה", show_label=true) }}
      </div>
    {% endset %}
    {% set english_progress %}
      <div dir="ltr" class="w-100">
        {{ progress(40, aria_label="Download progress", show_label=true) }}
      </div>
    {% endset %}
    {{ render_rtl_example(
      id="progress",
      description="Use tabs to compare Arabic, Hebrew, and English progress bars with the fill growing from the reading-direction start.",
      arabic=arabic_progress,
      hebrew=hebrew_progress,
      english=english_progress,
      preview_class="moo-example__preview--narrow"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and stacked/striped/animated variants, see the",
    "https://getbootstrap.com/docs/5.3/components/progress/",
    "Bootstrap Progress documentation"
  ) }}

{% endblock %}
