{% extends "layouts/catalog.html.jinja" %}
{% from "components/data_table.html.jinja" import data_table %}
{% from "components/table.html.jinja" import table_row_actions %}
{% from "components/dropdown_menu.html.jinja" import dropdown_item, dropdown_divider %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Data Table — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Data Table",
    "A sortable, filterable, paginated table composed from the ready Table, Checkbox, Dropdown Menu, Select, and Pagination contracts."
  ) }}

  {% set statuses = [
    {"value": "open", "label": "Open", "icon": "circle"},
    {"value": "in-progress", "label": "In Progress", "icon": "circle-dashed"},
    {"value": "waiting", "label": "Waiting", "icon": "circle-pause"},
    {"value": "resolved", "label": "Resolved", "icon": "circle-check"},
    {"value": "closed", "label": "Closed", "icon": "circle-x"}
  ] %}
  {% set priorities = [
    {"value": "low", "label": "Low", "icon": "arrow-down"},
    {"value": "medium", "label": "Medium", "icon": "arrow-right"},
    {"value": "high", "label": "High", "icon": "arrow-up"},
    {"value": "urgent", "label": "Urgent", "icon": "chevrons-up"}
  ] %}
  {% set status_by_value = {} %}
  {% for status in statuses %}{% set _ = status_by_value.update({status.value: status}) %}{% endfor %}
  {% set priority_by_value = {} %}
  {% for priority in priorities %}{% set _ = priority_by_value.update({priority.value: priority}) %}{% endfor %}
  {% set priority_rank = {"low": 0, "medium": 1, "high": 2, "urgent": 3} %}
  {% set status_rank = {"open": 0, "in-progress": 1, "waiting": 2, "resolved": 3, "closed": 4} %}

  {% set tickets = [
    {"id": "TCK-1042", "subject": "Login redirect loops back to the sign-in page", "status": "open", "priority": "urgent"},
    {"id": "TCK-1038", "subject": "Export to CSV drops the last column", "status": "in-progress", "priority": "high"},
    {"id": "TCK-1035", "subject": "Dashboard widgets misaligned on narrow screens", "status": "waiting", "priority": "medium"},
    {"id": "TCK-1029", "subject": "Invoice totals rounded incorrectly for JPY", "status": "resolved", "priority": "high"},
    {"id": "TCK-1024", "subject": "Slack notifications arrive twice", "status": "closed", "priority": "low"},
    {"id": "TCK-1019", "subject": "Cannot remove a teammate from a shared workspace", "status": "open", "priority": "high"},
    {"id": "TCK-1017", "subject": "Search index missing newly imported contacts", "status": "in-progress", "priority": "urgent"},
    {"id": "TCK-1013", "subject": "Dark mode toggle resets on page reload", "status": "resolved", "priority": "low"},
    {"id": "TCK-1010", "subject": "API rate limit error message is unclear", "status": "waiting", "priority": "low"},
    {"id": "TCK-1006", "subject": "Bulk delete does not ask for confirmation", "status": "open", "priority": "medium"},
    {"id": "TCK-0998", "subject": "Custom domain SSL certificate fails to renew", "status": "in-progress", "priority": "urgent"},
    {"id": "TCK-0991", "subject": "Timezone offset wrong for calendar invites", "status": "resolved", "priority": "medium"},
    {"id": "TCK-0987", "subject": "Onboarding checklist stuck at 90%", "status": "closed", "priority": "medium"},
    {"id": "TCK-0982", "subject": "Two-factor recovery codes are not downloadable", "status": "open", "priority": "high"},
    {"id": "TCK-0975", "subject": "Billing page shows a stale card after update", "status": "waiting", "priority": "medium"},
    {"id": "TCK-0968", "subject": "Comment mentions do not trigger an email", "status": "in-progress", "priority": "low"},
    {"id": "TCK-0961", "subject": "Table sort arrow points the wrong way after reload", "status": "resolved", "priority": "low"},
    {"id": "TCK-0954", "subject": "Webhook retries stop after a single failure", "status": "open", "priority": "urgent"},
    {"id": "TCK-0949", "subject": "Avatar upload rejects valid PNG files", "status": "closed", "priority": "low"},
    {"id": "TCK-0942", "subject": "Keyboard shortcut for search conflicts with browser find", "status": "waiting", "priority": "medium"},
    {"id": "TCK-0937", "subject": "Report scheduler skips the last day of the month", "status": "in-progress", "priority": "high"},
    {"id": "TCK-0930", "subject": "Guest users can see archived projects", "status": "open", "priority": "high"},
    {"id": "TCK-0924", "subject": "Currency symbol missing on the pricing page", "status": "resolved", "priority": "low"},
    {"id": "TCK-0918", "subject": "Session expires mid-form and discards input", "status": "open", "priority": "urgent"}
  ] %}

  <div class="moo-component-examples">
    {% set ticket_rows = [] %}
    {% for ticket in tickets %}
      {% set status = status_by_value[ticket.status] %}
      {% set priority = priority_by_value[ticket.priority] %}
      {% set status_cell %}
        <span class="d-inline-flex align-items-center gap-1 text-body-secondary text-nowrap">{{ render_icon(status.icon, "inline-start") }}<span>{{ status.label }}</span></span>
      {% endset %}
      {% set priority_cell %}
        <span class="d-inline-flex align-items-center gap-1 text-body-secondary text-nowrap">{{ render_icon(priority.icon, "inline-start") }}<span>{{ priority.label }}</span></span>
      {% endset %}
      {% set actions_cell %}
        {% call table_row_actions(aria_label="Open ticket actions") %}
          {{ dropdown_item("Edit", icon="pencil") }}
          {{ dropdown_item("Assign to me", icon="user-plus") }}
          {{ dropdown_item("Duplicate", icon="copy") }}
          {{ dropdown_divider() }}
          {{ dropdown_item("Archive", icon="archive", destructive=true) }}
        {% endcall %}
      {% endset %}
      {% set _ = ticket_rows.append({
        "id": "ticket-" ~ ticket.id | lower | replace("tck-", ""),
        "search": ticket.id ~ " " ~ ticket.subject,
        "facets": {"status": ticket.status, "priority": ticket.priority},
        "sort": {
          "ticket": ticket.id,
          "subject": ticket.subject | lower,
          "status": status_rank[ticket.status],
          "priority": priority_rank[ticket.priority]
        },
        "cells": {
          "ticket": '<span class="font-monospace small">' ~ ticket.id ~ "</span>",
          "subject": '<span class="d-block text-truncate">' ~ ticket.subject ~ "</span>",
          "status": status_cell,
          "priority": priority_cell,
          "actions": actions_cell
        }
      }) %}
    {% endfor %}

    {% set basic %}
      {{ data_table(
        "data-table-tickets",
        columns=[
          {"key": "ticket", "label": "Ticket", "width": "7rem"},
          {"key": "subject", "label": "Subject"},
          {"key": "status", "label": "Status", "width": "9rem"},
          {"key": "priority", "label": "Priority", "width": "8rem"},
          {"key": "actions", "label": "Actions", "sortable": false, "hideable": false, "align": "end", "width": "4rem"}
        ],
        rows=ticket_rows,
        facets=[
          {
            "key": "status",
            "label": "Status",
            "options": [
              {"value": "open", "label": "Open", "icon": "circle", "count": tickets | selectattr("status", "equalto", "open") | list | length},
              {"value": "in-progress", "label": "In Progress", "icon": "circle-dashed", "count": tickets | selectattr("status", "equalto", "in-progress") | list | length},
              {"value": "waiting", "label": "Waiting", "icon": "circle-pause", "count": tickets | selectattr("status", "equalto", "waiting") | list | length},
              {"value": "resolved", "label": "Resolved", "icon": "circle-check", "count": tickets | selectattr("status", "equalto", "resolved") | list | length},
              {"value": "closed", "label": "Closed", "icon": "circle-x", "count": tickets | selectattr("status", "equalto", "closed") | list | length}
            ]
          },
          {
            "key": "priority",
            "label": "Priority",
            "options": [
              {"value": "low", "label": "Low", "icon": "arrow-down", "count": tickets | selectattr("priority", "equalto", "low") | list | length},
              {"value": "medium", "label": "Medium", "icon": "arrow-right", "count": tickets | selectattr("priority", "equalto", "medium") | list | length},
              {"value": "high", "label": "High", "icon": "arrow-up", "count": tickets | selectattr("priority", "equalto", "high") | list | length},
              {"value": "urgent", "label": "Urgent", "icon": "chevrons-up", "count": tickets | selectattr("priority", "equalto", "urgent") | list | length}
            ]
          }
        ],
        search_placeholder="Filter by subject or ID...",
        default_page_size=10
      ) }}
    {% endset %}
    {{ render_example(
      "basic",
      "Basic",
      "Search, faceted Status/Priority filters, sortable column headers, column visibility, row selection, row actions, and pagination all compose from ready Moo contracts over Bootstrap's own dropdown, form-check, and pagination markup.",
      basic
    ) }}
  </div>

  {{ render_reference(
    "Data Table composes Bootstrap's table, dropdown, form, and pagination markup; for the underlying primitives see the",
    "https://getbootstrap.com/docs/5.3/content/tables/",
    "Bootstrap Tables documentation"
  ) }}

{% endblock %}
