{% extends "layouts/catalog.html.jinja" %}
{% from "components/button.html.jinja" import button %}
{% from "components/spinner.html.jinja" import spinner %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_rtl_example with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Spinner — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Spinner",
    "Show an indeterminate loading state using the same loader-circle icon as the reference, spun with Bootstrap's own animation."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      <div class="d-flex align-items-center gap-2">
        {{ spinner(aria_label="Loading updates") }}
        <span>Loading updates</span>
      </div>
    {% endset %}
    {% set spinner_usage %}
      <p>Use <code>.spinner-border</code> or <code>.spinner-grow</code> for indeterminate loading: work is happening, but completion cannot be measured as a percentage. Render it with <code>role="status"</code> or an accessible loading label, and pair it with visible text when the wait affects surrounding content.</p>
      <p>Bootstrap spinners are built with HTML and CSS, use <code>currentColor</code>, and do not need JavaScript to animate. Use utilities to align, recolor, or size them, and use the small variant inside buttons or dense inline controls.</p>
      <p>Use <code>.progress</code> instead when completion can be measured. When a spinner replaces a button label, disable the action while it is running and keep the label clear enough that users know what is still in progress.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      spinner_usage,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set default %}
      {{ spinner() }}
    {% endset %}
    {{ render_component_example("spinner", "Spinner",
      "default",
      "Default",
      "A rotating <code>loader-circle</code> icon built from <code>currentColor</code>, so it adapts to any theme without extra CSS.",
      default
    ) }}

    {% set small %}
      {{ spinner(size="sm") }}
    {% endset %}
    {{ render_component_example("spinner", "Spinner",
      "small",
      "Small",
      "Set <code>size=\"sm\"</code> to use inside compact contexts like buttons.",
      small
    ) }}

    {% set in_button %}
      <div class="d-flex gap-2">
        {{ button("Loading...", loading=true, disabled=true) }}
        {{ button("Please wait", variant="outline", loading=true, disabled=true) }}
      </div>
    {% endset %}
    {{ render_component_example("spinner", "Spinner",
      "button",
      "Button",
      "Set <code>loading=true</code> on a button to swap its leading icon for a spinner.",
      in_button
    ) }}

    {% set rtl_arabic %}
      <div class="d-flex align-items-center gap-2" dir="rtl">
        {{ spinner(aria_label="جارٍ تحميل التحديثات") }}
        <span>جارٍ تحميل التحديثات</span>
      </div>
    {% endset %}

    {% set rtl_hebrew %}
      <div class="d-flex align-items-center gap-2" dir="rtl">
        {{ spinner(aria_label="טוען עדכונים") }}
        <span>טוען עדכונים</span>
      </div>
    {% endset %}

    {% set rtl_english %}
      <div class="d-flex align-items-center gap-2" dir="ltr">
        {{ spinner(aria_label="Loading updates") }}
        <span>Loading updates</span>
      </div>
    {% endset %}

    {{ render_rtl_example(
      "spinner",
      "Use the same loading row translated exactly into Arabic, Hebrew, and English; the spinner itself has no directional geometry, so only the label and its order change.",
      rtl_arabic,
      rtl_hebrew,
      rtl_english
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and reduced-motion handling, see the",
    "https://getbootstrap.com/docs/5.3/components/spinners/",
    "Bootstrap Spinners documentation"
  ) }}

{% endblock %}
