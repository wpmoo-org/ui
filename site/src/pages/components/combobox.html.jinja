{% block content %}
{{ render_page_header(
"Combobox",
"Autocomplete input for selecting one or more items from a suggestion list."
) }}

<div class="moo-component-examples">
  {% set intro %}
    {{ combobox(
      id="combobox-intro-reviewer",
      aria_label="Select reviewer",
      name="intro_reviewer",
      placeholder="Select a reviewer",
      items=reviewer_items
    ) }}
  {% endset %}
  {% set combobox_usage %}
    <p>Use <code>.combobox</code> when the user needs to search or filter a known list before choosing a value. Keep the text input focusable, give it <code>role="combobox"</code>, connect it to the popup with <code>aria-controls</code>, and expose the suggestion list as a listbox so keyboard and screen reader users can follow the active option.</p>
    <p>Use a visible label or clear accessible name, keep option values unique, and submit the selected value through normal form fields. For long lists, group options only when the grouping helps scanning; for multiple selection, keep selected chips short and make removal controls reachable from the keyboard.</p>
    <p>Combobox uses Bootstrap form-control and dropdown-menu surfaces, while the optional Moo UI runtime owns filtering, active-option movement, and selected-value synchronization. Load that runtime only on pages that need enhanced list behavior, and provide a native select or server-side fallback when JavaScript is unavailable.</p>
  {% endset %}
  {{ render_component_intro(
    intro,
    combobox_usage,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set basic %}
    {{ combobox(
      id="combobox-reviewer",
      aria_label="Select reviewer",
      name="reviewer",
      placeholder="Select a reviewer",
      items=reviewer_items
    ) }}
  {% endset %}
  {{ render_component_example("combobox", "Combobox",
    "basic",
    "Basic",
    "A single-line input with a flat suggestion list, matching the shadcn Basic combobox anatomy before any advanced variants are added.",
    basic,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set multiple %}
    {% call field(extra_class="w-100") %}
      {{ combobox(
        id="combobox-review-areas",
        label="Review areas",
        name="review_areas",
        describedby="combobox-review-areas-help",
        items=review_area_items,
        selected=["security", "billing", "ops"],
        multiple=true
      ) }}
      {{ field_description("combobox-review-areas-help", "Choose every area this review should cover.") }}
    {% endcall %}
  {% endset %}
  {{ render_component_example("combobox", "Combobox",
    "multiple",
    "Multiple",
    "A chip input that keeps multiple selected review areas in the same searchable suggestion list.",
    multiple,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set clear_button %}
    {{ combobox(
      id="combobox-clear-reviewer",
      aria_label="Reviewer with clear button",
      name="clear_reviewer",
      placeholder="Select a reviewer",
      items=reviewer_items,
      selected="ada",
      show_clear=true
    ) }}
  {% endset %}
  {{ render_component_example("combobox", "Combobox",
    "clear-button",
    "Clear Button",
    "A single-select combobox that reveals a clear button after a reviewer is selected.",
    clear_button,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set groups %}
    {{ combobox(
      id="combobox-timezone",
      aria_label="Timezone",
      name="timezone",
      placeholder="Select a timezone",
      items=timezone_items
    ) }}
  {% endset %}
  {{ render_component_example("combobox", "Combobox",
    "groups",
    "Groups",
    "Group related options with Bootstrap dropdown headers and dividers inside the listbox.",
    groups,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set custom_items %}
    {{ combobox(
      id="combobox-request-type",
      aria_label="Request type",
      name="request_type",
      placeholder="Search request types...",
      items=request_type_items
    ) }}
  {% endset %}
  {{ render_component_example("combobox", "Combobox",
    "custom-items",
    "Custom Items",
    "Show richer option rows with secondary text while keeping the same Bootstrap dropdown item structure.",
    custom_items,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set invalid %}
    {{ combobox(
      id="combobox-invalid-reviewer",
      aria_label="Invalid reviewer",
      name="invalid_reviewer",
      placeholder="Select a reviewer",
      items=reviewer_items,
      invalid=true
    ) }}
  {% endset %}
  {{ render_component_example("combobox", "Combobox",
    "invalid",
    "Invalid",
    "Use Bootstrap validation styling and aria-invalid for inputs that fail validation.",
    invalid,
    preview_class="moo-example__preview--narrow"
  ) }}

  {% set disabled %}
    {{ combobox(
      id="combobox-disabled-reviewer",
      aria_label="Disabled reviewer",
      name="disabled_reviewer",
      placeholder="Select a reviewer",
      items=reviewer_items,
      disabled=true
    ) }}
  {% endset %}
  {{ render_component_example("combobox", "Combobox",
    "disabled",
    "Disabled",
    "Disable the input when the combobox is unavailable.",
    disabled,
    preview_class="moo-example__preview--narrow"
  ) }}
</div>

<section class="moo-doc-section mt-5" aria-labelledby="combobox-javascript">
  {{ typography("JavaScript", variant="section-title", id="combobox-javascript") }}
  <p>
    Bootstrap 5.3 does not provide a Combobox plugin. Moo UI therefore owns the
    filtering, single and multiple selection, keyboard navigation, hidden value,
    and ARIA state behavior for this component only. It does not replace any
    Bootstrap plugin.
  </p>
  <p>
    Importing the optional module has no document-wide side effect. Initialize
    only a Combobox root your application owns; repeated initialization returns
    the same instance, and <code>dispose()</code> removes its listeners and
    generated runtime nodes.
  </p>
  {% set combobox_import_example %}
  import Combobox from "@wpmoo/ui/combobox.js";

  const element = document.querySelector(".combobox");

  if (element) {
    const combobox = Combobox.getOrCreateInstance(element);

    // Later, release listeners and generated runtime nodes.
    combobox.dispose();
  }
  {% endset %}
  {{ render_code_snippet("combobox-javascript-import", combobox_import_example, "js") }}
</section>

{{ render_reference(
"Combobox starts from Bootstrap's native form-control and dropdown menu contracts. For the underlying menu behavior, see the",
"https://getbootstrap.com/docs/5.3/components/dropdowns/",
"Bootstrap Dropdown documentation"
) }}

{% endblock %}
