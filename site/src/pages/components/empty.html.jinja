{% extends "layouts/catalog.html.jinja" %}
{% from "components/empty.html.jinja" import empty %}
{% from "components/button.html.jinja" import button %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_rtl_example with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}

{% block title %}Empty — Moo UI{% endblock %}
{% block content %}
  {{ render_page_header("Empty", "Explain an empty collection with a quiet dashed boundary and a useful next action.") }}
  <div class="moo-component-examples">
    {% set create_action %}{{ button("Create item", variant="outline") }}{% endset %}
    {% set collection_icon %}{{ render_icon("folder", "inline-start") }}{% endset %}
    {% set basic %}{{ empty("No items yet", description="Create your first item to get started.", icon=collection_icon, action=create_action) }}{% endset %}
    {% set usage %}
      <p><code>.empty-state</code> supplies the dashed border, rounded corners, centered layout and spacing. Its header, icon, title, description and action classes supply the standard appearance without additional utilities or JavaScript.</p>
      <p>Provide a title or description, and use a short action when the user can resolve the empty state. Omit the action when that capability is unavailable.</p>
      <p>Use Bootstrap utilities for additional styling. For example, <code>border-0</code> removes the boundary, <code>bg-body-tertiary</code> adds a surface, and <code>text-start align-items-start</code> gives a start-aligned variant. The <code>extra_class</code> macro argument adds these classes to the root. Directional text utilities follow the host's Bootstrap CSS distribution; an RTL host supplies its RTL utility definitions.</p>
      <p><code>icon</code> and <code>action</code> accept trusted captures from public components. The icon provider owns decorative accessibility; the standard icon frame sizes public <code>data-icon</code> captures. Plain strings are escaped; do not mark user-supplied markup safe.</p>
      <p>For filtered collections, explain that no results match and offer a filter reset. For an empty collection, explain how to create the first item. Native navigation, form ownership and permissions remain with the action and its host.</p>
    {% endset %}
    {{ render_component_intro(basic, usage) }}
    {{ render_component_example("empty", "Empty", "basic", "Empty collection", "A title, short explanation and optional action share a calm surface.", basic) }}
    {% set message_only %}{{ empty("No matching results", description="Try a different search.") }}{% endset %}
    {{ render_component_example("empty", "Empty", "message-only", "Message only", "Use a short explanation when no direct action is available.", message_only) }}
    {% set reset_action %}{{ button("Clear filters", variant="outline") }}{% endset %}
    {% set customized %}{{ empty("No matching results", description="Clear the filters to see all items.", action=reset_action, extra_class="border-0 bg-body-tertiary text-start align-items-start") }}{% endset %}
    {{ render_component_example("empty", "Empty", "utilities", "Utility customization", "Add Bootstrap utilities to the standard component for a different surface or alignment.", customized) }}
    {% set arabic_action %}{{ button("إنشاء عنصر", variant="outline") }}{% endset %}
    {% set hebrew_action %}{{ button("יצירת פריט", variant="outline") }}{% endset %}
    {% set arabic %}
      <div class="w-100" dir="rtl">{{ empty("لا توجد عناصر بعد", description="أنشئ أول عنصر للبدء.", icon=collection_icon, action=arabic_action) }}</div>
    {% endset %}
    {% set hebrew %}
      <div class="w-100" dir="rtl">{{ empty("עדיין אין פריטים", description="צרו פריט ראשון כדי להתחיל.", icon=collection_icon, action=hebrew_action) }}</div>
    {% endset %}
    {{ render_rtl_example("empty", "The same quiet composition follows the native reading direction.", arabic, hebrew, basic) }}
    {{ render_reference(
      "Empty is a Moo-owned static component. Its surface uses Bootstrap's shared border, radius and theme tokens; utility overrides follow",
      "https://getbootstrap.com/docs/5.3/utilities/borders/",
      "the Bootstrap border documentation",
      extra_references=[{
        "lead": "Its visual structure is informed by",
        "href": "https://ui.shadcn.com/docs/components/empty",
        "label": "the shadcn/ui Empty reference"
      }]
    ) }}
  </div>
{% endblock %}
