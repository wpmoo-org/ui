{% extends "layouts/catalog.html.jinja" %}
{% from "components/field.html.jinja" import field, field_description, field_group, fieldset %}
{% from "components/switch.html.jinja" import switch %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_rtl_example with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% macro switch_field(id, label, description="", checked=false, disabled=false, invalid=false) -%}
  {% set description_id = id ~ "-description" if description else "" %}
  {% set label_id = id ~ "-label" %}
  {% set field_extra_class = "field--switch" ~ (" field--disabled" if disabled else "") %}
  {% call field(extra_class=field_extra_class, invalid=invalid) %}
    <div>
      <label class="form-label" id="{{ label_id }}" for="{{ id }}">{{ label }}</label>
      {% if description %}{{ field_description(description_id, description) }}{% endif %}
    </div>
    {{ switch(
      id,
      labelledby=label_id,
      describedby=description_id,
      checked=checked,
      disabled=disabled,
      invalid=invalid,
      label_wrapper=true
    ) }}
  {% endcall %}
{%- endmacro %}

{% block title %}Switch — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Switch",
    "Activate feature flags and settings with Bootstrap's native form-switch control."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      {{ switch("switch-hero-notifications", label="Enable notifications") }}
    {% endset %}
    {% set switch_usage %}
      <p>Use <code>.form-switch</code> for a single setting that can be on or off and takes effect like a mode, preference, or feature flag. Render it as a native checkbox with <code>role="switch"</code>, keep the visible label tied to the input, and store the checked state on the native control.</p>
      <p>Use <code>.field</code> when the switch needs supporting copy, grouping, disabled state, or validation. The label should name the setting, while the description explains the consequence of turning it on or off; avoid writing a switch label as a question that becomes confusing in both states.</p>
      <p>Switches inherit the Bootstrap checks/radios contract through <code>.form-check</code> and <code>.form-switch</code>. Use disabled and invalid states on the input itself, and group related switches in a fieldset when they answer one larger settings question.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      switch_usage,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set description %}
      {% call fieldset("Focus sharing", description="Configure how focus mode follows you across devices.") %}
        {% call field_group() %}
          {{ switch_field(
            "switch-description",
            "Share across devices",
            "Focus is shared across devices, and turns off when you leave the app."
          ) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_component_example("switch", "Switch",
      "description",
      "Description",
      "Add supporting copy below the label with <code>description</code>.",
      description,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set disabled %}
      {% call fieldset("Authentication policy", description="Disabled switches show unavailable settings without changing layout.") %}
        {% call field_group() %}
          {{ switch_field("switch-disabled", "Force MFA at login", disabled=true) }}
          {{ switch_field("switch-disabled-checked", "Force MFA at login", checked=true, disabled=true) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_component_example("switch", "Switch",
      "disabled",
      "Disabled",
      "Disabled switches lower opacity and drop pointer interaction in both states.",
      disabled,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set invalid %}
      {% call fieldset("Terms acceptance", description="Use the same description layout when a switch needs validation feedback.") %}
        {% call field_group() %}
          {{ switch_field(
            "switch-invalid",
            "Accept terms and conditions",
            "You must accept the terms and conditions to continue.",
            invalid=true
          ) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_component_example("switch", "Switch",
      "invalid",
      "Invalid",
      "Set <code>invalid=true</code> to pair with a form's validation state.",
      invalid,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set rtl_arabic %}
      <div dir="rtl">
        {% call fieldset("تفضيلات الإشعارات", description="اختر كيفية عمل الإشعارات والمزامنة.") %}
          {% call field_group() %}
            {{ switch_field("switch-rtl-arabic-sync", "المزامنة في الخلفية", "حافظ على مزامنة بيانات الفريق عبر جميع الأجهزة بعد إعادة الاتصال بالشبكة.", checked=true) }}
            {{ switch_field("switch-rtl-arabic-notify", "تفعيل الإشعارات", "يمكنك تفعيل أو إلغاء تفعيل الإشعارات في أي وقت.") }}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {% set rtl_hebrew %}
      <div dir="rtl">
        {% call fieldset("העדפות התראות", description="בחר כיצד התראות וסנכרון יפעלו.") %}
          {% call field_group() %}
            {{ switch_field("switch-rtl-hebrew-sync", "סנכרון רקע", "שמור על נתוני הצוות מסונכרנים בכל המכשירים לאחר חיבור מחדש לרשת.", checked=true) }}
            {{ switch_field("switch-rtl-hebrew-notify", "הפעלת התראות", "ניתן להפעיל או לבטל התראות בכל עת.") }}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {% set rtl_english %}
      <div dir="ltr">
        {% call fieldset("Notification preferences", description="Choose how notifications and sync should behave.") %}
          {% call field_group() %}
            {{ switch_field("switch-rtl-english-sync", "Background sync", "Keep team data synchronized across all devices after a network reconnect.", checked=true) }}
            {{ switch_field("switch-rtl-english-notify", "Enable notifications", "You can enable or disable notifications at any time.") }}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "switch",
      "RTL",
      rtl_arabic,
      rtl_hebrew,
      rtl_english,
      preview_class="moo-example__preview--narrow"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and the shared form-check family, see the",
    "https://getbootstrap.com/docs/5.3/forms/checks-radios/",
    "Bootstrap Checks and radios documentation"
  ) }}

{% endblock %}
