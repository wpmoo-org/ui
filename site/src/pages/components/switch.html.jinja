{% extends "layouts/catalog.html.jinja" %}
{% from "components/switch.html.jinja" import switch %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_example, render_rtl_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Switch — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Switch",
    "Activate feature flags and settings with Bootstrap's native form-switch control."
  ) }}

  <div class="moo-component-examples">
    {# Hero preview: a comprehensive composition shown above the TOC sections,
       matching the reference's pattern of a live multi-variant preview at the top. #}
    <div class="moo-example__surface mb-5">
      <div class="moo-example__preview moo-example__preview--narrow">
        <div class="d-grid gap-3">
          {{ switch("switch-hero-sync", label="Background sync", description="Keep team data synchronized across all devices.", checked=true) }}
          {{ switch("switch-hero-notify", label="Enable notifications", description="Receive alerts when workflow status changes.") }}
          {{ switch("switch-hero-disabled", label="Force MFA at login", disabled=true) }}
        </div>
      </div>
    </div>

    {% set usage %}
      {{ switch("switch-usage", label="Enable workflow backup window") }}
    {% endset %}
    {{ render_example(
      "usage",
      "Usage",
      "A single switch toggles one option. Pair with a label so the hit target covers the text.",
      usage,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set description %}
      {{ switch(
        "switch-description",
        label="Background sync",
        description="Keep team data synchronized across all devices after a network reconnect.",
        checked=true
      ) }}
    {% endset %}
    {{ render_example(
      "description",
      "Description",
      "Add supporting copy below the label with <code>description</code>.",
      description,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set disabled %}
      <div class="d-grid gap-2">
        {{ switch("switch-disabled", label="Force MFA at login", disabled=true) }}
        {{ switch("switch-disabled-checked", label="Force MFA at login", checked=true, disabled=true) }}
      </div>
    {% endset %}
    {{ render_example(
      "disabled",
      "Disabled",
      "Disabled switches lower opacity and drop pointer interaction in both states.",
      disabled,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set invalid %}
      {{ switch("switch-invalid", label="Collect usage analytics", invalid=true) }}
    {% endset %}
    {{ render_example(
      "invalid",
      "Invalid",
      "Set <code>invalid=true</code> to pair with a form's validation state.",
      invalid,
      preview_class="moo-example__preview--narrow"
    ) }}

    {% set rtl_arabic %}
      <div class="d-grid gap-3" dir="rtl">
        {{ switch("switch-rtl-arabic-sync", label="المزامنة في الخلفية", description="حافظ على مزامنة بيانات الفريق عبر جميع الأجهزة بعد إعادة الاتصال بالشبكة.", checked=true, extra_class="form-check-reverse") }}
        {{ switch("switch-rtl-arabic-notify", label="تفعيل الإشعارات", description="يمكنك تفعيل أو إلغاء تفعيل الإشعارات في أي وقت.", extra_class="form-check-reverse") }}
      </div>
    {% endset %}

    {% set rtl_hebrew %}
      <div class="d-grid gap-3" dir="rtl">
        {{ switch("switch-rtl-hebrew-sync", label="סנכרון רקע", description="שמור על נתוני הצוות מסונכרנים בכל המכשירים לאחר חיבור מחדש לרשת.", checked=true, extra_class="form-check-reverse") }}
        {{ switch("switch-rtl-hebrew-notify", label="הפעלת התראות", description="ניתן להפעיל או לבטל התראות בכל עת.", extra_class="form-check-reverse") }}
      </div>
    {% endset %}

    {% set rtl_english %}
      <div class="d-grid gap-3" dir="ltr">
        {{ switch("switch-rtl-english-sync", label="Background sync", description="Keep team data synchronized across all devices after a network reconnect.", checked=true) }}
        {{ switch("switch-rtl-english-notify", label="Enable notifications", description="You can enable or disable notifications at any time.") }}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "switch",
      "RTL",
      rtl_arabic,
      rtl_hebrew,
      rtl_english,
      preview_class="moo-example__preview--narrow"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and the shared form-check family, see the",
    "https://getbootstrap.com/docs/5.3/forms/checks-radios/",
    "Bootstrap Checks and radios documentation"
  ) }}

{% endblock %}
