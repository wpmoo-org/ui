{% extends "layouts/catalog.html.jinja" %}
{% from "components/alert.html.jinja" import alert %}
{% from "components/button.html.jinja" import button %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_example, render_rtl_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Alert — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Alert",
    "Surface a contextual message with Bootstrap's native alert region."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      {{ alert(
        "Alert",
        description="Use for a short contextual message that belongs near the related content.",
        icon="info"
      ) }}
    {% endset %}
    {% set alert_usage %}
      <p>Use <code>.alert</code> for contextual feedback that should stay visible near the work it affects. Render the message in the alert region with a visible title, add supporting text only when the state needs explanation, and keep links or actions inside the alert body so they remain tied to the message.</p>
      <p>Choose a contextual variant such as <code>.alert-success</code>, <code>.alert-warning</code>, <code>.alert-danger</code>, or <code>.alert-info</code> when the message has a clear severity. Do not rely on color alone to communicate meaning; make the status clear in the visible copy, and use <code>.alert-link</code> when a link needs to inherit the alert's matching color treatment.</p>
      <p>For dismissible alerts, add <code>.alert-dismissible</code> and a close button with <code>data-bs-dismiss="alert"</code>; use <code>.fade</code> and <code>.show</code> only when the removal should animate. Bootstrap removes a dismissed alert from the page, so move focus to a sensible next target after <code>closed.bs.alert</code> when the close button was keyboard-operated.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      alert_usage,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set basic %}
      {{ alert(
        "Scheduled maintenance",
        description="The catalog will be briefly unavailable this weekend while we upgrade the build pipeline.",
        icon="info"
      ) }}
    {% endset %}
    {{ render_example(
      "basic",
      "Basic",
      "Pair an icon with a title and description inside a quiet bordered region.",
      basic,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set destructive %}
      {{ alert(
        "Build failed",
        description="The last commit broke two tests. Check the CI log for details.",
        variant="destructive",
        icon="circle-alert"
      ) }}
    {% endset %}
    {{ render_example(
      "destructive",
      "Destructive",
      "Use <code>variant=\"destructive\"</code> for errors that need immediate attention.",
      destructive,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set action %}
      {{ alert(
        "Storage limit approaching",
        description="This workspace has used 92% of its plan. Upgrade to avoid interrupted uploads.",
        icon="triangle-alert",
        action=button("Upgrade plan", variant="outline", size="sm")
      ) }}
    {% endset %}
    {{ render_example(
      "action",
      "Action",
      "Place one documented Button action inline with the alert message when a direct response is useful.",
      action,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set warning %}
      {{ alert(
        "Subscription renews in 3 days",
        description="Confirm your payment method so the workspace doesn't lose access when the trial ends.",
        variant="warning",
        icon="triangle-alert"
      ) }}
    {% endset %}
    {{ render_example(
      "warning",
      "Warning",
      "Use <code>variant=\"warning\"</code> for time-sensitive notices that need attention but aren't blocking.",
      warning,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set success %}
      {{ alert(
        "Access request approved",
        description="The reviewer granted workspace access. The requester can join within minutes.",
        variant="success",
        icon="circle-check"
      ) }}
    {% endset %}
    {{ render_example(
      "success",
      "Success",
      "Use <code>variant=\"success\"</code> to confirm a completed action or a positive state change.",
      success,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set info %}
      {{ alert(
        "New version available",
        description="Moo UI 1.1 ships a refreshed token palette. Review the changelog before upgrading.",
        variant="info",
        icon="sparkles"
      ) }}
    {% endset %}
    {{ render_example(
      "info",
      "Info",
      "Use <code>variant=\"info\"</code> for neutral, informational notices that don't require action.",
      info,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set dismissible %}
      {{ alert(
        "Preview images refreshed",
        description="Component preview thumbnails were regenerated for the latest release.",
        icon="info",
        dismissible=true
      ) }}
    {% endset %}
    {{ render_example(
      "dismissible",
      "Dismissible",
      "Add a Close Button; wire <code>data-bs-dismiss=\"alert\"</code> when the alert should remove itself.",
      dismissible,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set arabic_alert %}
      <div dir="rtl">
        {{ alert(
          "تمت الموافقة على الطلب",
          description="تمت مراجعة طلب الوصول وسيصل صاحبه إلى مساحة العمل خلال دقائق.",
          icon="info",
          dismissible=true
        ) }}
      </div>
    {% endset %}

    {% set hebrew_alert %}
      <div dir="rtl">
        {{ alert(
          "הבקשה אושרה",
          description="בקשת הגישה נבדקה והמשתמש יקבל גישה לסביבת העבודה בתוך דקות.",
          icon="info",
          dismissible=true
        ) }}
      </div>
    {% endset %}

    {% set english_rtl_alert %}
      <div dir="ltr">
        {{ alert(
          "Access request approved",
          description="The request was reviewed and the requester will reach the workspace within minutes.",
          icon="info",
          dismissible=true
        ) }}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "alert",
      "Use tabs to compare Arabic, Hebrew, and English alerts inside the same RTL layout.",
      arabic_alert,
      hebrew_alert,
      english_rtl_alert,
      preview_class="moo-example__preview--medium"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and contextual variants, see the",
    "https://getbootstrap.com/docs/5.3/components/alerts/",
    "Bootstrap Alerts documentation"
  ) }}

{% endblock %}
