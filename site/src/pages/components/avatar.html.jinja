{% extends "layouts/catalog.html.jinja" %}
{% from "components/avatar.html.jinja" import avatar %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_example, render_rtl_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Avatar — Moo UI{% endblock %}

{% block content %}
  {% set avatar_cangir = root_path ~ "assets/images/avatars/cangir.webp" %}
  {% set avatar_marina = root_path ~ "assets/images/avatars/cangir-marina.webp" %}
  {% set avatar_bull = root_path ~ "assets/images/avatars/bull.webp" %}

  {{ render_page_header(
    "Avatar",
    "Represent people, teams, or accounts with a compact image or initials fallback."
  ) }}

  <div class="moo-component-examples">
    {% set overview %}
      <div class="d-flex align-items-center gap-3">
        {{ avatar(
          name="Cangir",
          src=avatar_cangir,
          alt="Illustrated profile photo of Cangir",
          fallback="CA",
          badge_dot=true,
          badge_class="bg-success",
          badge_aria_label="Available"
        ) }}
        {{ avatar(
          name="Bull mascot",
          src=avatar_bull,
          alt="Black and white bull mascot avatar",
          fallback="BM",
          badge_icon="plus",
          badge_class="bg-primary text-white",
          badge_aria_label="Add mascot"
        ) }}
        <div class="avatar-group">
          {{ avatar(name="Cangir", src=avatar_cangir, alt="Illustrated profile photo of Cangir", fallback="CA") }}
          {{ avatar(name="Cangir at the marina", src=avatar_marina, alt="Profile photo of Cangir at a marina", fallback="CA") }}
          {{ avatar(name="Bull mascot", src=avatar_bull, alt="Black and white bull mascot avatar", fallback="BM") }}
          <span class="avatar avatar-count">3</span>
        </div>
      </div>
    {% endset %}
    {% set avatar_usage %}
      <p>Use <code>.avatar</code> to represent a person, team, account, or automated actor in a compact space. Bootstrap does not provide a native avatar component, so Moo UI keeps the shape as a documented extension while relying on ordinary image behavior: real photos render through an <code>img</code> element, stay constrained by the avatar container, and need meaningful <code>alt</code> text when the image identifies the subject.</p>
      <p>Render the image and initials fallback together so the fallback is ready when media fails or no image exists. Keep initials short, use an accessible name for fallback-only avatars, and avoid putting job titles or long status text inside the avatar itself; place that supporting copy next to the avatar where it can wrap normally.</p>
      <p>Attach small status badges to the avatar edge only when they add immediate meaning, and give dot or icon badges an accessible label. For avatar groups, keep the visible stack short, preserve each avatar's name, and add a count chip when the group hides additional people.</p>
    {% endset %}
    {{ render_component_intro(
      overview,
      avatar_usage
    ) }}

    {% set basic %}
      <div class="d-flex align-items-center gap-3">
        {{ avatar(name="Cangir at the marina", src=avatar_marina, alt="Profile photo of Cangir at a marina", fallback="CA") }}
        <div>
          <div class="fw-medium">Cangir</div>
          <div class="text-body-secondary small">Core maintainer</div>
        </div>
      </div>
    {% endset %}
    {{ render_example(
      "basic",
      "Basic",
      "Image avatars keep people recognizable while initials stay ready for missing media.",
      basic
    ) }}

    {% set fallback %}
      <div class="d-flex align-items-center gap-3">
        {{ avatar(name="Moo UI", initials="MU") }}
        <div>
          <div class="fw-medium">Moo UI</div>
          <div class="text-body-secondary small">Design system</div>
        </div>
      </div>
    {% endset %}
    {{ render_example(
      "fallback",
      "Fallback initials",
      "Use initials when no image is available. The fallback still needs an accessible name through <code>aria-label</code>.",
      fallback
    ) }}

    {% set badge %}
      <div class="d-flex align-items-center gap-3">
        {{ avatar(
          name="CNGR",
          src=avatar_cangir,
          alt="Illustrated profile photo of CNGR",
          fallback="CA",
          badge_dot=true,
          badge_class="bg-success",
          badge_aria_label="Available"
        ) }}
        <div>
          <div class="fw-medium">CNGR</div>
          <div class="text-body-secondary small">Available for review</div>
        </div>
      </div>
    {% endset %}
    {{ render_example(
      "badge",
      "Badge",
      "Use a small corner badge for queue status or attention counts without adding another column.",
      badge
    ) }}

    {% set badge_with_icon %}
      {{ avatar(
        name="Bull mascot",
        src=avatar_bull,
        alt="Black and white bull mascot avatar",
        fallback="BM",
        badge_icon="plus",
        badge_class="bg-primary text-white",
        badge_aria_label="Add mascot"
      ) }}
    {% endset %}
    {{ render_example(
      "badge-with-icon",
      "Badge with icon",
      "Use an icon badge when the avatar needs one compact action cue.",
      badge_with_icon
    ) }}

    {% set group %}
      <div class="d-flex flex-column align-items-start gap-3">
        <div class="avatar-group">
          {{ avatar(name="Cangir", src=avatar_cangir, alt="Illustrated profile photo of Cangir", fallback="CA") }}
          {{ avatar(name="Cangir at the marina", src=avatar_marina, alt="Profile photo of Cangir at a marina", fallback="CA") }}
          {{ avatar(name="Bull mascot", src=avatar_bull, alt="Black and white bull mascot avatar", fallback="BM") }}
        </div>
        <div class="text-body-secondary small">Workspace profiles</div>
      </div>
    {% endset %}
    {{ render_example(
      "group",
      "Avatar group",
      "Stack reviewer avatars to represent team ownership at a glance.",
      group
    ) }}

    {% set group_count %}
      <div class="d-flex flex-column align-items-start gap-3">
        <div class="avatar-group">
          {{ avatar(name="Cangir", src=avatar_cangir, alt="Illustrated profile photo of Cangir", fallback="CA") }}
          {{ avatar(name="Cangir at the marina", src=avatar_marina, alt="Profile photo of Cangir at a marina", fallback="CA") }}
          {{ avatar(name="Bull mascot", src=avatar_bull, alt="Black and white bull mascot avatar", fallback="BM") }}
          <span class="avatar avatar-count">3</span>
        </div>
        <div class="text-body-secondary small">Three shown, more collaborators off-screen</div>
      </div>
    {% endset %}
    {{ render_example(
      "group-count",
      "Avatar group count",
      "Use a grouped count chip when additional teammates are off-screen.",
      group_count
    ) }}

    {% set sizes %}
      <div class="d-flex align-items-center gap-3">
        {{ avatar(name="Small avatar", initials="SM", size="sm") }}
        {{ avatar(name="Default avatar", initials="DF") }}
        {{ avatar(name="Large avatar", initials="LG", size="lg") }}
      </div>
    {% endset %}
    {{ render_example(
      "sizes",
      "Sizes",
      "Use the smallest avatar that still identifies the subject in the surrounding layout.",
      sizes
    ) }}

    {% set arabic_avatar %}
      <div class="d-inline-flex align-items-center gap-3" dir="rtl">
        {{ avatar(
          name="مروة",
          initials="مو",
          badge_dot=true,
          badge_class="bg-success",
          badge_aria_label="متاحة"
        ) }}
        <div>
          <div class="fw-medium">مروة</div>
          <div class="text-body-secondary small">مديرة العمليات</div>
        </div>
      </div>
    {% endset %}

    {% set hebrew_avatar %}
      <div class="d-inline-flex align-items-center gap-3" dir="rtl">
        {{ avatar(
          name="נועה",
          initials="נע",
          badge_dot=true,
          badge_class="bg-success",
          badge_aria_label="זמינה"
        ) }}
        <div>
          <div class="fw-medium">נועה</div>
          <div class="text-body-secondary small">מנהלת סביבת עבודה</div>
        </div>
      </div>
    {% endset %}

    {% set english_avatar %}
      <div class="d-inline-flex align-items-center gap-3" dir="ltr">
        {{ avatar(
          name="Moo UI Admin",
          initials="MO",
          badge_dot=true,
          badge_class="bg-success",
          badge_aria_label="Available"
        ) }}
        <div>
          <div class="fw-medium">Moo UI Admin</div>
          <div class="text-body-secondary small">Workspace owner</div>
        </div>
      </div>
    {% endset %}

    {{ render_rtl_example(
      "avatar",
      "Use tabs to compare Arabic, Hebrew, and English avatars inside the same RTL layout.",
      arabic_avatar,
      hebrew_avatar,
      english_avatar,
      preview_class="moo-example__preview--medium moo-example__preview--fit"
    ) }}
  </div>

  {{ render_reference(
    "Bootstrap does not ship an avatar component; related image primitives live in the",
    "https://getbootstrap.com/docs/5.3/content/images/",
    "Bootstrap Image documentation"
  ) }}

{% endblock %}
