{% extends "layouts/catalog.html.jinja" %}
{% from "components/button.html.jinja" import button %}
{% from "includes/block-example.html.jinja" import render_block_example %}
{% from "includes/code-snippet.html.jinja" import render_code_snippet %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}
{% from "components/table.html.jinja" import table %}

{% block title %}Chart — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Chart",
    "Visualize trends and comparisons with line and bar charts rendered by Chart.js, themed from Bootstrap tokens and re-themed when the light/dark theme changes."
  ) }}

  <div class="moo-component-examples">
    {% set line_chart_example %}
    <div
      class="moo-chart w-100"
      id="chart-line-example"
      style="height: 17.5rem"
      data-chart="line"
      data-chart-data='{"labels":["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug"],"datasets":[{"label":"Revenue","data":[4000,3200,4800,5100,4600,5800,6200,6900]},{"label":"Target","data":[3800,4000,4200,4600,5000,5400,5800,6200]}]}'
    >
      <canvas role="img" aria-label="Line chart comparing monthly revenue against target"></canvas>
    </div>
    {% endset %}
    {% set chart_usage %}
      <p>Render a <code>.moo-chart</code> root with one direct child <code>&lt;canvas&gt;</code>. The <code>data-chart</code> attribute accepts <code>line</code> or <code>bar</code>, while <code>data-chart-data</code> carries the serialized <code>{labels, datasets}</code> data.</p>
      <p>Give the root an explicit height: the responsive runtime fills the space it is given without locking an aspect ratio. The optional Moo UI Chart ESM wraps Chart.js, reads Bootstrap's <code>--bs-*</code> tokens, and re-themes when <code>data-bs-theme</code> changes.</p>
    {% endset %}
    {{ render_component_intro(
      line_chart_example,
      chart_usage,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set bar_chart_example %}
    <div
      class="moo-chart w-100"
      id="chart-bar-example"
      style="height: 17.5rem"
      data-chart="bar"
      data-chart-data='{"labels":["Mon","Tue","Wed","Thu","Fri","Sat","Sun"],"datasets":[{"label":"Visitors","data":[120,190,150,220,180,90,110]}]}'
    >
      <canvas role="img" aria-label="Bar chart of daily active visitors across the week"></canvas>
    </div>
    {% endset %}
    {{ render_block_example(
      "chart-bar",
      "Bar chart",
      "A single-series bar chart. Bars share the same semantic palette and re-theme with the page.",
      bar_chart_example,
      preview_class="moo-example__preview--medium"
    ) }}

    {% set lifecycle_chart_example %}
    <div class="d-grid gap-3 w-100" data-chart-live>
      <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
        <span data-chart-theme>{{ button("Toggle theme", variant="outline", size="sm", icon_start="moon-star") }}</span>
        {% set lifecycle_button %}
          {{ button("Dispose", variant="outline", size="sm", icon_start="circle-off", icon_end="rotate-cw") }}
        {% endset %}
        {{ lifecycle_button
          | replace('type="button"', ('type="button" data-chart-lifecycle data-chart-lifecycle-state="live"' | safe))
          | replace('data-icon="inline-start"', ('data-chart-lifecycle-icon="dispose" data-icon="inline-start"' | safe))
          | replace('data-icon="inline-end"', ('data-chart-lifecycle-icon="reinit" data-icon="inline-end" hidden' | safe))
          | replace('Dispose', ('<span data-chart-lifecycle-label>Dispose</span>' | safe))
          | safe
        }}
        <span class="visually-hidden" data-chart-status aria-live="polite">Live</span>
      </div>
      <div
        class="moo-chart w-100"
        id="chart-lifecycle-example"
        style="height: 17.5rem"
        data-chart="line"
        data-chart-data='{"labels":["Q1","Q2","Q3","Q4"],"datasets":[{"label":"Pipeline","data":[18,24,21,30]}]}'
      >
        <canvas role="img" aria-label="Lifecycle chart showing quarterly pipeline movement"></canvas>
      </div>
    </div>
    {% endset %}
    {{ render_block_example(
      "chart-lifecycle",
      "Theme and lifecycle",
      "Exercise the public chart instance through theme changes, disposal, and reinitialization.",
      lifecycle_chart_example,
      preview_class="moo-example__preview--medium bg-body text-body"
    ) }}

    <h2 id="chart-html-anatomy" class="h4 mt-5 mb-3">HTML Anatomy</h2>
    <p class="mb-4">
      These are the public HTML hooks that applications can inspect or target.
      They describe rendered markup, not the repository's internal Jinja build
      helpers.
    </p>

    {% set chart_parts = [
      {"id": "chart-root", "selector": "<code>.moo-chart</code>", "summary": "Public root element. It owns the Chart.js instance and the theme observer."},
      {"id": "chart-id", "selector": "<code>id</code>", "summary": "Required stable identifier for the chart root and its server-rendered contract."},
      {"id": "chart-type", "selector": "<code>[data-chart]</code>", "summary": "Chart type and initializer attribute. Only <code>line</code> and <code>bar</code> are supported for 1.0.0-rc.3; other values throw a TypeError."},
      {"id": "chart-data", "selector": "<code>[data-chart-data]</code>", "summary": "Serialized <code>{labels, datasets}</code> JSON. Malformed JSON throws an explicit diagnostic."},
      {"id": "chart-canvas", "selector": "<code>.moo-chart &gt; canvas</code>", "summary": "The first child canvas. It is resolved deterministically and is required."}
    ] %}

    {% set chart_parts_rows = [] %}
    {% for part in chart_parts %}
      {% set _ = chart_parts_rows.append([part["selector"], part["summary"]]) %}
    {% endfor %}
    {{ table(
      ["Selector", "Purpose"],
      chart_parts_rows,
      row_ids=chart_parts | map(attribute="id") | list,
      row_header=true,
      extra_class="align-middle mb-5"
    ) }}

    {% set chart_markup_example %}
    <div
      class="moo-chart"
      id="chart-html-example"
      style="height: 17.5rem"
      data-chart="line"
      data-chart-data='{"labels":["Jan","Feb","Mar"],"datasets":[{"label":"Revenue","data":[4000,3200,4800]}]}'
    >
      <canvas role="img" aria-label="Monthly revenue line chart"></canvas>
    </div>
    {% endset %}
    {{ render_code_snippet("chart-html-anatomy-example", chart_markup_example, "html") }}

    <h2 id="chart-javascript" class="h4 mt-5 mb-3">JavaScript</h2>
    <p>
      Chart.js is bundled into the published <code>chart.js</code> entrypoint through
      <code>chart.js/auto</code>; the wrapper never reads <code>window.Chart</code> and never
      loads a runtime CDN script. Importing the module never scans the document.
      Initialize only a <code>.moo-chart</code> root your application owns: repeated
      initialization returns the same instance, and <code>dispose()</code> destroys the
      Chart.js instance, disconnects the theme observer, cancels pending work, and
      releases the instance registration.
    </p>
    {% set chart_import_example %}
    import MooChart from "@wpmoo/ui/chart.js";

    const element = document.querySelector(".moo-chart");

    if (element) {
      const chart = MooChart.getOrCreateInstance(element);

      // getOrCreateInstance is idempotent: the same instance is returned.
      const again = MooChart.getOrCreateInstance(element);
      console.assert(chart === again);

      // Later, release Chart.js and the theme observer.
      chart.dispose();
    }
    {% endset %}
    {{ render_code_snippet("chart-javascript-import", chart_import_example, "js") }}

    <h2 id="chart-theming" class="h4 mt-5 mb-3">Theming</h2>
    <p class="mb-4">
      Chart colors are derived from Bootstrap's semantic <code>--bs-*</code> tokens at
      runtime, not from hardcoded theme values. A <code>MutationObserver</code> watches
      the nearest <code>data-bs-theme</code> scope, falling back to the document
      element; when that scope changes, each chart re-reads the tokens and re-themes
      its datasets, grid lines, legend, and tooltip without a reload. Line chart
      points use their series color for the point fill, border, and hover halo so
      light theme points do not pick up a dark neutral outline. Charts also
      reflow on resize: they are responsive and drop
      aspect-ratio locking, so the same markup fills a desktop card or a narrow
      mobile viewport without layout-specific switches.
    </p>

    <h2 id="chart-accessibility" class="h4 mt-5 mb-3">Accessibility</h2>
    <p class="mb-0">
      The canvas is a raster of pixels, so give it a text alternative: set
      <code>role="img"</code> and a descriptive <code>aria-label</code> on the
      <code>&lt;canvas&gt;</code>, or provide an adjacent data table for the same series.
      Keep legends visible rather than encoding meaning in color alone, and preserve
      the default tooltip so individual values remain reachable on touch and with a
      pointer.
    </p>
  </div>

  {{ render_reference(
    "Rendering and the chart API build on Chart.js; see the",
    "https://www.chartjs.org/docs/latest/",
    "Chart.js documentation",
    extra_references=[
      {
        "lead": "For the color tokens the palette reads, see the",
        "href": "https://getbootstrap.com/docs/5.3/customize/css-variables/",
        "label": "Bootstrap CSS variables documentation"
      }
    ]
  ) }}
{% endblock %}
