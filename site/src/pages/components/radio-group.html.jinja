{% extends "layouts/catalog.html.jinja" %}
{% from "components/radio_group.html.jinja" import radio_group %}
{% from "components/field.html.jinja" import field, fieldset %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_example, render_rtl_example %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Radio Group — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Radio Group",
    "Let users choose one option from a related set using native Bootstrap radio controls."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      {% call fieldset("Radio Group", description="Use for one required choice from a related set.") %}
        {% call field() %}
          {{ radio_group(
            "radio-intro-options",
            "",
            [
              {"id": "radio-intro-first", "label": "First option", "description": "Selected by default when it is the safest common choice.", "checked": true},
              {"id": "radio-intro-second", "label": "Second option", "description": "Available when the user needs a different value."}
            ],
            bare=true
          ) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {% set radio_group_usage %}
      <p>Use <code>.form-check</code> radio inputs when one and only one option can be selected from a related set. Group the native radio inputs with a fieldset and legend, give every option a distinct visible label, and share the same <code>name</code> so the browser enforces a single selected value.</p>
      <p>Use <code>.form-check</code>, <code>.form-check-input</code>, and <code>.form-check-label</code> for each option so label clicks and Bootstrap state styling work predictably. Add option descriptions only when they explain the consequence of choosing that value, and keep the selected default to the safest or most common choice.</p>
      <p>Use disabled state for unavailable options without removing them when their presence helps explain the rule. Mark invalid state on the group when the user must choose before submitting, then make the validation message describe the required decision.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      radio_group_usage,
      "moo-example__preview--narrow"
    ) }}

    {% set default %}
      {% call fieldset("Incident alert channel", description="Choose how you want to be notified when an incident occurs.") %}
        {% call field() %}
          {{ radio_group(
            "radio-default",
            "",
            [
              {"id": "radio-default-email", "label": "Email", "checked": true},
              {"id": "radio-default-sms", "label": "SMS"},
              {"id": "radio-default-webhook", "label": "Webhook"}
            ],
            bare=true
          ) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "default",
      "Default",
      "Use one compact set of mutually exclusive options for a common selection workflow.",
      default
    ) }}

    {% set with_description %}
      {% call fieldset("Export destination", description="Each option explains its own operational impact below.") %}
        {% call field() %}
          {{ radio_group(
            "radio-format",
            "",
            [
              {
                "id": "radio-format-drive",
                "label": "Shared drive",
                "description": "Saves to the operations drive folder.",
                "checked": true
              },
              {
                "id": "radio-format-sftp",
                "label": "SFTP",
                "description": "Available for scheduled sync jobs only."
              }
            ],
            bare=true
          ) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "description",
      "Description",
      "Show option-level helper text when each choice has a different operational impact.",
      with_description
    ) }}

    {% set fieldset_example %}
      {% call fieldset("Backup retention plan", description="Longer retention windows use more storage and cost more per month.") %}
        {% call field() %}
          {{ radio_group(
            "radio-retention",
            "",
            [
              {"id": "radio-retention-standard", "label": "Standard (30 days)", "checked": true},
              {"id": "radio-retention-extended", "label": "Extended (180 days)"},
              {"id": "radio-retention-archive", "label": "Archive (7 years)"}
            ],
            bare=true
          ) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "fieldset",
      "Fieldset",
      "Add a fieldset-level description and standard field spacing when the whole group needs shared context.",
      fieldset_example
    ) }}

    {% set disabled %}
      {% call fieldset("Task completion notification", description="Some delivery methods may be temporarily unavailable.") %}
        {% call field() %}
          {{ radio_group(
            "radio-disabled",
            "",
            [
              {"id": "radio-disabled-portal", "label": "Team portal", "checked": true},
              {
                "id": "radio-disabled-mobile",
                "label": "Mobile push (temporarily paused)",
                "disabled": true
              }
            ],
            bare=true
          ) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "disabled",
      "Disabled",
      "Disable only options that are currently unavailable in the current environment.",
      disabled
    ) }}

    {% set invalid %}
      {% call fieldset("Primary contact method", description="Choose how we should reach you if there's an issue.") %}
        {% call field() %}
          {{ radio_group(
            "radio-invalid",
            "",
            [
              {"id": "radio-invalid-email", "label": "Email"},
              {"id": "radio-invalid-sms", "label": "SMS"},
              {"id": "radio-invalid-phone", "label": "Phone call"}
            ],
            invalid=true,
            required=true,
            feedback="Select a contact method before saving.",
            bare=true
          ) }}
        {% endcall %}
      {% endcall %}
    {% endset %}
    {{ render_example(
      "invalid",
      "Invalid",
      "Use the invalid and feedback parameters to show a validation error across the whole group.",
      invalid
    ) }}

    {% set radio_rtl_arabic %}
      <div dir="rtl">
        {% call fieldset("قناة التنبيه", description="يوضح كل خيار متى يصل التنبيه إلى الفريق.") %}
          {% call field() %}
            {{ radio_group(
              "radio-rtl-channel-arabic",
              "",
              [
                {
                  "id": "radio-rtl-email-arabic",
                  "label": "بريد الفريق",
                  "description": "يرسل ملخص الحالة إلى صندوق الوارد.",
                  "checked": true
                },
                {
                  "id": "radio-rtl-sms-arabic",
                  "label": "تنبيه SMS",
                  "description": "مناسب للتنبيهات التي تحتاج ردًا سريعًا."
                }
              ],
              reverse=true,
              bare=true
            ) }}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {% set radio_rtl_hebrew %}
      <div dir="rtl">
        {% call fieldset("ערוץ התראות", description="כל אפשרות מסבירה מתי ההתראה מגיעה לצוות.") %}
          {% call field() %}
            {{ radio_group(
              "radio-rtl-channel-hebrew",
              "",
              [
                {
                  "id": "radio-rtl-email-hebrew",
                  "label": "דוא״ל צוות",
                  "description": "שולח סיכום מצב לתיבת הדואר.",
                  "checked": true
                },
                {
                  "id": "radio-rtl-sms-hebrew",
                  "label": "הודעת SMS",
                  "description": "מתאים להתראות שדורשות תגובה מהירה."
                }
              ],
              reverse=true,
              bare=true
            ) }}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {% set radio_rtl_english %}
      <div dir="ltr">
        {% call fieldset("Alert channel", description="Each option explains when the alert reaches the team.") %}
          {% call field() %}
            {{ radio_group(
              "radio-rtl-channel-english",
              "",
              [
                {
                  "id": "radio-rtl-email-english",
                  "label": "Team email",
                  "description": "Sends the status summary to the inbox.",
                  "checked": true
                },
                {
                  "id": "radio-rtl-sms-english",
                  "label": "SMS alert",
                  "description": "Useful for alerts that need a quick response."
                }
              ],
              bare=true
            ) }}
          {% endcall %}
        {% endcall %}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "radio-group",
      "Choose the same notification channel across Arabic and Hebrew RTL examples, with English as the LTR comparison.",
      radio_rtl_arabic,
      radio_rtl_hebrew,
      radio_rtl_english
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and the shared form-check family, see the",
    "https://getbootstrap.com/docs/5.3/forms/checks-radios/",
    "Bootstrap Checks and radios documentation"
  ) }}

{% endblock %}
