{% extends "layouts/catalog.html.jinja" %}
{% from "components/alert.html.jinja" import alert %}
{% from "components/close_button.html.jinja" import close_button %}
{% from "includes/documentation-reference.html.jinja" import render_reference with context %}
{% from "includes/example.html.jinja" import render_component_intro, render_component_example, render_rtl_example with context %}
{% from "includes/page-header.html.jinja" import render_page_header with context %}

{% block title %}Close Button — Moo UI{% endblock %}

{% block content %}
  {{ render_page_header(
    "Close Button",
    "Dismiss alerts, dialogs, and other transient content with Bootstrap's native .btn-close."
  ) }}

  <div class="moo-component-examples">
    {% set intro %}
      <div style="width: 20rem;">
        {{ alert(
          "Close Button",
          description="Use inside alerts, dialogs, toasts, and other dismissible surfaces.",
          dismissible=true,
          extra_class="mb-0"
        ) }}
      </div>
    {% endset %}
    {% set close_button_usage %}
      <p>Use <code>.btn-close</code> for dismissing nearby transient content such as alerts, dialogs, toasts, and offcanvas panels. Render the button at the edge of the surface it dismisses, and always provide an accessible name with <code>aria-label</code> because the icon has no visible text.</p>
      <p>Pair the close button with the matching Bootstrap dismissal behavior for the owning component, such as <code>data-bs-dismiss="alert"</code> or <code>data-bs-dismiss="modal"</code>. Use <code>disabled</code> only when dismissal is temporarily unavailable; Bootstrap suppresses pointer and selection behavior for the disabled state.</p>
      <p>For dark surfaces, prefer <code>data-bs-theme="dark"</code> on the button or parent instead of deprecated color inversion classes. After dismissal, make sure focus lands somewhere sensible when the closed surface contained the active control.</p>
    {% endset %}
    {{ render_component_intro(
      intro,
      close_button_usage
    ) }}

    {% set default %}
      <div class="d-inline-flex">
        {{ close_button() }}
      </div>
    {% endset %}
    {{ render_component_example("close-button", "Close Button",
      "default",
      "Default",
      "Provide an accessible label; the icon itself carries no visible text.",
      default,
      preview_class="moo-example__preview--fit"
    ) }}

    {% set disabled %}
      <div class="d-inline-flex">
        {{ close_button(disabled=true) }}
      </div>
    {% endset %}
    {{ render_component_example("close-button", "Close Button",
      "disabled",
      "Disabled",
      "Disabled close buttons lower opacity and drop pointer and hover interaction.",
      disabled,
      preview_class="moo-example__preview--fit"
    ) }}

    {% set in_context %}
      <div class="d-flex align-items-start justify-content-between gap-3 p-3 rounded-3 border bg-body" style="width: 20rem;">
        <div>
          <div class="fw-medium">Update available</div>
          <div class="text-body-secondary small">Version 2.1 is ready to install.</div>
        </div>
        {{ close_button() }}
      </div>
    {% endset %}
    {{ render_component_example("close-button", "Close Button",
      "in-context",
      "In context",
      "Pair with a flex row to dismiss a notice, alert, or toast.",
      in_context
    ) }}

    {% set rtl_arabic %}
      <div class="d-inline-flex align-items-start justify-content-between gap-3 p-3 rounded-3 border bg-body" dir="rtl">
        <div>
          <div class="fw-medium">تم تجاهل الحادث</div>
          <div class="text-body-secondary small">تم مسح تنبيه الحادث.</div>
        </div>
        {{ close_button(aria_label="إغلاق") }}
      </div>
    {% endset %}

    {% set rtl_hebrew %}
      <div class="d-inline-flex align-items-start justify-content-between gap-3 p-3 rounded-3 border bg-body" dir="rtl">
        <div>
          <div class="fw-medium">האירוע נסגר</div>
          <div class="text-body-secondary small">התראת האירוע נוקתה.</div>
        </div>
        {{ close_button(aria_label="סגירה") }}
      </div>
    {% endset %}

    {% set rtl_english %}
      <div class="d-inline-flex align-items-start justify-content-between gap-3 p-3 rounded-3 border bg-body" dir="ltr">
        <div>
          <div class="fw-medium">Incident dismissed</div>
          <div class="text-body-secondary small">The incident alert was cleared.</div>
        </div>
        {{ close_button(aria_label="Close") }}
      </div>
    {% endset %}

    {{ render_rtl_example(
      "close-button-ribbon",
      "Compare Arabic, Hebrew, and English close actions in an RTL layout for operations workflows.",
      rtl_arabic,
      rtl_hebrew,
      rtl_english,
      preview_class="moo-example__preview--narrow"
    ) }}
  </div>

  {{ render_reference(
    "For Bootstrap's source behavior and CSS variables, see the",
    "https://getbootstrap.com/docs/5.3/components/close-button/",
    "Bootstrap Close button documentation"
  ) }}

{% endblock %}
