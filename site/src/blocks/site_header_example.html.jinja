{% from "blocks/site_header.html.jinja" import site_header %}
{% from "components/button.html.jinja" import button %}

{% set site_header_example_items = [
  {"label": "Home", "href": "#home", "active": true},
  {"label": "About", "href": "#about", "children": [
    {"label": "Our team", "href": "#team"},
    {"label": "History", "href": "#history"},
    {"label": "Careers", "href": "#careers", "disabled": true}
  ]},
  {"label": "Programmes", "href": "#programmes"},
  {"label": "News", "href": "#news"},
  {"label": "Contact", "href": "#contact"},
  {"label": "Donate", "href": "#donate", "drawer_only": true}
] %}

{% set site_header_example_utility = [
  {"label": "Parents", "href": "#parents"},
  {"label": "Press", "href": "#press"},
  {"label": "Deutsch", "href": "#de"}
] %}

{% macro render_site_header_text_example(id="site-header-text") -%}
  {% call site_header(id, "Main navigation", {"label": "Moo UI", "href": "#home", "mark": "blocks", "subtitle": "Component system"}, items=site_header_example_items[:5]) %}
    {{ button("Apply", size="sm", element="a", href="#apply") }}
  {% endcall %}
{%- endmacro %}

{% macro render_site_header_logo_example(root_path, id="site-header-logo") -%}
  {% call site_header(
    id, "Main navigation",
    {"label": "Moo UI", "href": "#home", "show_label": true, "logo": {"src": root_path ~ "assets/images/site-header/logo.svg", "alt": "Moo UI", "width": 32, "height": 32}},
    items=site_header_example_items, utility_items=site_header_example_utility
  ) %}
    {{ button("Apply", size="sm", element="a", href="#apply") }}
  {% endcall %}
{%- endmacro %}

{% macro render_site_header_dark_example(root_path, id="site-header-dark") -%}
  {% call site_header(
    id, "Main navigation",
    {"label": "Moo UI", "href": "#home", "mark": "blocks"},
    items=site_header_example_items, utility_items=site_header_example_utility, surface="dark", breakpoint="xl"
  ) %}
    {{ button("Apply", variant="outline", size="sm", element="a", href="#apply") }}
  {% endcall %}
{%- endmacro %}

{% macro render_site_header_rtl_example(id="site-header-rtl") -%}
  {% call site_header(id, "Main navigation", {"label": "Moo UI", "href": "#home", "mark": "blocks", "subtitle": "Component system"}, items=site_header_example_items[:5]) %}
    {{ button("Apply", size="sm", element="a", href="#apply") }}
  {% endcall %}
{%- endmacro %}

{% macro render_site_header_page(kind, root_path, id) -%}
  {% if kind == "text" %}{{ render_site_header_text_example(id) }}
  {% elif kind == "logo" %}{{ render_site_header_logo_example(root_path, id) }}
  {% elif kind == "rtl" %}{{ render_site_header_rtl_example(id) }}
  {% else %}{{ render_site_header_dark_example(root_path, id) }}{% endif %}
  <main class="container py-4">
    <h1 class="h3">Welcome</h1>
    <p class="text-body-secondary">Resize the frame below the breakpoint to open the drawer with the Menu button.</p>
  </main>
{%- endmacro %}
