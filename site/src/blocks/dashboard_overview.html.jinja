{#- Dashboard overview block: stat cards + Chart.js charts for the
   dashboard example page. All data is static/fictional — this is a
   demo screen, not a real analytics dashboard. #}

{% macro render_stat_card(label, value, change="", change_type="positive", icon="") %}
  {#- A single metric card: label, big number, optional trend indicator.
     change_type: "positive" (green), "negative" (red), or "neutral". #}
  {% set change_class = {
    "positive": "text-success",
    "negative": "text-danger",
    "neutral": "text-body-secondary"
  }[change_type] %}
  <div class="card card--sm h-100">
    <div class="card-body d-flex flex-column gap-2">
      <div class="d-flex align-items-center justify-content-between">
        <span class="text-body-secondary small text-uppercase ls-wide">{{ label }}</span>
        {% if icon %}
          <span class="text-body-tertiary">{{ render_icon(icon, "inline-start") }}</span>
        {% endif %}
      </div>
      <div class="d-flex align-items-baseline gap-2">
        <span class="fs-3 fw-semibold">{{ value }}</span>
        {% if change %}
          <span class="small {{ change_class }}">{{ change }}</span>
        {% endif %}
      </div>
    </div>
  </div>
{% endmacro %}

{% macro render_chart_container(chart_id, chart_type, chart_data, extra_class="") %}
  {#- A Chart canvas wrapper using the public Moo Chart contract: the
     .chart root class plus the data-chart (type) and
     data-chart-data (serialized data) attributes configure the
     MooChart initializer. #}
  <div class="card{{ ' ' + extra_class if extra_class }}">
    <div class="card-header">
      <div class="card-header__text">
        <h3 class="card-title">{{ chart_data.title }}</h3>
        {% if chart_data.subtitle %}
          <p class="card-subtitle">{{ chart_data.subtitle }}</p>
        {% endif %}
      </div>
    </div>
    <div class="card-body">
      <div class="chart moo-dashboard-chart" id="{{ chart_id }}" data-chart="{{ chart_type }}" data-chart-data='{{ chart_data.data | tojson }}'>
        <canvas role="img" aria-label="{{ chart_data.title }}"></canvas>
      </div>
    </div>
  </div>
{% endmacro %}

{% macro render_dashboard_overview() %}
  {#- Full dashboard overview: 4 stat cards + 2 charts (line + bar).
     All numbers are fictional demo data. #}
  {#- Stat cards row #}
  <div class="row g-3 mb-4">
      <div class="col-sm-6 col-xl-3">
        {{ render_stat_card(
          "Total Revenue",
          "$45,231",
          "+20.1%",
          "positive",
          "dollar-sign"
        ) }}
      </div>
      <div class="col-sm-6 col-xl-3">
        {{ render_stat_card(
          "Subscriptions",
          "+2,350",
          "+180.1%",
          "positive",
          "users"
        ) }}
      </div>
      <div class="col-sm-6 col-xl-3">
        {{ render_stat_card(
          "Sales",
          "+12,234",
          "+19%",
          "positive",
          "credit-card"
        ) }}
      </div>
      <div class="col-sm-6 col-xl-3">
        {{ render_stat_card(
          "Active Now",
          "573",
          "+201",
          "positive",
          "activity"
        ) }}
      </div>
  </div>

  {#- Charts row #}
  <div class="row g-3">
      <div class="col-lg-8">
        {{ render_chart_container(
          "overview-revenue-chart",
          "line",
          {
            "title": "Revenue Overview",
            "subtitle": "Monthly revenue for the current year",
            "data": {
              "labels": ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
              "datasets": [
                {
                  "label": "Revenue",
                  "data": [4000, 3200, 4800, 5100, 4600, 5800, 6200, 5900, 6800, 7200, 6900, 7500],
                  "tension": 0.3,
                  "fill": true
                }
              ]
            }
          },
          "h-100"
        ) }}
      </div>
      <div class="col-lg-4">
        {{ render_chart_container(
          "overview-visitors-chart",
          "bar",
          {
            "title": "Recent Visitors",
            "subtitle": "Daily active users this week",
            "data": {
              "labels": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
              "datasets": [
                {
                  "label": "Visitors",
                  "data": [120, 190, 150, 220, 180, 90, 110]
                }
              ]
            }
          },
          "h-100"
        ) }}
      </div>
  </div>
{% endmacro %}
