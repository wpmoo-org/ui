(() => {
  const owner = document.currentScript?.parentElement;
  if (!owner?.matches?.('.moo-ui[data-bs-theme="light"], .moo-ui[data-bs-theme="dark"]')) return;

  // Core keeps physical left/right placement. The catalog mirrors its own
  // configured LTR edge without changing the shared Sidebar contract or CSS.
  const bindSidebarPlacement = () => {
    const sidebar = owner.querySelector?.("#catalog-sidebar");
    if (!sidebar) return false;
    const configuredSide = sidebar.dataset.catalogConfiguredSide ?? sidebar.dataset.side;
    const ltrSide = configuredSide === "right" ? "right" : "left";
    sidebar.dataset.catalogConfiguredSide = ltrSide;
    const chevrons = {
      "chevron-left": {{ render_icon("chevron-left", "inline-end") | tojson }},
      "chevron-right": {{ render_icon("chevron-right", "inline-end") | tojson }},
    };
    const iconTemplates = new Map();
    const syncChevrons = () => {
      sidebar.querySelectorAll("button.sidebar-menu-button--disclosure").forEach((button) => {
        const icon = button.querySelector(":scope > .sidebar-menu-button__end > svg");
        if (!icon || !Object.prototype.hasOwnProperty.call(chevrons, icon.dataset.lucide)) return;
        const rtl = window.getComputedStyle(button).direction === "rtl";
        const expanded = button.getAttribute("aria-expanded") === "true";
        // Core rotates the open right-chevron downward. Keep that contract;
        // choose the registered left-chevron only for a closed RTL disclosure.
        const name = rtl && !expanded ? "chevron-left" : "chevron-right";
        if (icon.dataset.lucide === name) return;
        if (!iconTemplates.has(name)) {
          const template = document.createElement("template");
          template.innerHTML = chevrons[name];
          iconTemplates.set(name, template);
        }
        icon.replaceWith(iconTemplates.get(name).content.firstElementChild.cloneNode(true));
      });
    };
    const syncPlacement = () => {
      const rtl = window.getComputedStyle(sidebar).direction === "rtl";
      const side = rtl ? (ltrSide === "left" ? "right" : "left") : ltrSide;
      sidebar.dataset.side = side;
      sidebar.classList.toggle("offcanvas-start", side === "left");
      sidebar.classList.toggle("offcanvas-end", side === "right");
      syncChevrons();
    };
    syncPlacement();
    if (typeof window.MutationObserver === "function") {
      const observer = new window.MutationObserver(syncPlacement);
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ["dir"] });
      observer.observe(owner, { attributes: true, attributeFilter: ["dir"] });
      const chevronObserver = new window.MutationObserver(syncChevrons);
      chevronObserver.observe(sidebar, {
        attributes: true,
        attributeFilter: ["aria-expanded"],
        childList: true,
        subtree: true,
      });
    }
    return true;
  };
  // This script runs before visible catalog markup. Observe its parser-created
  // Sidebar so restored RTL placement is correct before the first rendered frame.
  if (!bindSidebarPlacement() && typeof window.MutationObserver === "function") {
    const observer = new window.MutationObserver(() => {
      if (bindSidebarPlacement()) observer.disconnect();
    });
    observer.observe(owner, { childList: true, subtree: true });
  }

  const payload = {{ theme_builder_state | tojson }};
  const hasOwn = (object, key) => Object.prototype.hasOwnProperty.call(object, key);
  const enumValue = (key, candidate) => {
    const aliases = key === "baseColor"
      ? payload.aliases.baseColor
      : key === "themeColor" || key === "chartColor"
        ? payload.aliases.actionColor
        : key === "radius" ? payload.aliases.radius : {};
    const value = hasOwn(aliases, candidate) ? aliases[candidate] : candidate;
    return payload.options[key].includes(value) ? value : payload.defaults[key];
  };

  try {
    const raw = window.localStorage?.getItem("moo:theme-builder");
    const source = raw ? JSON.parse(raw) : null;
    if (!source || typeof source !== "object" || Array.isArray(source)) return;

    const legacyThemeColor = source.themeColor === undefined
      && payload.legacyActionBaseColors.includes(source.baseColor)
      ? source.baseColor
      : undefined;
    const state = {
      schemaVersion: payload.schemaVersion,
      baseColor: enumValue("baseColor", source.baseColor),
      themeColor: enumValue("themeColor", source.themeColor ?? legacyThemeColor),
      chartColor: enumValue("chartColor", source.chartColor ?? source.chartPalette),
      headingFont: enumValue("headingFont", source.headingFont),
      bodyFont: enumValue("bodyFont", source.bodyFont),
      radius: enumValue("radius", source.radius),
    };
    if (Object.entries(payload.defaults).every(([key, value]) => state[key] === value)) return;

    owner.dataset.mooCatalogThemeBuilderState = "true";
    owner.dataset.mooCatalogThemeBuilderBaseColor = state.baseColor;
    owner.dataset.mooCatalogThemeBuilderThemeColor = state.themeColor;
    owner.dataset.mooCatalogThemeBuilderChartColor = state.chartColor;
    owner.dataset.mooCatalogThemeBuilderHeadingFont = state.headingFont;
    owner.dataset.mooCatalogThemeBuilderBodyFont = state.bodyFont;
    owner.dataset.mooCatalogThemeBuilderRadius = state.radius;
  } catch (_) {
    // Storage can be unavailable or contain malformed legacy data.
  }
})();
