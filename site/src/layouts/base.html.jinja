<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
      (() => {
        let storedTheme = null;
        try {
          storedTheme = window.localStorage.getItem("moo:theme");
        } catch (_) {
          /* Storage can be unavailable in restricted browsing contexts. */
        }
        if (storedTheme === "dark" || storedTheme === "light") {
          document.documentElement.dataset.bsTheme = storedTheme;
        } else {
          // Unset or "system" means follow the OS preference; resolved even
          // when storage access failed, so the System default still applies.
          const dark = window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.bsTheme = dark ? "dark" : "light";
        }
        try {
          const storedDirection = window.localStorage.getItem("moo:direction");
          if (storedDirection === "rtl") {
            document.documentElement.dir = "rtl";
          }
        } catch (_) {
          /* Storage can be unavailable in restricted browsing contexts. */
        }
      })();
    </script>
    <meta name="description" content="{{ page_meta.description }}">
    <meta property="og:site_name" content="{{ page_meta.site_name }}">
    <meta property="og:type" content="{{ page_meta.type }}">
    <meta property="og:title" content="{{ page_meta.title }}">
    <meta property="og:description" content="{{ page_meta.description }}">
    <meta property="og:url" content="{{ page_meta.url }}">
    <meta property="og:image" content="{{ page_meta.image }}">
    <meta property="og:image:alt" content="{{ page_meta.image_alt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_meta.title }}">
    <meta name="twitter:description" content="{{ page_meta.description }}">
    <meta name="twitter:image" content="{{ page_meta.image }}">
    <link rel="canonical" href="{{ page_meta.url }}">
    <title>{% block title %}{{ page_meta.title }}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ root_path }}favicon.svg">
    <link rel="icon" href="{{ root_path }}favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="{{ root_path }}apple-touch-icon.png">
    <link rel="manifest" href="{{ root_path }}site.webmanifest">
    {% block critical_prepaint_styles %}{% endblock %}
    {% block font_preload %}
    <link rel="preload" href="{{ root_path }}assets/fonts/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
    {% endblock %}
    <link rel="stylesheet" href="{{ root_path }}assets/css/moo-ui.min.css?v={{ asset_version }}">
    <link rel="stylesheet" href="{{ root_path }}assets/css/catalog.min.css?v={{ asset_version }}">
    <style id="moo-theme-builder-tokens" data-moo-theme-builder-tokens></style>
    <script>
      (() => {
        try {
          const themeBuilderFirstPaint = {{ theme_builder_first_paint | tojson }};
          const rawBuilder = window.localStorage.getItem("moo:theme-builder");
          const source = rawBuilder ? JSON.parse(rawBuilder) : null;
          const tokenStyle = document.getElementById("moo-theme-builder-tokens");
          if (source && typeof source === "object" && !Array.isArray(source)) {
            const hasOwn = (object, key) =>
              Object.prototype.hasOwnProperty.call(object, key);
            // Keep this in sync with normalizeThemeBuilderState().
            const enumValue = (key, candidate) => {
              const aliases =
                key === "baseColor"
                  ? themeBuilderFirstPaint.aliases.baseColor
                  : key === "themeColor" || key === "chartColor"
                    ? themeBuilderFirstPaint.aliases.actionColor
                    : key === "radius"
                      ? themeBuilderFirstPaint.aliases.radius
                    : {};
              const value = hasOwn(aliases, candidate) ? aliases[candidate] : candidate;
              return (themeBuilderFirstPaint.options[key] || []).includes(value)
                ? value
                : themeBuilderFirstPaint.defaults[key];
            };
            const legacyThemeColor =
              source.themeColor === undefined &&
              themeBuilderFirstPaint.legacyActionBaseColors.includes(source.baseColor)
                ? source.baseColor
                : undefined;
            const state = {
              schemaVersion: themeBuilderFirstPaint.schemaVersion,
              baseColor: enumValue("baseColor", source.baseColor),
              themeColor: enumValue("themeColor", source.themeColor ?? legacyThemeColor),
              chartColor: enumValue("chartColor", source.chartColor ?? source.chartPalette),
              headingFont: enumValue("headingFont", source.headingFont),
              bodyFont: enumValue("bodyFont", source.bodyFont),
              radius: enumValue("radius", source.radius)
            };
            const isDefaultState = Object.entries(themeBuilderFirstPaint.defaults)
              .every(([key, value]) => state[key] === value);
            if (isDefaultState || !tokenStyle) {
              return;
            }
            const builderMode =
              document.documentElement.dataset.bsTheme === "dark" ? "dark" : "light";
            const tokenGroups = themeBuilderFirstPaint.tokens;
            const tokens = Object.assign(
              {},
              tokenGroups.baseColor[state.baseColor]?.[builderMode],
              tokenGroups.themeColor[state.themeColor],
              tokenGroups.chartColor[state.chartColor],
              tokenGroups.radius[state.radius],
              tokenGroups.headingFont[state.headingFont],
              tokenGroups.bodyFont[state.bodyFont],
              state.themeColor !== themeBuilderFirstPaint.defaults.themeColor
                ? tokenGroups.sidebarAccent[builderMode]
                : {}
            );

            tokenStyle.textContent = `:root {\n${Object.entries(tokens)
              .map(([token, value]) => `  ${token}: ${value};`)
              .join("\n")}\n}`;
            Object.entries({
              baseColor: "mooCatalogThemeBuilderBaseColor",
              themeColor: "mooCatalogThemeBuilderThemeColor"
            }).forEach(([key, datasetKey]) => {
              if (state[key] !== themeBuilderFirstPaint.defaults[key]) {
                document.documentElement.dataset[datasetKey] = state[key];
              }
            });
          }
        } catch (_) {
          /* Theme Builder storage is best-effort and never blocks paint. */
        }
      })();
    </script>
  </head>
  <body>
    <a class="visually-hidden-focusable" href="#main-content">
      Skip to component content
    </a>
    {% block body %}{% endblock %}
    <script defer src="{{ root_path }}assets/js/bootstrap.bundle.min.js?v={{ asset_version }}"></script>
    <script type="module" src="{{ root_path }}assets/js/catalog/index.js?v={{ asset_version }}"></script>
  </body>
</html>
