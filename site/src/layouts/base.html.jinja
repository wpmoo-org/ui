<!doctype html>
<html lang="en" dir="ltr" data-bs-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ page_meta.description }}">
    <meta property="og:site_name" content="{{ page_meta.site_name }}">
    <meta property="og:type" content="{{ page_meta.type }}">
    <meta property="og:title" content="{{ page_meta.title }}">
    <meta property="og:description" content="{{ page_meta.description }}">
    <meta property="og:url" content="{{ page_meta.url }}">
    <meta property="og:image" content="{{ page_meta.image }}">
    <meta property="og:image:alt" content="{{ page_meta.image_alt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_meta.title }}">
    <meta name="twitter:description" content="{{ page_meta.description }}">
    <meta name="twitter:image" content="{{ page_meta.image }}">
    <link rel="canonical" href="{{ page_meta.url }}">
    <title>{% block title %}{{ page_meta.title }}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ root_path }}favicon.svg">
    <link rel="icon" href="{{ root_path }}favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="{{ root_path }}apple-touch-icon.png">
    <link rel="manifest" href="{{ root_path }}site.webmanifest">
    <script>
      (() => {
        let storedTheme = null;
        try {
          storedTheme = window.localStorage.getItem("moo:theme");
        } catch (_) {
          /* Storage can be unavailable in restricted browsing contexts. */
        }
        if (storedTheme === "dark" || storedTheme === "light") {
          document.documentElement.dataset.bsTheme = storedTheme;
        } else {
          // Unset or "system" means follow the OS preference; resolved even
          // when storage access failed, so the System default still applies.
          const dark = window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.bsTheme = dark ? "dark" : "light";
        }
        // Phase 7: restore a saved reading direction before first paint so an
        // RTL choice never flashes back to LTR.
        try {
          const storedDirection = window.localStorage.getItem("moo:direction");
          if (storedDirection === "rtl") {
            document.documentElement.dir = "rtl";
          }
        } catch (_) {
          /* Storage can be unavailable in restricted browsing contexts. */
        }
        try {
          const sidebar = window.localStorage.getItem("moo-sidebar:catalog-shell");
          if (sidebar === "collapsed" || sidebar === "expanded") {
            document.documentElement.dataset.sidebarCatalogState = sidebar;
            window.setTimeout(() => {
              const shell = document.querySelector(
                '[data-slot="sidebar-wrapper"][data-sidebar-key="catalog-shell"]'
              );
              if (shell && !shell.hasAttribute("data-sidebar-ready")) {
                shell.dataset.sidebarState = "expanded";
                delete document.documentElement.dataset.sidebarCatalogState;
              }
            }, 1500);
          }
        } catch (_) {
          /* localStorage can be unavailable in restricted browsing contexts. */
        }
        try {
          const rawBuilder = window.localStorage.getItem("moo:theme-builder");
          const builder = rawBuilder ? JSON.parse(rawBuilder) : null;
          if (builder && typeof builder === "object" && !Array.isArray(builder)) {
            const applyTokens = (tokens) => {
              Object.entries(tokens).forEach(([token, value]) => {
                document.documentElement.style.setProperty(token, value);
              });
            };
            const style = ["soft", "solid", "nova"].includes(builder.style)
              ? builder.style
              : "";
            const baseColor = ["blue", "emerald", "violet"].includes(builder.baseColor)
              ? builder.baseColor
              : "";

            if (style) {
              document.documentElement.dataset.mooCatalogThemeBuilderStyle = style;
            }
            if (baseColor) {
              document.documentElement.dataset.mooCatalogThemeBuilderBaseColor = baseColor;
            }
            if (baseColor === "blue") {
              applyTokens({
                "--bs-primary": "rgb(37, 99, 235)",
                "--moo-primary": "rgb(37, 99, 235)",
                "--moo-ring": "rgb(96, 165, 250)"
              });
            } else if (baseColor === "emerald") {
              applyTokens({
                "--bs-primary": "rgb(5, 150, 105)",
                "--moo-primary": "rgb(5, 150, 105)",
                "--moo-ring": "rgb(52, 211, 153)"
              });
            } else if (baseColor === "violet") {
              applyTokens({
                "--bs-primary": "rgb(124, 58, 237)",
                "--moo-primary": "rgb(124, 58, 237)",
                "--moo-ring": "rgb(167, 139, 250)"
              });
            }
            if (builder.chartPalette === "pastel") {
              applyTokens({
                "--moo-chart-1": "rgb(103, 169, 232)",
                "--moo-chart-2": "rgb(118, 187, 170)",
                "--moo-chart-3": "rgb(246, 198, 110)",
                "--moo-chart-4": "rgb(198, 157, 232)",
                "--moo-chart-5": "rgb(238, 135, 142)"
              });
            } else if (builder.chartPalette === "vivid") {
              applyTokens({
                "--moo-chart-1": "rgb(37, 99, 235)",
                "--moo-chart-2": "rgb(5, 150, 105)",
                "--moo-chart-3": "rgb(217, 119, 6)",
                "--moo-chart-4": "rgb(124, 58, 237)",
                "--moo-chart-5": "rgb(225, 29, 72)"
              });
            }
            if (builder.headingFont === "geist") {
              applyTokens({
                "--moo-heading-font-family": "\"Geist\", var(--bs-body-font-family)"
              });
            } else if (builder.headingFont === "system") {
              applyTokens({
                "--moo-heading-font-family": "system-ui, -apple-system, \"Segoe UI\", sans-serif"
              });
            }
            if (builder.bodyFont === "geist") {
              applyTokens({
                "--bs-body-font-family": "\"Geist\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
                "--moo-catalog-font-family": "\"Geist\""
              });
            } else if (builder.bodyFont === "system") {
              applyTokens({
                "--bs-body-font-family": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
                "--moo-catalog-font-family": "system-ui"
              });
            }
            if (builder.radius === "compact") {
              applyTokens({
                "--bs-border-radius": "0.25rem",
                "--bs-border-radius-sm": "0.1875rem",
                "--bs-border-radius-lg": "0.375rem",
                "--bs-border-radius-xl": "0.5rem",
                "--bs-border-radius-xxl": "0.75rem"
              });
            } else if (builder.radius === "large") {
              applyTokens({
                "--bs-border-radius": "0.75rem",
                "--bs-border-radius-sm": "0.5rem",
                "--bs-border-radius-lg": "1rem",
                "--bs-border-radius-xl": "1.25rem",
                "--bs-border-radius-xxl": "1.5rem"
              });
            }
          }
        } catch (_) {
          /* Theme Builder storage is best-effort and never blocks paint. */
        }
      })();
    </script>
    {% block font_preload %}
    <link rel="preload" href="{{ root_path }}assets/fonts/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
    {% endblock %}
    <link rel="stylesheet" href="{{ root_path }}assets/css/moo-ui.css?v={{ asset_version }}">
    <link rel="stylesheet" href="{{ root_path }}assets/css/catalog.css?v={{ asset_version }}">
  </head>
  <body>
    <a class="visually-hidden-focusable" href="#main-content">
      Skip to component content
    </a>
    {% block body %}{% endblock %}
    <script defer src="{{ root_path }}assets/js/bootstrap.bundle.min.js?v={{ asset_version }}"></script>
    <script type="module" src="{{ root_path }}assets/js/catalog/index.js?v={{ asset_version }}"></script>
  </body>
</html>
