<!doctype html>
<html lang="en" dir="ltr" data-bs-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ page_meta.description }}">
    <meta property="og:site_name" content="{{ page_meta.site_name }}">
    <meta property="og:type" content="{{ page_meta.type }}">
    <meta property="og:title" content="{{ page_meta.title }}">
    <meta property="og:description" content="{{ page_meta.description }}">
    <meta property="og:url" content="{{ page_meta.url }}">
    <meta property="og:image" content="{{ page_meta.image }}">
    <meta property="og:image:alt" content="{{ page_meta.image_alt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_meta.title }}">
    <meta name="twitter:description" content="{{ page_meta.description }}">
    <meta name="twitter:image" content="{{ page_meta.image }}">
    <link rel="canonical" href="{{ page_meta.url }}">
    <title>{% block title %}{{ page_meta.title }}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ root_path }}favicon.svg">
    <link rel="icon" href="{{ root_path }}favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="{{ root_path }}apple-touch-icon.png">
    <link rel="manifest" href="{{ root_path }}site.webmanifest">
    <script>
      (() => {
        let storedTheme = null;
        try {
          storedTheme = window.localStorage.getItem("moo:theme");
        } catch (_) {
          /* Storage can be unavailable in restricted browsing contexts. */
        }
        if (storedTheme === "dark" || storedTheme === "light") {
          document.documentElement.dataset.bsTheme = storedTheme;
        } else {
          // Unset or "system" means follow the OS preference; resolved even
          // when storage access failed, so the System default still applies.
          const dark = window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.bsTheme = dark ? "dark" : "light";
        }
        // Phase 7: restore a saved reading direction before first paint so an
        // RTL choice never flashes back to LTR.
        try {
          const storedDirection = window.localStorage.getItem("moo:direction");
          if (storedDirection === "rtl") {
            document.documentElement.dir = "rtl";
          }
        } catch (_) {
          /* Storage can be unavailable in restricted browsing contexts. */
        }
        try {
          const sidebar = window.localStorage.getItem("moo-sidebar:catalog-shell");
          if (sidebar === "collapsed" || sidebar === "expanded") {
            document.documentElement.dataset.sidebarCatalogState = sidebar;
            window.setTimeout(() => {
              const shell = document.querySelector(
                '[data-slot="sidebar-wrapper"][data-sidebar-key="catalog-shell"]'
              );
              if (shell && !shell.hasAttribute("data-sidebar-ready")) {
                shell.dataset.sidebarState = "expanded";
                delete document.documentElement.dataset.sidebarCatalogState;
              }
            }, 1500);
          }
        } catch (_) {
          /* localStorage can be unavailable in restricted browsing contexts. */
        }
        try {
          const rawBuilder = window.localStorage.getItem("moo:theme-builder");
          const builder = rawBuilder ? JSON.parse(rawBuilder) : null;
          if (builder && typeof builder === "object" && !Array.isArray(builder)) {
            const applyTokens = (tokens) => {
              Object.entries(tokens).forEach(([token, value]) => {
                document.documentElement.style.setProperty(token, value);
              });
            };
            const style = ["soft", "solid", "nova"].includes(builder.style)
              ? builder.style
              : "";
            const baseColor = ["zinc", "stone", "slate", "mauve"].includes(builder.baseColor)
              ? builder.baseColor
              : "";
            const legacyThemeColor = ["blue", "emerald", "violet"].includes(builder.baseColor)
              ? builder.baseColor
              : "";
            const themeColor = [
              "blue",
              "emerald",
              "violet",
              "amber",
              "rose",
              "cyan",
              "orange",
              "pink",
              "red"
            ].includes(builder.themeColor)
              ? builder.themeColor
              : legacyThemeColor;
            const chartColor = [
              "pastel",
              "vivid",
              "blue",
              "emerald",
              "violet",
              "amber",
              "rose"
            ].includes(builder.chartColor)
              ? builder.chartColor
              : ["pastel", "vivid"].includes(builder.chartPalette)
                ? builder.chartPalette
                : "";
            const builderMode =
              document.documentElement.dataset.bsTheme === "dark" ? "dark" : "light";

            if (style) {
              document.documentElement.dataset.mooCatalogThemeBuilderStyle = style;
            }
            if (baseColor) {
              document.documentElement.dataset.mooCatalogThemeBuilderBaseColor = baseColor;
            }
            if (themeColor) {
              document.documentElement.dataset.mooCatalogThemeBuilderThemeColor = themeColor;
            }
            const baseColorTokens = {
              zinc: {
                light: {
                  "--bs-body-bg": "rgb(250, 250, 250)",
                  "--bs-body-bg-rgb": "250, 250, 250",
                  "--bs-body-color": "rgb(24, 24, 27)",
                  "--bs-secondary-color": "rgb(113, 113, 122)",
                  "--bs-secondary-bg": "rgb(244, 244, 245)",
                  "--bs-secondary-bg-rgb": "244, 244, 245",
                  "--bs-tertiary-bg": "rgb(250, 250, 250)",
                  "--bs-tertiary-bg-rgb": "250, 250, 250",
                  "--bs-border-color": "rgb(228, 228, 231)",
                  "--bs-card-bg": "rgb(255, 255, 255)",
                  "--bs-card-border-color": "rgb(228, 228, 231)"
                },
                dark: {
                  "--bs-body-bg": "rgb(9, 9, 11)",
                  "--bs-body-bg-rgb": "9, 9, 11",
                  "--bs-body-color": "rgb(244, 244, 245)",
                  "--bs-secondary-color": "rgb(161, 161, 170)",
                  "--bs-secondary-bg": "rgb(39, 39, 42)",
                  "--bs-secondary-bg-rgb": "39, 39, 42",
                  "--bs-tertiary-bg": "rgb(24, 24, 27)",
                  "--bs-tertiary-bg-rgb": "24, 24, 27",
                  "--bs-border-color": "rgb(63, 63, 70)",
                  "--bs-card-bg": "rgb(12, 12, 14)",
                  "--bs-card-border-color": "rgb(63, 63, 70)"
                }
              },
              stone: {
                light: {
                  "--bs-body-bg": "rgb(250, 250, 249)",
                  "--bs-body-bg-rgb": "250, 250, 249",
                  "--bs-body-color": "rgb(28, 25, 23)",
                  "--bs-secondary-color": "rgb(120, 113, 108)",
                  "--bs-secondary-bg": "rgb(245, 245, 244)",
                  "--bs-secondary-bg-rgb": "245, 245, 244",
                  "--bs-tertiary-bg": "rgb(250, 250, 249)",
                  "--bs-tertiary-bg-rgb": "250, 250, 249",
                  "--bs-border-color": "rgb(231, 229, 228)",
                  "--bs-card-bg": "rgb(255, 255, 255)",
                  "--bs-card-border-color": "rgb(231, 229, 228)"
                },
                dark: {
                  "--bs-body-bg": "rgb(12, 10, 9)",
                  "--bs-body-bg-rgb": "12, 10, 9",
                  "--bs-body-color": "rgb(245, 245, 244)",
                  "--bs-secondary-color": "rgb(168, 162, 158)",
                  "--bs-secondary-bg": "rgb(41, 37, 36)",
                  "--bs-secondary-bg-rgb": "41, 37, 36",
                  "--bs-tertiary-bg": "rgb(28, 25, 23)",
                  "--bs-tertiary-bg-rgb": "28, 25, 23",
                  "--bs-border-color": "rgb(68, 64, 60)",
                  "--bs-card-bg": "rgb(15, 13, 12)",
                  "--bs-card-border-color": "rgb(68, 64, 60)"
                }
              },
              slate: {
                light: {
                  "--bs-body-bg": "rgb(248, 250, 252)",
                  "--bs-body-bg-rgb": "248, 250, 252",
                  "--bs-body-color": "rgb(15, 23, 42)",
                  "--bs-secondary-color": "rgb(100, 116, 139)",
                  "--bs-secondary-bg": "rgb(241, 245, 249)",
                  "--bs-secondary-bg-rgb": "241, 245, 249",
                  "--bs-tertiary-bg": "rgb(248, 250, 252)",
                  "--bs-tertiary-bg-rgb": "248, 250, 252",
                  "--bs-border-color": "rgb(226, 232, 240)",
                  "--bs-card-bg": "rgb(255, 255, 255)",
                  "--bs-card-border-color": "rgb(226, 232, 240)"
                },
                dark: {
                  "--bs-body-bg": "rgb(2, 6, 23)",
                  "--bs-body-bg-rgb": "2, 6, 23",
                  "--bs-body-color": "rgb(248, 250, 252)",
                  "--bs-secondary-color": "rgb(148, 163, 184)",
                  "--bs-secondary-bg": "rgb(30, 41, 59)",
                  "--bs-secondary-bg-rgb": "30, 41, 59",
                  "--bs-tertiary-bg": "rgb(15, 23, 42)",
                  "--bs-tertiary-bg-rgb": "15, 23, 42",
                  "--bs-border-color": "rgb(51, 65, 85)",
                  "--bs-card-bg": "rgb(8, 13, 25)",
                  "--bs-card-border-color": "rgb(51, 65, 85)"
                }
              },
              mauve: {
                light: {
                  "--bs-body-bg": "rgb(251, 250, 252)",
                  "--bs-body-bg-rgb": "251, 250, 252",
                  "--bs-body-color": "rgb(31, 28, 35)",
                  "--bs-secondary-color": "rgb(116, 107, 124)",
                  "--bs-secondary-bg": "rgb(246, 243, 248)",
                  "--bs-secondary-bg-rgb": "246, 243, 248",
                  "--bs-tertiary-bg": "rgb(251, 250, 252)",
                  "--bs-tertiary-bg-rgb": "251, 250, 252",
                  "--bs-border-color": "rgb(233, 228, 238)",
                  "--bs-card-bg": "rgb(255, 255, 255)",
                  "--bs-card-border-color": "rgb(233, 228, 238)"
                },
                dark: {
                  "--bs-body-bg": "rgb(12, 10, 14)",
                  "--bs-body-bg-rgb": "12, 10, 14",
                  "--bs-body-color": "rgb(250, 247, 252)",
                  "--bs-secondary-color": "rgb(168, 156, 177)",
                  "--bs-secondary-bg": "rgb(42, 36, 48)",
                  "--bs-secondary-bg-rgb": "42, 36, 48",
                  "--bs-tertiary-bg": "rgb(31, 28, 35)",
                  "--bs-tertiary-bg-rgb": "31, 28, 35",
                  "--bs-border-color": "rgb(70, 62, 78)",
                  "--bs-card-bg": "rgb(16, 14, 19)",
                  "--bs-card-border-color": "rgb(70, 62, 78)"
                }
              }
            };
            if (baseColorTokens[baseColor]) {
              applyTokens(baseColorTokens[baseColor][builderMode]);
            }
            const applyActionColor = ({ primary, rgb, hover, ring, foregroundDark }) => {
              applyTokens({
                "--bs-primary": primary,
                "--bs-primary-rgb": rgb,
                "--bs-link-color": primary,
                "--bs-link-hover-color": hover,
                "--bs-focus-ring-color": "rgba(" + rgb + ", 0.25)",
                "--moo-primary": primary,
                "--moo-primary-foreground": "rgb(255, 255, 255)",
                "--moo-primary-foreground-dark": foregroundDark,
                "--moo-ring": ring
              });
            };
            if (themeColor === "blue") {
              applyActionColor({
                primary: "rgb(37, 99, 235)",
                rgb: "37, 99, 235",
                hover: "rgb(29, 78, 216)",
                ring: "rgb(96, 165, 250)",
                foregroundDark: "rgb(30, 64, 175)"
              });
            } else if (themeColor === "emerald") {
              applyActionColor({
                primary: "rgb(5, 150, 105)",
                rgb: "5, 150, 105",
                hover: "rgb(4, 120, 87)",
                ring: "rgb(52, 211, 153)",
                foregroundDark: "rgb(6, 78, 59)"
              });
            } else if (themeColor === "violet") {
              applyActionColor({
                primary: "rgb(124, 58, 237)",
                rgb: "124, 58, 237",
                hover: "rgb(109, 40, 217)",
                ring: "rgb(167, 139, 250)",
                foregroundDark: "rgb(76, 29, 149)"
              });
            } else if (themeColor === "amber") {
              applyActionColor({
                primary: "rgb(217, 119, 6)",
                rgb: "217, 119, 6",
                hover: "rgb(180, 83, 9)",
                ring: "rgb(251, 191, 36)",
                foregroundDark: "rgb(120, 53, 15)"
              });
            } else if (themeColor === "rose") {
              applyActionColor({
                primary: "rgb(225, 29, 72)",
                rgb: "225, 29, 72",
                hover: "rgb(190, 18, 60)",
                ring: "rgb(251, 113, 133)",
                foregroundDark: "rgb(136, 19, 55)"
              });
            } else if (themeColor === "cyan") {
              applyActionColor({
                primary: "rgb(8, 145, 178)",
                rgb: "8, 145, 178",
                hover: "rgb(14, 116, 144)",
                ring: "rgb(34, 211, 238)",
                foregroundDark: "rgb(21, 94, 117)"
              });
            } else if (themeColor === "orange") {
              applyActionColor({
                primary: "rgb(234, 88, 12)",
                rgb: "234, 88, 12",
                hover: "rgb(194, 65, 12)",
                ring: "rgb(251, 146, 60)",
                foregroundDark: "rgb(124, 45, 18)"
              });
            } else if (themeColor === "pink") {
              applyActionColor({
                primary: "rgb(219, 39, 119)",
                rgb: "219, 39, 119",
                hover: "rgb(190, 24, 93)",
                ring: "rgb(244, 114, 182)",
                foregroundDark: "rgb(131, 24, 67)"
              });
            } else if (themeColor === "red") {
              applyActionColor({
                primary: "rgb(220, 38, 38)",
                rgb: "220, 38, 38",
                hover: "rgb(185, 28, 28)",
                ring: "rgb(248, 113, 113)",
                foregroundDark: "rgb(127, 29, 29)"
              });
            }
            const applyChartColor = (values) => {
              applyTokens(Object.fromEntries(
                values.map((value, index) => ["--moo-chart-" + (index + 1), value])
              ));
            };
            if (chartColor === "pastel") {
              applyChartColor([
                "rgb(103, 169, 232)",
                "rgb(118, 187, 170)",
                "rgb(246, 198, 110)",
                "rgb(198, 157, 232)",
                "rgb(238, 135, 142)"
              ]);
            } else if (chartColor === "vivid") {
              applyChartColor([
                "rgb(37, 99, 235)",
                "rgb(5, 150, 105)",
                "rgb(217, 119, 6)",
                "rgb(124, 58, 237)",
                "rgb(225, 29, 72)"
              ]);
            } else if (chartColor === "blue") {
              applyChartColor([
                "rgb(37, 99, 235)",
                "rgb(96, 165, 250)",
                "rgb(147, 197, 253)",
                "rgb(29, 78, 216)",
                "rgb(30, 64, 175)"
              ]);
            } else if (chartColor === "emerald") {
              applyChartColor([
                "rgb(5, 150, 105)",
                "rgb(52, 211, 153)",
                "rgb(110, 231, 183)",
                "rgb(4, 120, 87)",
                "rgb(6, 95, 70)"
              ]);
            } else if (chartColor === "violet") {
              applyChartColor([
                "rgb(139, 92, 246)",
                "rgb(167, 139, 250)",
                "rgb(196, 181, 253)",
                "rgb(124, 58, 237)",
                "rgb(109, 40, 217)"
              ]);
            } else if (chartColor === "amber") {
              applyChartColor([
                "rgb(217, 119, 6)",
                "rgb(245, 158, 11)",
                "rgb(251, 191, 36)",
                "rgb(180, 83, 9)",
                "rgb(146, 64, 14)"
              ]);
            } else if (chartColor === "rose") {
              applyChartColor([
                "rgb(225, 29, 72)",
                "rgb(244, 63, 94)",
                "rgb(251, 113, 133)",
                "rgb(190, 18, 60)",
                "rgb(159, 18, 57)"
              ]);
            }
            if (builder.headingFont === "geist") {
              applyTokens({
                "--moo-heading-font-family": "\"Geist\", var(--bs-body-font-family)"
              });
            } else if (builder.headingFont === "system") {
              applyTokens({
                "--moo-heading-font-family": "system-ui, -apple-system, \"Segoe UI\", sans-serif"
              });
            }
            if (builder.bodyFont === "geist") {
              applyTokens({
                "--bs-body-font-family": "\"Geist\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
              });
            } else if (builder.bodyFont === "system") {
              applyTokens({
                "--bs-body-font-family": "system-ui, -apple-system, \"Segoe UI\", sans-serif"
              });
            }
            if (builder.radius === "compact") {
              applyTokens({
                "--bs-border-radius": "0.25rem",
                "--bs-border-radius-sm": "0.1875rem",
                "--bs-border-radius-lg": "0.375rem",
                "--bs-border-radius-xl": "0.5rem",
                "--bs-border-radius-xxl": "0.75rem"
              });
            } else if (builder.radius === "large") {
              applyTokens({
                "--bs-border-radius": "0.75rem",
                "--bs-border-radius-sm": "0.5rem",
                "--bs-border-radius-lg": "1rem",
                "--bs-border-radius-xl": "1.25rem",
                "--bs-border-radius-xxl": "1.5rem"
              });
            }
          }
        } catch (_) {
          /* Theme Builder storage is best-effort and never blocks paint. */
        }
      })();
    </script>
    {% block font_preload %}
    <link rel="preload" href="{{ root_path }}assets/fonts/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
    {% endblock %}
    <link rel="stylesheet" href="{{ root_path }}assets/css/moo-ui.css?v={{ asset_version }}">
    <link rel="stylesheet" href="{{ root_path }}assets/css/catalog.css?v={{ asset_version }}">
  </head>
  <body>
    <a class="visually-hidden-focusable" href="#main-content">
      Skip to component content
    </a>
    {% block body %}{% endblock %}
    <script defer src="{{ root_path }}assets/js/bootstrap.bundle.min.js?v={{ asset_version }}"></script>
    <script type="module" src="{{ root_path }}assets/js/catalog/index.js?v={{ asset_version }}"></script>
  </body>
</html>
