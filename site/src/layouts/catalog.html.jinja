{% extends "layouts/base.html.jinja" %}
{% from "layouts/app.html.jinja" import app %}
{% from "layouts/page.html.jinja" import page %}
{% from "shell/navbar.html.jinja" import render_catalog_overlays with context %}
{% from "shell/sidebar.html.jinja" import render_catalog_sidebar with context %}
{% from "includes/page-navigation.html.jinja" import render_section_page_pagination %}

{% block owner_prepaint %}
  {% include "includes/catalog-theme-prepaint.html.jinja" %}
{% endblock %}

{% block body %}
  <div class="moo-catalog" data-moo-shell="catalog">
    {% call(slot) app(
      navigation="sidebar",
      sidebar_key="catalog-shell",
      sidebar_id="catalog-sidebar",
      variant="sidebar",
      aria_label="Catalog navigation",
      shell_mode="viewport"
    ) %}
      {% if slot == "sidebar" %}
        {{ render_catalog_sidebar() }}
      {% elif slot == "page" %}
        {% call(region) page(width="xl", header_width="fluid") %}
          {% if region == "header" %}
            {% include "shell/navbar.html.jinja" %}
          {% elif region == "main" %}
            <div class="row gx-0">
              <div class="col px-md-5">
                {% set has_example_toc = current_page_kind in ["component", "utility"] %}
                {% set has_child_page_navigation = current_page_kind in ["component", "utility", "block"] %}
                {% set child_page_navigation_items = site_pages %}
                {% set content_html %}{% block content %}{% endblock %}{% endset %}
                {% set example_toc_items = content_html | example_toc_items if has_example_toc else [] %}
                {% if has_example_toc or has_child_page_navigation %}
                  <div class="moo-doc-layout" data-moo-component-doc-layout>
                    <div class="moo-doc-main">
                {% endif %}
                {{ content_html | safe }}
                {% if has_child_page_navigation %}
                  {{ render_section_page_pagination(current_slug, child_page_navigation_items, root_path) }}
                {% endif %}
                {% if has_example_toc or has_child_page_navigation %}
                    </div>
                    {% if has_example_toc %}
                      <aside class="moo-doc-toc d-none d-xl-block" aria-label="On this page" data-moo-component-toc{% if example_toc_items | length == 0 %} hidden{% endif %}>
                      <div class="moo-doc-toc__inner">
                        <div class="moo-doc-toc__label">On this page</div>
                        <nav class="nav flex-column" aria-label="{% if current_section == 'utils' %}Utility examples{% else %}Component examples{% endif %}" data-moo-component-toc-nav>
                          {% for item in example_toc_items %}
                            <a class="nav-link{% if loop.first %} active{% endif %}" href="#{{ item.id }}"{% if loop.first %} aria-current="true"{% endif %}>{{ item.label }}</a>
                          {% endfor %}
                        </nav>
                      </div>
                      </aside>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% elif region == "footer" %}
            {% block footer %}
              {% include "shell/footer.html.jinja" %}
            {% endblock %}
          {% endif %}
        {% endcall %}
      {% endif %}
    {% endcall %}
    {{ render_catalog_overlays() }}
  </div>
  <script src="{{ root_path }}assets/js/catalog-prepaint.js?v={{ asset_version }}"></script>
{% endblock %}
