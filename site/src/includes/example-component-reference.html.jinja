{% from "components/popover.html.jinja" import popover_dismiss_trigger %}

{% macro example_component_reference(slug, popover=true, placement="top", learn_more_label="Learn more") %}
  {% set ns = namespace(component=None) %}
  {% for component in catalog %}
    {% if component.slug == slug %}
      {% set ns.component = component %}
    {% endif %}
  {% endfor %}
  {% set label = ns.component.label if ns.component else slug | replace("-", " ") | title %}
  {% set description = ns.component.description if ns.component else "" %}
  {% set href = site_href("components/" ~ slug ~ ".html", root_path) %}
  {% if popover and description %}
    {% set popover_content -%}
      {{ description }}
      <a href='{{ canonical_url("components/" ~ slug ~ ".html") }}' target='_blank' rel='noopener noreferrer'>{{ learn_more_label }}</a>
    {%- endset %}
    {{ popover_dismiss_trigger(label, popover_content | trim, title=label, placement=placement, html=true, href=none, container="body", extra_class="moo-examples-footer__component-trigger") }}
  {% else %}
    <a href="{{ href }}">{{ label }}</a>
  {% endif %}
{% endmacro %}
