{% macro render_reference(lead, href, label, show_details=true) %}
  {% set details = none %}
  {% if show_details and component_ownership is defined and current_slug is defined and current_slug in component_ownership %}
    {% set details = component_ownership[current_slug] %}
  {% endif %}
  <aside class="mt-5" aria-label="Component reference">
    <p class="text-body-secondary mb-0">
      {{ lead }}
      <a href="{{ href }}" target="_blank" rel="noopener noreferrer">{{ label }}</a>.
    </p>
    {% if details %}
      <div class="border rounded p-3 mt-3" data-moo-component-reference>
        <p class="fw-semibold text-body mb-3">Component reference</p>
        <dl class="row g-2 small mb-0">
          <dt class="col-sm-3 text-body">Status</dt>
          <dd class="col-sm-9 mb-0">{{ details.maturity | capitalize }}</dd>
          <dt class="col-sm-3 text-body">Runtime</dt>
          <dd class="col-sm-9 mb-0">{{ details.runtimeOwner }}</dd>
          <dt class="col-sm-3 text-body">Markup</dt>
          <dd class="col-sm-9 mb-0">{{ details.markupOwner }}</dd>
        </dl>
      </div>
    {% endif %}
  </aside>
{% endmacro %}
