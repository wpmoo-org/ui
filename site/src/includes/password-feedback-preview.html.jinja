{# Local-only requirements demonstration. No strength estimator is installed. #}
{% from "components/button.html.jinja" import button %}
{% from "components/card.html.jinja" import card %}
{% from "components/field.html.jinja" import form, field, field_description, field_group, fieldset %}
{% from "components/tooltip.html.jinja" import tooltip_trigger %}
{% from "components/input.html.jinja" import input %}
{% macro password_feedback_preview() -%}
  {% set policy = {
    "version": 3, "minlength": 12, "maxlength": 128,
    "rules": [
      {"key": "length", "label": "At least 12 characters"},
      {"key": "case", "label": "Upper and lower case letters"},
      {"key": "number", "label": "At least one number"},
      {"key": "symbol", "label": "At least one symbol such as ! # $ or %"},
      {"key": "maximum", "warning": true, "label": "Use at most 128 characters."}
    ],
    "whitespace": " \t\r\n\u001c\u001d\u001e\u001f\u0085\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000"
  } %}
  {% call card(title="Reset your password", subtitle="Choose a new password for your account.") %}
    {% call form() %}
    {% call field_group() %}
      {% call field() %}
        {{ input(label="Password", id="password-preview-input", type="password", autocomplete="new-password",
          placeholder="Type a sample password", describedby="password-preview-requirements") }}
      {% endcall %}
      {% call field() %}
        {{ input(label="Confirm Password", id="password-preview-confirm", type="password", autocomplete="new-password",
          placeholder="Repeat the sample password", describedby="password-preview-requirements") }}
      {% endcall %}
      {% call fieldset("Password requirements", id="password-preview-requirements", legend_class="visually-hidden",
          requirements={"input": "password-preview-input", "confirmation": "password-preview-confirm", "submit": "password-preview-submit", "policy": policy}) %}
        {% call field_group(extra_class="gap-1") %}
          {% for rule in policy.rules if not rule.get('warning') %}
            {{ field_description("password-preview-requirements-" ~ rule.key, rule.label, extra_class="m-0") }}
          {% endfor %}
        {% endcall %}
        {% call field_group(extra_class="gap-1 mb-0 ps-3 text-danger", as_list=true) %}
          {% for rule in policy.rules if rule.get('warning') %}
            {{ field_description("password-preview-requirements-" ~ rule.key, rule.label, extra_class="m-0 text-danger", hidden=true, list_item=true) }}
          {% endfor %}
          {{ field_description("password-preview-requirements-confirmation", "The passwords must match.", extra_class="m-0 text-danger", hidden=true, list_item=true) }}
        {% endcall %}
        {{ field_description("password-preview-requirements-summary", "Enter a sample password to check the requirements.",
           extra_class="visually-hidden", live="polite") }}
        {{ tooltip_trigger("Reset Password", "Complete every password requirement and confirm the same password.",
          id="password-preview-requirements-submit-hint", disabled=true, hidden=true, extra_class="w-100 d-grid") }}
      {% endcall %}
      {{ button("Reset Password", id="password-preview-submit", type="submit", disabled=true, extra_class="w-100") }}
    {% endcall %}
    {% endcall %}
  {% endcall %}
{%- endmacro %}
