{% from "components/typography.html.jinja" import typography %}

{% macro render_block_example(id, title, description, content, preview_class="", frame_src="", frame_width=1280, frame_height=720, frame_variants=[], frame_viewports=[], show_header=true) %}
  {% set rendered = content | dedent_html %}
  {% set source = rendered | format_html %}
  {% set title_slug = title | slugify %}
  {% set frame_state = namespace(src=frame_src, width=frame_width, height=frame_height, variant_label="") %}
  {% if frame_variants %}
    {% for variant in frame_variants %}
      {% if loop.first or variant.active | default(false) %}
        {% set frame_state.src = variant.src %}
        {% set frame_state.width = variant.width | default(frame_width) %}
        {% set frame_state.height = variant.height | default(frame_height) %}
        {% set frame_state.variant_label = variant.label %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if frame_viewports %}
    {% for viewport in frame_viewports %}
      {% if viewport.active | default(false) %}
        {% set frame_state.width = viewport.width | default(frame_state.width) %}
        {% set frame_state.height = viewport.height | default(frame_state.height) %}
      {% endif %}
    {% endfor %}
  {% endif %}
  <section class="moo-example" data-example="{{ id }}"{% if show_header %} aria-labelledby="{{ title_slug }}"{% else %} aria-label="{{ title }}"{% endif %}>
    {% if show_header %}
      <div class="moo-example__header">
        {{ typography(title, variant="example-title", id=title_slug) }}
        <p class="text-body-secondary mb-0">{{ description | safe }}</p>
      </div>
    {% endif %}
    <div class="moo-example__surface">
      <div class="moo-example__preview{% if preview_class %} {{ preview_class }}{% endif %}">
        {% if frame_state.src %}
          <div
            class="moo-block-preview"
            data-moo-block-frame-shell
            data-moo-frame-width="{{ frame_state.width }}"
            data-moo-frame-height="{{ frame_state.height }}"
          >
            <div class="moo-block-preview__toolbar">
              <div class="moo-block-preview__toolbar-start">
                {% if frame_variants %}
                  <div class="moo-block-preview__control">
                    <span class="small text-body-secondary">Variant</span>
                    <div class="dropdown">
                      <button class="btn btn-sm btn-outline-secondary moo-block-preview__variant-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span data-moo-frame-variant-label>{{ frame_state.variant_label }}</span>
                        {{ render_icon("chevron-down", "inline-end") }}
                      </button>
                      <ul class="dropdown-menu">
                        {% for variant in frame_variants %}
                          {% set is_active = (variant.label == frame_state.variant_label) %}
                          <li>
                            <button
                              class="dropdown-item{% if is_active %} active{% endif %}"
                              type="button"
                              data-moo-frame-variant
                              data-moo-frame-src="{{ variant.src }}"
                              data-moo-frame-variant-label="{{ variant.label }}"
                              {% if is_active %}
                                aria-current="true"
                              {% endif %}
                            >
                              {{ variant.label }}
                            </button>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  </div>
                {% endif %}
                <span class="small text-body-secondary" data-moo-frame-size-label>{{ frame_state.width }} x {{ frame_state.height }}</span>
              </div>
              <div class="moo-block-preview__toolbar-end">
                {% if frame_viewports %}
                  <div class="btn-group btn-group-sm" role="group" aria-label="Preview viewport">
                    {% for viewport in frame_viewports %}
                      {% set is_active = viewport.active | default(false) %}
                      <button
                        class="btn btn-outline-secondary btn-icon-sm{% if is_active %} active{% endif %}"
                        type="button"
                        data-moo-frame-preset
                        data-moo-frame-width="{{ viewport.width }}"
                        data-moo-frame-height="{{ viewport.height }}"
                        data-moo-frame-preset-label="{{ viewport.label }}"
                        aria-label="{{ viewport.label }} preview"
                        aria-pressed="{{ 'true' if is_active else 'false' }}"
                        title="{{ viewport.label }}"
                      >
                        {{ render_icon(viewport.icon, "inline-start") }}
                      </button>
                    {% endfor %}
                  </div>
                {% endif %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ frame_state.src }}" target="_blank" rel="noopener noreferrer" data-moo-frame-standalone-link>
                  {{ render_icon("external-link", "inline-start") }}
                  Open standalone
                </a>
              </div>
            </div>
            <div class="moo-block-preview__viewport" data-moo-block-frame-viewport>
              <div class="moo-block-preview__loading" data-moo-block-frame-loading aria-hidden="true">
                <span class="moo-block-preview__loading-indicator">
                  <span class="moo-block-preview__loading-spinner" aria-hidden="true"></span>
                  Loading preview
                </span>
              </div>
              <iframe
                class="moo-block-preview__frame"
                data-moo-block-frame
                src="{{ frame_state.src }}"
                title="{{ title }} preview"
                width="{{ frame_state.width }}"
                height="{{ frame_state.height }}"
                loading="lazy"
              ></iframe>
            </div>
          </div>
        {% else %}
          {{ rendered | safe }}
        {% endif %}
      </div>
      <div class="moo-example__source" data-moo-code-panel data-expanded="false">
        <pre class="moo-code scroll-fade-x no-scrollbar" id="{{ id }}-code" tabindex="0"><span class="moo-code__lines" aria-hidden="true">{{ source | line_numbers }}</span><code class="language-html">{{ source | highlight_html }}</code></pre>
        <div class="moo-code__reveal">
          <button class="btn btn-sm btn-outline-secondary" type="button" data-moo-code-toggle aria-expanded="false" aria-controls="{{ id }}-code">
            View Code
          </button>
        </div>
        <button class="btn btn-outline-secondary btn-icon-sm moo-code__copy" type="button" data-moo-code-copy hidden aria-label="Copy code" title="Copy code">
          <span data-moo-copy-icon="copy">{{ render_icon("copy", "inline-start") }}</span>
          <span data-moo-copy-icon="check" hidden>{{ render_icon("check", "inline-start") }}</span>
        </button>
        <span class="visually-hidden" data-moo-copy-status role="status"></span>
      </div>
    </div>
  </section>
{% endmacro %}
