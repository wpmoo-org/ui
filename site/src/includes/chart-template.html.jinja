  ) }}
{% endmacro %}

{% macro render_chart_usage(root_path="", show_gallery_link=false) %}
  <p>Render a <code>.moo-chart</code> root with one direct child <code>&lt;canvas&gt;</code>. The <code>data-chart</code> attribute accepts <code>{{ chart_public_types }}</code>, while <code>data-chart-data</code> carries the serialized <code>{labels, datasets}</code> data.</p>
  <p>Use <code>data-chart-options</code> for JSON-object Chart.js options such as stacked scales, interaction mode, cutout, rotation, or legend display. Functions and callbacks are not serializable in HTML; pass them through the programmatic <code>getOrCreateInstance</code> config instead.</p>
  <p>Give the root an explicit height. Radial Charts are represented by Chart.js <code>doughnut</code> and <code>polarArea</code>, not by a separate public <code>radial</code> type.</p>
  {% if show_gallery_link %}
    <div class="mt-3">
      {{ button(
        "View chart examples",
        variant="outline",
        size="sm",
        element="a",
        href=site_href("charts/index.html", root_path),
        icon_end="arrow-right"
      ) }}
    </div>
  {% endif %}
{% endmacro %}

{% macro render_chart_intro_usage(root_path="", show_gallery_link=false) %}
  {% set usage %}
    {{ render_chart_usage(root_path=root_path, show_gallery_link=show_gallery_link) }}
  {% endset %}
  {{ render_component_intro(
    render_chart_intro_preview(),
    usage,
    preview_class="moo-example__preview--medium"
  ) }}
{% endmacro %}

{% macro render_chart_contract_sections() %}
  <h2 id="chart-html-anatomy" class="h4 mt-5 mb-3">HTML Anatomy</h2>
  <p class="mb-4">
    These are the public HTML hooks that applications can inspect or target.
    They describe rendered markup, not the repository's internal Jinja build
    helpers.
  </p>

  {% set chart_parts = [
    {"id": "chart-root", "selector": "<code>.moo-chart</code>", "summary": "Public root element. It owns the Chart.js instance and the theme observer."},
    {"id": "chart-id", "selector": "<code>id</code>", "summary": "Required stable identifier for the chart root and its server-rendered contract."},
    {"id": "chart-type", "selector": "<code>[data-chart]</code>", "summary": "Chart type and initializer attribute. Supported values are <code>area</code>, <code>line</code>, <code>bar</code>, <code>pie</code>, <code>doughnut</code>, <code>polarArea</code>, <code>radar</code>, <code>scatter</code>, and <code>bubble</code>."},
    {"id": "chart-data", "selector": "<code>[data-chart-data]</code>", "summary": "Serialized <code>{labels, datasets}</code> JSON. Scatter and bubble data keep <code>labels: []</code> with object points inside datasets."},
    {"id": "chart-options", "selector": "<code>[data-chart-options]</code>", "summary": "Optional JSON-object Chart.js options pass-through. Unsafe prototype keys are ignored and programmatic config wins."},
    {"id": "chart-canvas", "selector": "<code>.moo-chart &gt; canvas</code>", "summary": "The first child canvas. It is resolved deterministically and is required."}
  ] %}

  {% set chart_parts_rows = [] %}
  {% for part in chart_parts %}
    {% set _ = chart_parts_rows.append([part["selector"], part["summary"]]) %}
  {% endfor %}
  {{ table(
    ["Selector", "Purpose"],
    chart_parts_rows,
    row_ids=chart_parts | map(attribute="id") | list,
    row_header=true,
    extra_class="align-middle mb-5"
  ) }}

  {% set chart_markup_example %}
  {{ chart(
    "chart-html-example",
    {"labels": ["Jan", "Feb", "Mar"], "datasets": [{"label": "Revenue", "data": [4000, 3200, 4800]}]},
    "Monthly revenue line chart",
    type="line",
    options={"plugins": {"legend": {"display": false}}},
    attrs='style="height: 17.5rem"'
  ) }}
  {% endset %}
  {{ render_code_snippet("chart-html-anatomy-example", chart_markup_example, "html") }}

  <h2 id="chart-javascript" class="h4 mt-5 mb-3">JavaScript</h2>
  <p>
    Chart.js is bundled into the published <code>chart.js</code> entrypoint through
    <code>chart.js/auto</code>; the wrapper never reads a browser global Chart
    object and never loads a runtime CDN script. Importing the module never scans the document.
    Initialize only a <code>.moo-chart</code> root your application owns: repeated
    initialization returns the same instance, and <code>dispose()</code> destroys the
    Chart.js instance, disconnects the theme observer, cancels pending work, and
    releases the instance registration.
  </p>
  {% set chart_import_example %}
  import MooChart from "@wpmoo/ui/chart.js";

  const element = document.querySelector(".moo-chart");

  if (element) {
    const chart = MooChart.getOrCreateInstance(element);

    // getOrCreateInstance is idempotent: the same instance is returned.
    const again = MooChart.getOrCreateInstance(element);
    console.assert(chart === again);

    // Later, release Chart.js and the theme observer.
    chart.dispose();
  }
  {% endset %}
  {{ render_code_snippet("chart-javascript-import", chart_import_example, "js") }}

  {% set chart_tooltip_callback_example %}
  import MooChart from "@wpmoo/ui/chart.js";

  MooChart.getOrCreateInstance(document.querySelector("#chart-tooltip-custom"), {
    options: {
      plugins: {
        tooltip: {
          callbacks: {
            label(context) {
              return `${context.dataset.label}: ${context.formattedValue}`;
            },
          },
        },
      },
    },
  });
  {% endset %}
  {{ render_code_snippet("chart-tooltip-callback", chart_tooltip_callback_example, "js") }}

  <h2 id="chart-theming" class="h4 mt-5 mb-3">Theming</h2>
  <p class="mb-4">
    Chart colors are derived from Bootstrap's semantic <code>--bs-*</code> tokens at
    runtime, not from hardcoded theme values. A <code>MutationObserver</code> watches
    the nearest <code>data-bs-theme</code> scope, falling back to the document
    element; when that scope changes, each chart re-reads the tokens and re-themes
    its datasets, grid lines, legend, and tooltip without a reload. Line chart
    points use their series color for the point fill, border, and hover state so
    light theme points do not pick up a dark neutral outline. Charts also
    reflow on resize: they are responsive and drop aspect-ratio locking, so the
    same markup fills a desktop card or a narrow mobile viewport without
    layout-specific switches.
  </p>

  <h2 id="chart-accessibility" class="h4 mt-5 mb-3">Accessibility</h2>
  <p class="mb-0">
    The canvas is a raster of pixels, so give it a text alternative: set
    <code>role="img"</code> and a descriptive <code>aria-label</code> on the
    <code>&lt;canvas&gt;</code>, or provide an adjacent data table for the same series.
    Keep legends visible rather than encoding meaning in color alone, and preserve
    the default tooltip so individual values remain reachable on touch and with a
    pointer.
  </p>
{% endmacro %}

