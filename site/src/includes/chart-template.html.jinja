{% macro chart_content_example(example_id, title, description, content, preview_class="moo-example__preview--medium", category_label="Chart") %}
  {% set rendered = content | dedent_html %}
  {% set source = rendered | format_html %}
  {% set code_id = example_id ~ "-code" %}
  {% set chart_actions %}
    <div class="moo-chart-example__actions" data-moo-code-copy-scope>
      <button
        class="btn btn-outline-secondary btn-icon-xs"
        type="button"
        data-moo-code-copy-target="#{{ code_id }}"
        aria-label="Copy code"
        title="Copy code"
      >
        {{ render_icon("copy", "inline-start")
          | replace('data-icon="inline-start"', ('data-moo-copy-icon="copy" data-icon="inline-start"' | safe))
        }}
        {{ render_icon("check", "inline-start")
          | replace('data-icon="inline-start"', ('data-moo-copy-icon="check" data-icon="inline-start" hidden' | safe))
        }}
      </button>
      {{ codepen_button(
        "Moo UI " ~ title,
        description | striptags,
        source,
        chart_codepen_css(),
        ["moo-ui", "chartjs", "charts"],
        js=chart_codepen_js(),
        label="Try in CodePen",
        icon="codepen",
        extra_class="moo-chart-example__codepen"
      ) }}
      <span class="visually-hidden" data-moo-copy-status role="status"></span>
    </div>
  {% endset %}
  {{ render_example(
    example_id,
    title,
    description,
    rendered,
    preview_class=("moo-chart-example__preview" ~ (" " ~ preview_class if preview_class else "")),
    source_content=source,
    extra_class="moo-chart-example",
    surface_class="moo-chart-example__surface",
    toolbar_label=category_label,
    toolbar_icon="chart-no-axes-combined",
    toolbar_action=chart_actions,
    header_inside_surface=true,
    source_class="moo-chart-example__source"
  ) }}
{% endmacro %}

{% macro chart_example(example_id, title, description, chart_id, type, data, aria_label, options=None, preview_class="moo-example__preview--medium", category_label="") %}
  {% set example %}
    {{ chart(
      chart_id,
      data,
      aria_label,
      type=type,
      options=options,
      extra_class="w-100",
      attrs='style="height: 17.5rem"'
    ) }}
  {% endset %}
  {{ chart_content_example(
    example_id,
    title,
    description,
    example,
    preview_class=preview_class,
    category_label=category_label or chart_type_labels[type]
  ) }}
{% endmacro %}

{% macro render_chart_intro_preview() %}
  {{ chart(
    "chart-area-default",
    chart_area_default_data,
