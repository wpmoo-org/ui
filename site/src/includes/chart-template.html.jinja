    {"label": "Mobile", "data": [80, 200, 120, 190, 130, 140]}
  ]
} %}

{% set chart_type_labels = {
  "area": "Area Chart",
  "line": "Line Chart",
  "bar": "Bar Chart",
  "pie": "Pie Chart",
  "doughnut": "Doughnut Chart",
  "polarArea": "Polar Area Chart",
  "radar": "Radar Chart",
