{% macro render_code_snippet(id, content, language="text") %}
  {% set source = content | dedent_html %}
  <div class="moo-example__source moo-doc-code-panel" data-moo-code-panel data-expanded="true">
    <pre class="moo-code scroll-fade-x no-scrollbar" id="{{ id }}-code"><span class="moo-code__lines" aria-hidden="true"></span><code class="language-{{ language }}">{{ source | highlight_html }}</code></pre>
    <button class="btn btn-outline-secondary btn-icon-sm moo-code__copy" type="button" data-moo-code-copy aria-label="Copy code" title="Copy code">
      <span data-moo-copy-icon="copy">{{ render_icon("copy", "inline-start") }}</span>
      <span data-moo-copy-icon="check" hidden>{{ render_icon("check", "inline-start") }}</span>
    </button>
    <span class="visually-hidden" data-moo-copy-status role="status"></span>
  </div>
{% endmacro %}
