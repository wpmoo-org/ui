{% macro examples_footer_codepen_css() -%}
{#- The footer band is position: fixed so it reads as an always-visible
   app-shell bottom bar, like it does on the real site (there it's pinned
   by the docs shell around it, not by anything in this page itself).
   Fixed takes it out of flow, so .moo-examples-page needs bottom
   clearance equal to its height or the last row/pagination controls
   would render underneath it -- --moo-examples-footer-height (measured
   from the actual rendered band, desktop and the stacked mobile layout
   below) drives both the reserved min-height and that clearance from
   one place instead of two guesses that can drift apart. z-index is
   deliberately below Bootstrap's own backdrop/offcanvas/modal tiers
   (1040+) so an open Sheet or Dialog dims the footer along with the
   rest of the page, same as real content. #}
body {
  --moo-examples-footer-height: 3rem;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.moo-examples-page {
  flex: 1 1 auto;
  padding-bottom: calc(var(--moo-examples-footer-height) + 1.5rem);
}

.moo-examples-page .datatable {
  --moo-datatable-bulk-actions-bottom: calc(var(--moo-examples-footer-height) + 1rem);
}

.moo-examples-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1020;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: var(--moo-examples-footer-height);
  padding: 0.75rem 1.5rem;
  color: var(--bs-secondary-color);
  font-size: 0.875rem;
  /* On the real site this band sits inside the docs shell, next to
     other chrome that already reads as "not page content" -- a hairline
     border is enough there. Standalone in a CodePen there's nothing else
     to contrast against (no CodePen action ever renders in its own
     export, see codepen_button()'s doc comment), so it needs its own
     visible surface to read as a footer band rather than trailing text.
     --bs-tertiary-bg (#fafafa in this theme) turned out too close to
     --bs-body-bg (#fff) to read as a change at all -- secondary-bg
     (#f4f4f5) is the nearest token with an actually perceptible delta. */
  background: var(--bs-secondary-bg);
  border-top: var(--bs-border-width) solid var(--bs-border-color);
}

{#- A static gradient standing in for the real site's scroll-fade-y:
   that one is scroll-driven (animation-timeline: scroll(self y)), which
   needs the faded element to be its own overflow:auto scroll container
   -- exactly the body{height:100vh;overflow:hidden} + .moo-examples-page
   {overflow-y:auto} setup that broke the Sheet/Offcanvas here before
   (see codepen-scroll-fade-footer-reverted memory). The whole page
   scrolls normally now, so instead this is a fixed strip sitting right
   above the fixed footer -- content fades to the page background as it
   scrolls under it, no scroll container of its own to fight with fixed
   descendants. #}
.moo-examples-footer::before {
  content: "";
  position: absolute;
  right: 0;
  bottom: 100%;
  left: 0;
  height: 2rem;
  background: linear-gradient(to bottom, transparent, var(--bs-body-bg));
  pointer-events: none;
}

{{ example_component_reference_codepen_css() }}

@media (max-width: 576px) {
  body {
    --moo-examples-footer-height: 7rem;
  }

  .moo-examples-footer {
    flex-direction: column;
    align-items: stretch;
    text-align: center;
  }
}
{%- endmacro %}

