{#- Chart initialization for the Dashboard Overview CodePen. CodePen is
   intentionally isolated from the catalog bundle: the catalog loads
   MooChart from the site's own remapped module path, but a real CodePen
   pen cannot `import` from ui.wpmoo.org because that origin sends no
   Access-Control-Allow-Origin header, so the cross-origin import would be
   blocked by CORS. unpkg.com serves the published @wpmoo/ui bundle with a
   CORS header, so this small DOM adapter dynamically imports the
   version-pinned Moo bundle from there. It never loads Chart.js directly:
   the published dist/js/chart.js already bundles Chart.js and exposes
   MooChart as its default export. #}
{% macro dashboard_codepen_js() -%}
function initializeMooDashboardCharts(MooChart) {
  document.querySelectorAll(".moo-chart").forEach((element) => {
    MooChart.getOrCreateInstance(element);
  });
}

function startMooDashboardCharts() {
  import("https://unpkg.com/@wpmoo/ui@{{ product.version }}/dist/js/chart.js")
    .then((module) => {
      initializeMooDashboardCharts(module.default);
    })
    .catch((error) => {
      console.error("Moo UI Chart failed to load for this CodePen example.", error);
    });
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", startMooDashboardCharts, { once: true });
} else {
  startMooDashboardCharts();
}
{%- endmacro %}

{#- Submits a CodePen "Pen Definition" prefill POST (https://blog.codepen.io/documentation/prefill/)
   in a new tab: the pen's HTML/CSS panels are pre-filled with this exact
   page's own markup (internal links rewritten to absolute ui.wpmoo.org
   URLs so they still work standalone) plus the shared external
   moo-ui.css stylesheet, version-locked to the site's own package
   version so it never drifts from what's actually live. data-moo-codepen-form
   opts this form out of examples-forms.js's inert-demo-form guard --
   unlike every other form on an Examples page, this one is meant to
   really submit.

   Lives in the page's own "demo only / built with X, Y, Z" meta footer,
   not next to the page/card title -- that title row is the simulated
   app's own chrome (Tasks' "New Task" button lives there too), and this
   button is about the demo, not part of it. Callers render their body
   markup through a local macro twice: once with no action (to capture a
   clean `html` for the payload below, before this button exists), once
   with this macro's own output passed back in (for the page actually
   shown to a visitor) -- see any Examples page for the pattern. #}
{% macro codepen_button(title, description, html, css, tags, js="", js_external="", js_module=false, editors="110") -%}
  {% set uses_popover = 'data-bs-toggle="popover"' in html %}
  {% set resolved_js_external = js_external %}
  {% if uses_popover and not resolved_js_external %}
    {% set resolved_js_external = "https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/js/bootstrap.bundle.min.js" %}
  {% endif %}
  {% set resolved_js = js %}
  {% if uses_popover and "initializeMooCodePenPopovers" not in resolved_js %}
    {% set popover_js -%}
function initializeMooCodePenPopovers() {
  const Popover = window.bootstrap && window.bootstrap.Popover;
  if (!Popover) {
    return;
  }

  document.querySelectorAll('[data-bs-toggle="popover"]').forEach((element) => {
    Popover.getOrCreateInstance(element);
  });
}

function loadMooCodePenBootstrap(callback) {
  if (window.bootstrap && window.bootstrap.Popover) {
    callback();
    return;
  }

  const script = document.createElement("script");
  script.src = "https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/js/bootstrap.bundle.min.js";
  script.onload = callback;
  document.head.appendChild(script);
}

function startMooCodePenPopovers() {
  loadMooCodePenBootstrap(initializeMooCodePenPopovers);
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", startMooCodePenPopovers, { once: true });
} else {
  startMooCodePenPopovers();
}
    {%- endset %}
    {% set resolved_js = (resolved_js ~ "\n\n" ~ popover_js) | trim %}
  {% endif %}
  {% set payload = {
    "title": title,
    "description": description,
    "html": html | absolutize_links,
    "html_pre_processor": "none",
    "css": css,
    "css_pre_processor": "none",
    "css_starter": "neither",
    "css_external": "https://unpkg.com/@wpmoo/ui@" ~ product.version ~ "/dist/assets/css/moo-ui.css",
    "js": resolved_js,
    "js_pre_processor": "none",
    "js_external": resolved_js_external,
    "tags": tags,
    "editors": editors,
    "js_module": js_module
  } %}
  <form action="https://codepen.io/pen/define" method="POST" target="_blank" class="moo-examples-footer__codepen" data-moo-codepen-form>
    <input type="hidden" name="data" value="{{ payload | moo_json | forceescape }}">
    {{ button("Open in CodePen", type="submit", variant="outline", size="sm", icon_start="code") }}
  </form>
{%- endmacro %}
