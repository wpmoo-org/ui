{% from "layouts/page.html.jinja" import page %}
{% from "components/breadcrumb.html.jinja" import breadcrumb %}
{% from "components/card.html.jinja" import card %}

{% set fixture_width = fixture_width | default("xl") %}
{% set fixture_direction = fixture_direction | default("ltr") %}

<!doctype html>
<html lang="en" dir="{{ fixture_direction }}" data-bs-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Layout certification — Page</title>
    <link rel="stylesheet" href="/dist/assets/css/moo-ui.css">
    <style>
      body { margin: 0; }
      .layout-certification-main { min-height: 120rem; }
    </style>
  </head>
  <body>
    <a class="visually-hidden-focusable" href="#main-content">Skip to main content</a>
    {% call(region) page(width=fixture_width) %}
      {% if region == "header" %}
        {% call card(size="sm") %}
          {{ breadcrumb([
            {"label": "Workspace", "href": "#workspace"},
            {"label": "Overview"}
          ], extra_class="layout-certification-breadcrumb") }}
        {% endcall %}
      {% elif region == "main" %}
        <div class="layout-certification-main"><h1 class="h4">Standalone page</h1></div>
      {% elif region == "footer" %}
        {% call card(size="sm") %}Page footer{% endcall %}
      {% endif %}
    {% endcall %}
  </body>
</html>
